# Python
__pycache__/
*.py[cod]
*.so

# Packaging
build/
dist/
*.egg-info/

# Environments (uv writes .venv; the environment itself is pinned by uv.lock)
.venv/
venv/
.env

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Coverage
.coverage
.coverage.*
htmlcov/

# LaTeX build output.  The paper lives in the submodules, which carry their
# own ignore rules; these are here because a stray build at the repo root
# otherwise leaves a dozen untracked files behind.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# Editors and OS.  .vscode/ is deliberately tracked: it carries the debug
# configuration for the experiments.
.idea/
*.swp
*~
.DS_Store
Thumbs.db
