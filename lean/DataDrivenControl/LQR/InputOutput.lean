module

public import DataDrivenControl.LQR.ModelBased
public import DataDrivenControl.FundamentalLemma.InputOutput

/-!
# The input–output regulator

Paper: `eq:lqr-data-io-problem`, `thm:lqr-data-io` (`app:lqr-data-io`).

## Main declarations

* `ioRegulatorCost wts T₀ T p`: the objective of `eq:lqr-data-io-problem`,
  `∫₀ᵀ (‖y(T₀ + t)‖² + ⟨u(T₀ + t), R u(T₀ + t)⟩) dt` for `p = (u, y)` of length `T₀ + T`.
* `ioRegulatorFeasible T₀ T T' ū ȳ u_ini y_ini`: its feasible set,
  `(u, y) ∈ closure (im 𝒴_{T₀+T,T'}^{ū,ȳ})` and `(u, y)|_(0,T₀) = (u_ini, y_ini)`.
* `System.restrictL_𝓞`, `System.restrictL_𝓕`, `System.𝓞_add_𝓕_ae_eq_outputW`: restriction of
  `𝓜_ρ` to the conditioning window (`app:lqr-data-io`, Step 2) and `𝓞_τ w + 𝓕_τ v = C x(·; w, v)`
  for `w ∈ W`.
* `System.lqr_data_io`: `thm:lqr-data-io`.  The problem has a unique minimiser `(u⋆, y⋆)`, its
  regulated input `u⋆(T₀ + ·) = tailL T₀ T u⋆` minimises the model-based cost `J(·; x₀)` of
  `eq:lqr-cost` for `x₀ = x(T₀; x_ini, u_ini)`, and the optimal values agree.

The record on `[0, T₀ + T + T']` generated by `(x₀, ū)` has state `sys.mild x₀ ū` and output
`sys.output (T₀ + T + T') x₀ ū`; the conditioning window `(u_ini, y_ini) ∈ L²(0, T₀; U × Y)` is
generated by `(x_ini, u_ini) ∈ W × L²(0, T₀; U)`, i.e. `y_ini = sys.outputW x_ini u_ini` a.e.

Deviation (strengthening): `hyp:compat` is not assumed.  The paper's proof uses it only for the
closing remark that the common optimal value is `⟨x₀, P(0) x₀⟩` (Theorem `thm:lqr-riccati`),
which is not part of the statement.

## Upstream results used

`System.closure_range_ioWindowSynth`, `System.isClosed_ioBehavior`
(`FundamentalLemma/InputOutput`); `System.ExactlyObservable.mono`, `System.approxObservable_iff`
(`System/Controllability`); `System.𝓞_restrict`, `System.𝓕_causal`, `System.mildW_add_time`,
`System.mildW_congr_ae` (`System/Mild`); `restrictL`, `tailL`, `concat`, `concat_restrictL_tailL`
(`Signal/Shift`); `System.existsUnique_isMinOn_lqrCost` (`LQR/ModelBased`);
`existsUnique_isMinOn_iff_of_bijOn`, `isMinOn_iff_of_bijOn` (`Analysis/Quadratic`).
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped InnerProductSpace

noncomputable section

set_option linter.unusedSectionVars false

namespace DataDrivenControl

variable {U W X V Y : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]

/-- The objective of the **input–output regulator** (`eq:lqr-data-io-problem`): for an
input–output pair `p = (u, y)` of length `T₀ + T`,
`∫₀ᵀ (‖y(T₀ + t)‖² + ⟨u(T₀ + t), R u(T₀ + t)⟩) dt`. -/
def ioRegulatorCost (wts : LQRWeights U V) (T₀ T : ℝ)
    (p : WithLp 2 (L2 U (T₀ + T) × L2 Y (T₀ + T))) : ℝ :=
  ∫ t in Ioc 0 T, (‖p.snd (T₀ + t)‖ ^ 2 + ⟪p.fst (T₀ + t), wts.R (p.fst (T₀ + t))⟫_ℝ)

/-- The feasible set of the **input–output regulator** (`eq:lqr-data-io-problem`) for the record
`(ū, ȳ)` and the conditioning window `(u_ini, y_ini) ∈ L²(0, T₀; U × Y)`: the pairs
`(u, y) ∈ closure (im 𝒴_{T₀+T,T'}^{ū,ȳ})` with `(u, y)|_(0,T₀) = (u_ini, y_ini)`. -/
def ioRegulatorFeasible (T₀ T T' : ℝ) (u : ℝ → U) (y : ℝ → Y) (uini : L2 U T₀)
    (yini : L2 Y T₀) : Set (WithLp 2 (L2 U (T₀ + T) × L2 Y (T₀ + T))) :=
  {p | p ∈ closure (Set.range (ioWindowSynth (T₀ + T) T' u y)) ∧
    restrictL (T₀ + T) T₀ p.fst = uini ∧ restrictL (T₀ + T) T₀ p.snd = yini}

namespace System

variable {sys : System U W X V Y}

/-! ### The conditioning window and the regulated window -/

/-- Restriction of the free response: `(𝓞_ρ ξ)|_(0, T₀) = 𝓞_{T₀} ξ`. -/
theorem restrictL_𝓞 {T : ℝ} (hH2 : sys.H2 T) (hT : 0 < T) {T₀ ρ : ℝ} (h : T₀ ≤ ρ) (ξ : X) :
    restrictL ρ T₀ (sys.𝓞 ρ ξ) = sys.𝓞 T₀ ξ := by
  refine Lp.ext ?_
  filter_upwards [coeFn_restrictL h (sys.𝓞 ρ ξ), 𝓞_restrict hH2 hT h ξ] with t h1 h2
  rw [h1, h2]

/-- Causality of the input–output map: `(𝓕_ρ v)|_(0, T₀) = 𝓕_{T₀} (v|_(0, T₀))`. -/
theorem restrictL_𝓕 {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {T₀ ρ : ℝ} (h : T₀ ≤ ρ)
    (v : L2 U ρ) : restrictL ρ T₀ (sys.𝓕 ρ v) = sys.𝓕 T₀ (restrictL ρ T₀ v) := by
  refine Lp.ext ?_
  filter_upwards [coeFn_restrictL h (sys.𝓕 ρ v),
    𝓕_causal hH1 hT h v (restrictL ρ T₀ v) (coeFn_restrictL h v).symm] with t h1 h2
  rw [h1, h2]

/-- For an initial state `w ∈ W`, `𝓞_τ w + 𝓕_τ v` is the pointwise output `C x(·; w, v)`. -/
theorem 𝓞_add_𝓕_ae_eq_outputW {T : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T) (hT : 0 < T) {τ : ℝ}
    (w : W) (v : L2 U τ) :
    ⇑(sys.𝓞 τ (sys.ιW w) + sys.𝓕 τ v) =ᵐ[μI τ] sys.outputW w v := by
  filter_upwards [Lp.coeFn_add (sys.𝓞 τ (sys.ιW w)) (sys.𝓕 τ v), 𝓞_ae_eq hH2 hT w,
    𝓕_ae_eq hH1 hT v] with t h1 h2 h3
  rw [h1, Pi.add_apply, h2, h3, outputW, mildW, map_add]

/-- **Data-driven LQR, input–output** (`thm:lqr-data-io`).  Suppose Assumptions `hyp:H1` and
`hyp:H2` hold, `G = 0`, and `(A, C)` is exactly observable in time `T₀`.  Let `(ū, x̄, ȳ)` be the
record on `[0, T₀ + T + T']` generated by `(x₀, ū) ∈ X × L²(0, T₀ + T + T'; U)`, and suppose
that `(ū, x̄)` is window informative at horizon `T₀ + T`.  Let `(u_ini, y_ini)` be the
input–output window generated by `(x_ini, u_ini) ∈ W × L²(0, T₀; U)`, and
`x₀ := x(T₀; x_ini, u_ini) ∈ W`.  Then the input–output problem `eq:lqr-data-io-problem` has a
unique minimiser `(u⋆, y⋆)`; for every minimiser, the regulated input `u⋆(T₀ + ·)` is the
(unique, `existsUnique_isMinOn_lqrCost`) minimiser of the model-based problem `eq:lqr-cost` for
the initial state `x₀`, and the two optimal values agree.

Deviation (strengthening): `hyp:compat` is not assumed (unused in the proof of the stated
conclusion). -/
theorem lqr_data_io {T₀ T T' : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T) (hT₀ : 0 < T₀)
    (hT : 0 < T) (wts : LQRWeights U V) (hG : wts.G = 0) (hobs : sys.ExactlyObservable T₀)
    {x₀ : X} {ū : ℝ → U} (hū : MemLp ū 2 (μI (T₀ + T + T')))
    (hw : WindowInformative (T₀ + T) T' ū (sys.mild x₀ ū))
    {xini : W} {uini : L2 U T₀} {yini : L2 Y T₀}
    (hyini : ⇑yini =ᵐ[μI T₀] sys.outputW xini uini) :
    (∃! p, p ∈ ioRegulatorFeasible T₀ T T' ū (sys.output (T₀ + T + T') x₀ ū) uini yini ∧
        IsMinOn (ioRegulatorCost wts T₀ T)
          (ioRegulatorFeasible T₀ T T' ū (sys.output (T₀ + T + T') x₀ ū) uini yini) p) ∧
      ∀ p, p ∈ ioRegulatorFeasible T₀ T T' ū (sys.output (T₀ + T + T') x₀ ū) uini yini →
        IsMinOn (ioRegulatorCost wts T₀ T)
          (ioRegulatorFeasible T₀ T T' ū (sys.output (T₀ + T + T') x₀ ū) uini yini) p →
        IsMinOn (fun v : L2 U T => sys.lqrCost wts T (sys.mildW xini uini T₀) v) univ
            (tailL T₀ T p.fst) ∧
          ioRegulatorCost wts T₀ T p =
            sys.lqrCost wts T (sys.mildW xini uini T₀) (tailL T₀ T p.fst) := by
  set ρ := T₀ + T with hρ
  have hρpos : 0 < ρ := by linarith
  have hT₀ρ : T₀ ≤ ρ := by linarith
  have hH1ρ : sys.H1 ρ := System.H1.of_pos sys hH1 hT ρ
  have hH2ρ : sys.H2 ρ := System.H2.of_pos sys hH2 hT ρ
  have hobsρ : sys.ExactlyObservable ρ := hobs.mono hH2 hT hT₀ρ
  set x0 : W := sys.mildW xini uini T₀ with hx0def
  set F := ioRegulatorFeasible T₀ T T' ū (sys.output (T₀ + T + T') x₀ ū) uini yini with hFdef
  -- the conditioning window is `𝓜_{T₀}(u_ini, x_ini)`
  have hyini' : yini = sys.𝓞 T₀ (sys.ιW xini) + sys.𝓕 T₀ uini := by
    refine Lp.ext ?_
    filter_upwards [hyini, 𝓞_add_𝓕_ae_eq_outputW hH1 hH2 hT xini uini] with t h1 h2
    rw [h1, h2]
  -- Steps 1 and 2 of `app:lqr-data-io`: the feasible set
  have hcl : closure (Set.range (ioWindowSynth ρ T' ū (sys.output (T₀ + T + T') x₀ ū))) =
      sys.ioBehavior ρ := by
    rw [closure_range_ioWindowSynth hH1ρ hH2ρ hρpos hū hw, (isClosed_ioBehavior hobsρ).closure_eq]
  have hF : ∀ p, p ∈ F ↔
      restrictL ρ T₀ p.fst = uini ∧ p.snd = sys.𝓞 ρ (sys.ιW xini) + sys.𝓕 ρ p.fst := by
    intro p
    have hmem : p ∈ F ↔ (∃ ξ : X, p.snd = sys.𝓞 ρ ξ + sys.𝓕 ρ p.fst) ∧
        restrictL ρ T₀ p.fst = uini ∧ restrictL ρ T₀ p.snd = yini := by
      change p ∈ closure _ ∧ _ ↔ _
      rw [hcl]
      rfl
    rw [hmem]
    constructor
    · rintro ⟨⟨ξ, hξ⟩, h1, h2⟩
      refine ⟨h1, ?_⟩
      have hO : sys.𝓞 T₀ ξ = sys.𝓞 T₀ (sys.ιW xini) := by
        have h := congrArg (restrictL ρ T₀) hξ
        rw [h2, map_add, restrictL_𝓞 hH2 hT hT₀ρ, restrictL_𝓕 hH1 hT hT₀ρ, h1, hyini'] at h
        exact (add_right_cancel h).symm
      have hξ' : ξ = sys.ιW xini := by
        rw [← sub_eq_zero]
        refine (approxObservable_iff.1 hobs.approxObservable) _ ?_
        rw [map_sub, hO, sub_self]
      rw [hξ, hξ']
    · rintro ⟨h1, h2⟩
      refine ⟨⟨sys.ιW xini, h2⟩, h1, ?_⟩
      rw [h2, map_add, restrictL_𝓞 hH2 hT hT₀ρ, restrictL_𝓕 hH1 hT hT₀ρ, h1, hyini']
  -- Step 3: the cost of a feasible pair is the model-based cost of its regulated input
  have hcost : ∀ p ∈ F,
      ioRegulatorCost wts T₀ T p = sys.lqrCost wts T x0 (tailL T₀ T p.fst) := by
    intro p hp
    obtain ⟨h1, h2⟩ := (hF p).1 hp
    have hy : ⇑p.snd =ᵐ[μI ρ] sys.outputW xini p.fst := by
      rw [h2]; exact 𝓞_add_𝓕_ae_eq_outputW hH1 hH2 hT xini p.fst
    have hu0 : ⇑p.fst =ᵐ[μI T₀] ⇑uini := by
      rw [← h1]; exact (coeFn_restrictL hT₀ρ p.fst).symm
    have hx0 : sys.mildW xini p.fst T₀ = x0 := mildW_congr_ae hu0 xini
    have htail := coeFn_tailL hT₀.le (T := T) p.fst
    have hys : ∀ᵐ t ∂(μI T), p.snd (T₀ + t) = sys.outputW xini p.fst (T₀ + t) :=
      ae_comp_add (p := fun t => p.snd t = sys.outputW xini p.fst t) hy hT₀.le le_rfl
    unfold ioRegulatorCost lqrCost
    rw [hG]
    simp only [zero_apply, zero_add]
    refine integral_congr_ae ?_
    filter_upwards [hys, htail, ae_restrict_mem measurableSet_Ioc] with t h1 h2 h3
    have hm : sys.mildW x0 (fun r => p.fst (T₀ + r)) t = sys.mildW x0 (tailL T₀ T p.fst) t :=
      mildW_congr_ae (EventuallyEq.symm
        (ae_mono (Measure.restrict_mono (Ioc_subset_Ioc_right h3.2) le_rfl) htail)) x0
    rw [h1, h2, outputW, mildW_add_time hH1 hT hT₀.le h3.1.le
      (memLp_μI_of_le (Lp.memLp p.fst) (by linarith [h3.2])) xini, hx0, hm]
  -- Step 2 (end): the regulated input parametrises the feasible set bijectively
  have hbij : BijOn (fun p : WithLp 2 (L2 U ρ × L2 Y ρ) => tailL T₀ T p.fst) F univ := by
    refine ⟨fun _ _ => mem_univ _, ?_, ?_⟩
    · intro p hp q hq hpq
      obtain ⟨hp1, hp2⟩ := (hF p).1 hp
      obtain ⟨hq1, hq2⟩ := (hF q).1 hq
      have hfst : p.fst = q.fst := by
        rw [← concat_restrictL_tailL hT₀.le hT.le p.fst,
          ← concat_restrictL_tailL hT₀.le hT.le q.fst, hp1, hq1]
        exact congrArg (concat T₀ T uini) hpq
      have hsnd : p.snd = q.snd := by rw [hp2, hq2, hfst]
      exact WithLp.ofLp_injective 2 (Prod.ext hfst hsnd)
    · intro v _
      refine ⟨WithLp.toLp 2 (concat T₀ T uini v,
        sys.𝓞 ρ (sys.ιW xini) + sys.𝓕 ρ (concat T₀ T uini v)),
        (hF _).2 ⟨restrictL_concat hT.le uini v, rfl⟩, tailL_concat hT₀.le uini v⟩
  -- Step 4: transport the unique model-based minimiser
  have hJ : ∀ p ∈ F, ioRegulatorCost wts T₀ T p =
      (fun v : L2 U T => sys.lqrCost wts T x0 v) (tailL T₀ T p.fst) := hcost
  refine ⟨?_, fun p hp hmin => ⟨(isMinOn_iff_of_bijOn (J₁ := ioRegulatorCost wts T₀ T)
    (J₂ := fun v : L2 U T => sys.lqrCost wts T x0 v) hbij hJ hp).1 hmin, hcost p hp⟩⟩
  rw [existsUnique_isMinOn_iff_of_bijOn (J₁ := ioRegulatorCost wts T₀ T)
    (J₂ := fun v : L2 U T => sys.lqrCost wts T x0 v) hbij hJ]
  obtain ⟨u, hu, huniq⟩ := existsUnique_isMinOn_lqrCost hH1 hT wts x0
  exact ⟨u, ⟨mem_univ _, hu⟩, fun v hv => huniq v hv.2⟩

end System

end DataDrivenControl
