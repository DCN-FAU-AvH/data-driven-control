module

public import DataDrivenControl.Informativity.Informative
public import DataDrivenControl.Semigroup.Extrapolation
public import DataDrivenControl.System.Mild
public import DataDrivenControl.Signal.WeakDerivative

/-!
# Graph and synthesis operators

Paper: `eq:graph-operator`, the synthesis operator `𝒲` (`subsec:input-state-output`),
`eq:synthesis-factorization` (`app:willems-gramian`, Step 2).

## Main declarations

* `System.GraphSpace`: `U × W × V₋₁ × Y`, with `V₋₁ = sys.SV.Extrap` (the dual model of
  `Semigroup/Extrapolation`), a type synonym of the nested product
  `WithLp 2 (U × WithLp 2 (W × WithLp 2 (V₋₁ × Y)))` with its own instances;
  points `GraphSpace.mk a b c d`, inner product `GraphSpace.inner_mk`.
* `prodL2 f g : E →L[ℝ] WithLp 2 (F × G)`, the pairing of two operators.
* `System.vecField v ξ = A ξ + B v ∈ V₋₁` for `(v, ξ) ∈ U × W`
  (`A ξ = sys.SV.genExtrap (sys.ιWV ξ)`, `B v = sys.SV.toExtrap (sys.B v)`).
* `System.graphOp`: the **graph operator** `Γ (v, ξ) = (v, ξ, A ξ + B v, C ξ)`
  (`eq:graph-operator`), `graphOp_apply`, `isBoundedBelow_graphOp`
  (`‖Γ (v, ξ)‖ ≥ ‖(v, ξ)‖`), `isClosed_range_graphOp`.
* `System.synth T u x y φ`: the **synthesis operator**
  `𝒲_{(u,x,y)} φ = (∫ φ u, ∫ φ x, -∫ φ̇ x, ∫ φ y)` (third component in `W ↪ V₋₁`).
  **Deviation**: `𝒲` is evaluated on test functions `φ ∈ C_c^∞(0, T)`
  (`IsTestFunction T φ`) instead of `H₀¹(I)`; its image is `synth T u x y '' {φ | IsTestFunction T φ}`.
  The closures of the two images agree and condition (iii) of `thm:willems-gramian` is the same.
  `synth` is a plain function of `φ` (its linearity needs integrability, a hypothesis).
* `System.synth_eq_of_hasWeakDeriv`: for `x ∈ H¹(I; V₋₁)`, `-∫ φ̇ x = ∫ φ ẋ` in `V₋₁`.
* `System.synth_eq_graphOp`: `eq:synthesis-factorization`,
  `𝒲_{(ū,x̄,ȳ)} φ = Γ (∫ φ ū, ∫ φ x̄)` for the record generated by `(x̄₀, ū) ∈ W × L²(I; U)`.
* `System.graphGramian T u x xd y`: the Gramian `𝒢(u, x, ẋ, y)` on `U × W × V₋₁ × Y`
  (`eq:hilbert-gramian` applied to the quadruple; the derivative `xd` is an explicit argument).

Helpers: `GraphSpace.mk_inj`, the inclusions `GraphSpace.inU/inW/inE/inY` with
`GraphSpace.mk_eq_sum`, `GraphSpace.smul_mk`, `GraphSpace.integral_mk` (Bochner integrals are
componentwise); `System.ιWV_mildW_eq_mildSol` (the record, embedded in `V`, is the mild solution
of `S_V` with forcing `B ū`) and `System.hasWeakDeriv_toExtrap_mildW` (`eq:record-dynamics`,
re-exported in `FundamentalLemma/Willems` as `hasWeakDeriv_mildW`).

## Proof notes

* `eq:record-dynamics` (Step 1): the record is the mild solution on `V` (`ιWV_L`, `ιWV_SW`), hence
  a weak solution by Ball's theorem (`C0Semigroup.isWeakSol_iff`), and Ball's weak formulation is
  the integral form of `ẋ = A₋₁ x + B ū` in `V₋₁` (`C0Semigroup.isWeakSol_iff_extrap`).  This gives
  the `H¹(I; V₋₁)` integral form directly; the paper's distributional detour (pairing with
  `D(A₋₁*)` and the inclusion `W ⊂ V = D(A₋₁)`) is not needed.
* `eq:synthesis-factorization`: `HasWeakDeriv.integral_deriv_smul` (integration by parts against
  test functions) and `ContinuousLinearMap.integral_comp_comm` for `A₋₁ ∘ ιWV`, `B` and `C`.
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped InnerProductSpace

noncomputable section

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace DataDrivenControl

/-- The pairing `E → WithLp 2 (F × G)` of two bounded operators `f, g` out of `E`. -/
def prodL2 {E F G : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    [SeminormedAddCommGroup F] [NormedSpace ℝ F] [SeminormedAddCommGroup G] [NormedSpace ℝ G]
    (f : E →L[ℝ] F) (g : E →L[ℝ] G) : E →L[ℝ] WithLp 2 (F × G) :=
  ((WithLp.prodContinuousLinearEquiv 2 ℝ F G).symm : (F × G) →L[ℝ] WithLp 2 (F × G)) ∘L f.prod g

/-- `prodL2 f g e = (f e, g e)`. -/
@[simp] theorem prodL2_apply {E F G : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    [SeminormedAddCommGroup F] [NormedSpace ℝ F] [SeminormedAddCommGroup G] [NormedSpace ℝ G]
    (f : E →L[ℝ] F) (g : E →L[ℝ] G) (e : E) : prodL2 f g e = WithLp.toLp 2 (f e, g e) :=
  rfl

namespace System

variable {U W X V Y : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]

variable (sys : System U W X V Y)

/-- The space `U × W × V₋₁ × Y` of `eq:graph-operator`, with `V₋₁ = sys.SV.Extrap`: the nested
`L²` product `WithLp 2 (U × WithLp 2 (W × WithLp 2 (V₋₁ × Y)))`.  It is a type
synonym with its own `NormedAddCommGroup`, `InnerProductSpace ℝ` and `CompleteSpace` instances
(those of the nested product): instance search through the nested `WithLp` with `V₋₁` inside is
otherwise too slow.  Build points with `GraphSpace.mk`. -/
def GraphSpace : Type _ := WithLp 2 (U × WithLp 2 (W × WithLp 2 (sys.SV.Extrap × Y)))

instance : NormedAddCommGroup sys.GraphSpace :=
  inferInstanceAs (NormedAddCommGroup (WithLp 2 (U × WithLp 2 (W × WithLp 2 (sys.SV.Extrap × Y)))))

instance : InnerProductSpace ℝ sys.GraphSpace :=
  inferInstanceAs
    (InnerProductSpace ℝ (WithLp 2 (U × WithLp 2 (W × WithLp 2 (sys.SV.Extrap × Y)))))

instance : CompleteSpace sys.GraphSpace :=
  inferInstanceAs (CompleteSpace (WithLp 2 (U × WithLp 2 (W × WithLp 2 (sys.SV.Extrap × Y)))))

variable {sys} in
/-- The point `(a, b, c, d)` of `U × W × V₋₁ × Y`. -/
def GraphSpace.mk (a : U) (b : W) (c : sys.SV.Extrap) (d : Y) : sys.GraphSpace :=
  WithLp.toLp 2 (a, WithLp.toLp 2 (b, WithLp.toLp 2 (c, d)))

/-- The vector field `A ξ + B v ∈ V₋₁` for `(v, ξ) ∈ U × W`: `A = A₋₁ ∈ L(V, V₋₁)` restricted to
`W` (`sys.SV.genExtrap ∘ ιWV`) and `B ∈ L(U, V) ⊂ L(U, V₋₁)` (`sys.SV.toExtrap ∘ B`). -/
def vecField (v : U) (ξ : W) : sys.SV.Extrap :=
  sys.SV.genExtrap (sys.ιWV ξ) + sys.SV.toExtrap (sys.B v)

/-- The **graph operator** (`eq:graph-operator`)
`Γ : U × W → U × W × V₋₁ × Y`, `Γ (v, ξ) = (v, ξ, A ξ + B v, C ξ)`. -/
def graphOp : WithLp 2 (U × W) →L[ℝ] sys.GraphSpace :=
  prodL2 (WithLp.fstL 2 ℝ U W)
    (prodL2 (WithLp.sndL 2 ℝ U W)
      (prodL2 (sys.SV.genExtrap ∘L sys.ιWV ∘L WithLp.sndL 2 ℝ U W +
          sys.SV.toExtrap ∘L sys.B ∘L WithLp.fstL 2 ℝ U W)
        (sys.C ∘L WithLp.sndL 2 ℝ U W)))

/-- The synthesis operator `𝒲_{(u,x,y)}` (Section `subsec:input-state-output`) at `φ`:
`𝒲_{(u,x,y)} φ = (∫₀ᵀ φ u, ∫₀ᵀ φ x, -∫₀ᵀ φ̇ x, ∫₀ᵀ φ y) ∈ U × W × V₋₁ × Y`, the third component
computed in `W` and embedded in `V₋₁`.  **Deviation**: it is applied to test
functions `φ ∈ C_c^∞(0, T)` (`IsTestFunction T φ`), not to `φ ∈ H₀¹(I)`. -/
def synth (T : ℝ) (u : ℝ → U) (x : ℝ → W) (y : ℝ → Y) (φ : ℝ → ℝ) : sys.GraphSpace :=
  GraphSpace.mk (∫ t in Ioc 0 T, φ t • u t) (∫ t in Ioc 0 T, φ t • x t)
    (sys.SV.toExtrap (sys.ιWV (-∫ t in Ioc 0 T, deriv φ t • x t))) (∫ t in Ioc 0 T, φ t • y t)

/-- The Gramian `𝒢(u, x, ẋ, y)` (`eq:hilbert-gramian`) of the quadruple
`t ↦ (u t, x t, ẋ t, y t)` on `U × W × V₋₁ × Y`, with the derivative `ẋ = xd` an explicit
`V₋₁`-valued signal. -/
def graphGramian (T : ℝ) (u : ℝ → U) (x : ℝ → W) (xd : ℝ → sys.SV.Extrap) (y : ℝ → Y) :
    sys.GraphSpace →L[ℝ] sys.GraphSpace :=
  gramian ℝ (μI T) (fun t => GraphSpace.mk (u t) (x t) (xd t) (y t))

/-- The nested product underlying `sys.GraphSpace`, used to unfold `GraphSpace.mk`. -/
local notation "𝔾" => WithLp 2 (U × WithLp 2 (W × WithLp 2 (sys.SV.Extrap × Y)))

/-- The inclusion `U → U × W × V₋₁ × Y`, `a ↦ (a, 0, 0, 0)`. -/
def GraphSpace.inU : U →L[ℝ] sys.GraphSpace := prodL2 (ContinuousLinearMap.id ℝ U) 0

/-- The inclusion `W → U × W × V₋₁ × Y`, `b ↦ (0, b, 0, 0)`. -/
def GraphSpace.inW : W →L[ℝ] sys.GraphSpace := prodL2 0 (prodL2 (ContinuousLinearMap.id ℝ W) 0)

/-- The inclusion `V₋₁ → U × W × V₋₁ × Y`, `c ↦ (0, 0, c, 0)`. -/
def GraphSpace.inE : sys.SV.Extrap →L[ℝ] sys.GraphSpace :=
  prodL2 0 (prodL2 0 (prodL2 (ContinuousLinearMap.id ℝ sys.SV.Extrap) 0))

/-- The inclusion `Y → U × W × V₋₁ × Y`, `d ↦ (0, 0, 0, d)`. -/
def GraphSpace.inY : Y →L[ℝ] sys.GraphSpace :=
  prodL2 0 (prodL2 0 (prodL2 0 (ContinuousLinearMap.id ℝ Y)))

variable {sys}

/-- `(a, b, c, d) = (a, b', c', d')` iff the components agree. -/
theorem GraphSpace.mk_inj {a a' : U} {b b' : W} {c c' : sys.SV.Extrap} {d d' : Y} :
    GraphSpace.mk a b c d = GraphSpace.mk a' b' c' d' ↔ a = a' ∧ b = b' ∧ c = c' ∧ d = d' := by
  change (WithLp.toLp 2 (a, WithLp.toLp 2 (b, WithLp.toLp 2 (c, d))) : 𝔾) =
    (WithLp.toLp 2 (a', WithLp.toLp 2 (b', WithLp.toLp 2 (c', d'))) : 𝔾) ↔ _
  simp

/-- `(a, b, c, d)` is the sum of the four inclusions. -/
theorem GraphSpace.mk_eq_sum (a : U) (b : W) (c : sys.SV.Extrap) (d : Y) :
    GraphSpace.mk a b c d = GraphSpace.inU sys a + GraphSpace.inW sys b + GraphSpace.inE sys c +
      GraphSpace.inY sys d := by
  change (WithLp.toLp 2 (a, WithLp.toLp 2 (b, WithLp.toLp 2 (c, d))) : 𝔾) =
    (WithLp.toLp 2 (a, 0) : 𝔾) + (WithLp.toLp 2 (0, WithLp.toLp 2 (b, 0)) : 𝔾) +
      (WithLp.toLp 2 (0, WithLp.toLp 2 (0, WithLp.toLp 2 (c, 0))) : 𝔾) +
      (WithLp.toLp 2 (0, WithLp.toLp 2 (0, WithLp.toLp 2 (0, d))) : 𝔾)
  simp only [← WithLp.toLp_add, Prod.mk_add_mk, add_zero, zero_add]

/-- Scalars act componentwise on `U × W × V₋₁ × Y`. -/
theorem GraphSpace.smul_mk (r : ℝ) (a : U) (b : W) (c : sys.SV.Extrap) (d : Y) :
    r • GraphSpace.mk a b c d = GraphSpace.mk (r • a) (r • b) (r • c) (r • d) := by
  change r • (WithLp.toLp 2 (a, WithLp.toLp 2 (b, WithLp.toLp 2 (c, d))) : 𝔾) =
    (WithLp.toLp 2 (r • a, WithLp.toLp 2 (r • b, WithLp.toLp 2 (r • c, r • d))) : 𝔾)
  simp only [← WithLp.toLp_smul, Prod.smul_mk]

/-- Bochner integrals in `U × W × V₋₁ × Y` are computed componentwise. -/
theorem GraphSpace.integral_mk {μ : Measure ℝ} {f₁ : ℝ → U} {f₂ : ℝ → W}
    {f₃ : ℝ → sys.SV.Extrap} {f₄ : ℝ → Y} (h₁ : Integrable f₁ μ) (h₂ : Integrable f₂ μ)
    (h₃ : Integrable f₃ μ) (h₄ : Integrable f₄ μ) :
    ∫ t, GraphSpace.mk (f₁ t) (f₂ t) (f₃ t) (f₄ t) ∂μ =
      GraphSpace.mk (∫ t, f₁ t ∂μ) (∫ t, f₂ t ∂μ) (∫ t, f₃ t ∂μ) (∫ t, f₄ t ∂μ) := by
  have i₁ := (GraphSpace.inU sys).integrable_comp h₁
  have i₂ := (GraphSpace.inW sys).integrable_comp h₂
  have i₃ := (GraphSpace.inE sys).integrable_comp h₃
  have i₄ := (GraphSpace.inY sys).integrable_comp h₄
  simp only [GraphSpace.mk_eq_sum]
  rw [integral_add (f := fun t => GraphSpace.inU sys (f₁ t) + GraphSpace.inW sys (f₂ t) +
      GraphSpace.inE sys (f₃ t)) ((i₁.add i₂).add i₃) i₄,
    integral_add (f := fun t => GraphSpace.inU sys (f₁ t) + GraphSpace.inW sys (f₂ t))
      (i₁.add i₂) i₃,
    integral_add i₁ i₂,
    (GraphSpace.inU sys).integral_comp_comm h₁, (GraphSpace.inW sys).integral_comp_comm h₂,
    (GraphSpace.inE sys).integral_comp_comm h₃, (GraphSpace.inY sys).integral_comp_comm h₄]

/-- `Γ (v, ξ) = (v, ξ, A ξ + B v, C ξ)`. -/
theorem graphOp_apply (v : U) (ξ : W) :
    sys.graphOp (WithLp.toLp 2 (v, ξ)) = GraphSpace.mk v ξ (sys.vecField v ξ) (sys.C ξ) :=
  rfl

/-- The inner product of `U × W × V₋₁ × Y` splits into the four components. -/
theorem GraphSpace.inner_mk (a a' : U) (b b' : W) (c c' : sys.SV.Extrap) (d d' : Y) :
    ⟪GraphSpace.mk a b c d, GraphSpace.mk a' b' c' d'⟫_ℝ =
      ⟪a, a'⟫_ℝ + ⟪b, b'⟫_ℝ + ⟪c, c'⟫_ℝ + ⟪d, d'⟫_ℝ := by
  change ⟪(WithLp.toLp 2 (a, WithLp.toLp 2 (b, WithLp.toLp 2 (c, d))) : 𝔾),
    (WithLp.toLp 2 (a', WithLp.toLp 2 (b', WithLp.toLp 2 (c', d'))) : 𝔾)⟫_ℝ = _
  simp only [WithLp.prod_inner_apply]
  ring

/-- `‖Γ (v, ξ)‖ ≥ ‖(v, ξ)‖`, so `Γ` is bounded below (`eq:graph-operator`). -/
theorem isBoundedBelow_graphOp : IsBoundedBelow sys.graphOp := by
  refine IsBoundedBelow.of_norm_le fun p => ?_
  obtain ⟨⟨v, ξ⟩⟩ := p
  rw [graphOp_apply]
  have h1 : ‖WithLp.toLp 2 (v, ξ)‖ ^ 2 = ‖v‖ ^ 2 + ‖ξ‖ ^ 2 :=
    WithLp.prod_norm_sq_eq_of_L2 (WithLp.toLp 2 (v, ξ))
  have h2 : ‖GraphSpace.mk v ξ (sys.vecField v ξ) (sys.C ξ)‖ ^ 2 =
      ‖v‖ ^ 2 + ‖ξ‖ ^ 2 + ‖sys.vecField v ξ‖ ^ 2 + ‖sys.C ξ‖ ^ 2 := by
    rw [← real_inner_self_eq_norm_sq, GraphSpace.inner_mk]
    simp only [real_inner_self_eq_norm_sq]
  refine (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 ?_
  rw [h1, h2]
  nlinarith [sq_nonneg ‖sys.vecField v ξ‖, sq_nonneg ‖sys.C ξ‖]

/-- `Γ` has closed range (`eq:graph-operator`: a homeomorphism onto its closed range). -/
theorem isClosed_range_graphOp : IsClosed (Set.range sys.graphOp) :=
  IsBoundedBelow.isClosed_range isBoundedBelow_graphOp

/-- For `x ∈ C(I; W) ∩ H¹(I; V₋₁)` with weak derivative `ẋ = xd`, integration by parts gives
`-∫₀ᵀ φ̇ x = ∫₀ᵀ φ ẋ` in `V₋₁` (Section `subsec:input-state-output`), so
`𝒲_{(u,x,y)} φ = (∫ φ u, ∫ φ x, ∫ φ ẋ, ∫ φ y)`. -/
theorem synth_eq_of_hasWeakDeriv {T : ℝ} {u : ℝ → U} {x : ℝ → W} {y : ℝ → Y}
    {xd : ℝ → sys.SV.Extrap} (hxc : ContinuousOn x (Icc 0 T))
    (hxd : HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (x t))) xd) {φ : ℝ → ℝ}
    (hφ : IsTestFunction T φ) :
    sys.synth T u x y φ =
      GraphSpace.mk (∫ t in Ioc 0 T, φ t • u t) (∫ t in Ioc 0 T, φ t • x t)
        (∫ t in Ioc 0 T, φ t • xd t) (∫ t in Ioc 0 T, φ t • y t) := by
  have hφ' := hφ.deriv
  have hxi : Integrable x (μI T) := (memLp_μI_of_continuousOn hxc).integrable one_le_two
  have hint : Integrable (fun t => deriv φ t • x t) (μI T) := (hφ'.integrable_smul hxi).restrict
  have e1 : ∫ t in Ioc 0 T, deriv φ t • sys.SV.toExtrap (sys.ιWV (x t)) =
      sys.SV.toExtrap (sys.ιWV (∫ t in Ioc 0 T, deriv φ t • x t)) := by
    simpa only [ContinuousLinearMap.comp_apply, map_smul] using
      (sys.SV.toExtrap ∘L sys.ιWV).integral_comp_comm hint
  have key : sys.SV.toExtrap (sys.ιWV (-∫ t in Ioc 0 T, deriv φ t • x t)) =
      ∫ t in Ioc 0 T, φ t • xd t := by
    rw [map_neg, map_neg, ← e1, ← hφ'.integral_smul_eq_setIntegral,
      hxd.integral_deriv_smul hφ, neg_neg, hφ.integral_smul_eq_setIntegral]
  rw [synth, key]

/-- Under `hyp:H1`, the record state, embedded in `V`, is the mild solution on `V`:
`ιWV x̄(t) = S_V(t) ιWV x̄₀ + ∫₀ᵗ S_V(t - r) B ū(r) dr` (`app:willems-gramian`, Step 1). -/
theorem ιWV_mildW_eq_mildSol {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {w₀ : W} {u : ℝ → U}
    (hu : MemLp u 2 (μI T)) {t : ℝ} (ht : t ≤ T) :
    sys.ιWV (sys.mildW w₀ u t) = sys.SV.mildSol (sys.ιWV w₀) (fun r => sys.B (u r)) t := by
  rw [mildW, map_add, ιWV_SW, ιWV_L hH1 hT (memLp_μI_of_le hu ht), C0Semigroup.mildSol, convV]

/-- **Regularity of the record** (`eq:record-dynamics`, `app:willems-gramian` Step 1): under
`hyp:H1`, `x̄ = x(·; x̄₀, ū) ∈ H¹(I; V₋₁)` with `ẋ̄ = A x̄ + B ū`.  Ball's theorem on `V` makes
`ιWV x̄` a weak solution, which is the integral form in `V₋₁` (`isWeakSol_iff_extrap`). -/
theorem hasWeakDeriv_toExtrap_mildW {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {w₀ : W}
    {u : ℝ → U} (hu : MemLp u 2 (μI T)) :
    HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (sys.mildW w₀ u t)))
      (fun t => sys.vecField (u t) (sys.mildW w₀ u t)) := by
  have hBu : IntegrableOn (fun r => sys.B (u r)) (Ioc 0 T) :=
    sys.B.integrable_comp (hu.integrable one_le_two)
  have hweak : sys.SV.IsWeakSol T (sys.ιWV w₀) (fun r => sys.B (u r))
      (fun t => sys.ιWV (sys.mildW w₀ u t)) :=
    (sys.SV.isWeakSol_iff hT.le hBu).2 fun t ht => ιWV_mildW_eq_mildSol hH1 hT hu ht.2
  obtain ⟨-, -, hint⟩ := (sys.SV.isWeakSol_iff_extrap hBu).1 hweak
  refine ⟨?_, fun t ht => ?_⟩
  · have hx : MemLp (sys.mildW w₀ u) 2 (μI T) := memLp_mildW hH1 hT hu w₀
    exact ((sys.SV.genExtrap ∘L sys.ιWV).comp_memLp' hx).add
      ((sys.SV.toExtrap ∘L sys.B).comp_memLp' hu)
  · simp only [mildW_zero_time]
    exact hint t ht

/-- **Synthesis factorisation** (`eq:synthesis-factorization`, `app:willems-gramian` Step 2):
under `hyp:H1`, for the record `(ū, x̄, ȳ)` generated by `(x̄₀, ū) ∈ W × L²(I; U)` (state
`x̄ = sys.mildW x̄₀ ū`, output `ȳ = C x̄ = sys.outputW x̄₀ ū`) and every test function `φ`,
`𝒲_{(ū,x̄,ȳ)} φ = Γ (∫₀ᵀ φ ū, ∫₀ᵀ φ x̄)`. -/
theorem synth_eq_graphOp {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {w₀ : W} {u : ℝ → U}
    (hu : MemLp u 2 (μI T)) {φ : ℝ → ℝ} (hφ : IsTestFunction T φ) :
    sys.synth T u (sys.mildW w₀ u) (sys.outputW w₀ u) φ =
      sys.graphOp (WithLp.toLp 2
        (∫ t in Ioc 0 T, φ t • u t, ∫ t in Ioc 0 T, φ t • sys.mildW w₀ u t)) := by
  rw [synth_eq_of_hasWeakDeriv (continuousOn_mildW hH1 hT hu w₀)
    (hasWeakDeriv_toExtrap_mildW hH1 hT hu) hφ, graphOp_apply]
  have hxi : Integrable (fun t => φ t • sys.mildW w₀ u t) (μI T) :=
    (hφ.integrable_smul ((memLp_mildW hH1 hT hu w₀).integrable one_le_two)).restrict
  have hui : Integrable (fun t => φ t • u t) (μI T) :=
    (hφ.integrable_smul (hu.integrable one_le_two)).restrict
  have e : (fun t => φ t • sys.vecField (u t) (sys.mildW w₀ u t)) = fun t =>
      (sys.SV.genExtrap ∘L sys.ιWV) (φ t • sys.mildW w₀ u t) +
        (sys.SV.toExtrap ∘L sys.B) (φ t • u t) := by
    funext t
    simp only [vecField, smul_add, map_smul, ContinuousLinearMap.comp_apply]
  have e' : (fun t => φ t • sys.outputW w₀ u t) = fun t => sys.C (φ t • sys.mildW w₀ u t) := by
    funext t
    simp only [outputW, map_smul]
  rw [e, e', integral_add ((sys.SV.genExtrap ∘L sys.ιWV).integrable_comp hxi)
      ((sys.SV.toExtrap ∘L sys.B).integrable_comp hui),
    (sys.SV.genExtrap ∘L sys.ιWV).integral_comp_comm hxi,
    (sys.SV.toExtrap ∘L sys.B).integral_comp_comm hui, sys.C.integral_comp_comm hxi]
  rfl

end System

end DataDrivenControl
