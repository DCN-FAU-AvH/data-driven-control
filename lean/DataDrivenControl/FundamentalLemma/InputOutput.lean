module

public import DataDrivenControl.Informativity.Window
public import DataDrivenControl.Analysis.BoundedBelow
public import DataDrivenControl.System.Controllability

/-!
# The input–output fundamental lemma

Paper: `def:io-behavior`, `lem:io-parametrization`, `eq:io-state-recovery`,
`eq:window-factorization`, `thm:windowed-io-fundamental-lemma`, `eq:io-window-synthesis`
(the operator `𝒴 = ioWindowSynth`, defined in `Signal/Shift`),
`eq:io-behavior-identification` (`app:windowed-io-fundamental-lemma`).

## Main declarations

* `System.ioBehavior T`: the input–output behaviour `𝓑_T^{u,y}` (`def:io-behavior`), the set of
  `(u, y) ∈ L²(0, T; U) × L²(0, T; Y)` with `y = 𝓞_T x₀ + 𝓕_T u` for some `x₀ ∈ X`.
* `System.ioParam T`: the parametrisation `𝓜_T (u, x₀) = (u, 𝓕_T u + 𝓞_T x₀)`
  (`lem:io-parametrization`), a bounded operator `L²(0, T; U) × X → L²(0, T; U) × L²(0, T; Y)`.
* `lem:io-parametrization`: `range_ioParam` (`im 𝓜_T = 𝓑_T^{u,y}`), `ioParam_injective`
  (approximate observability), `isBoundedBelow_ioParam` and `isClosed_ioBehavior` (exact
  observability), `eq_ioStateRecovery` (`eq:io-state-recovery`,
  `x₀ = (𝓞_T† 𝓞_T)⁻¹ 𝓞_T† (y - 𝓕_T u)`), `ioWindowSynth_eq_ioParam_comp`
  (`eq:window-factorization`, `𝒴 = 𝓜_T 𝒵`).
* `System.closure_range_ioWindowSynth`: `thm:windowed-io-fundamental-lemma`
  (`eq:io-behavior-identification`), `closure (im 𝒴) = closure 𝓑_T^{u,y}` for a
  window-informative record.

A record on `[0, T + T']` generated by `(x₀, ū) ∈ X × L²(0, T + T'; U)` has state
`sys.mild x₀ ū` and output `sys.output (T + T') x₀ ū` (`System/Mild`).

## Upstream results used

`System.output_shift`, `System.output_ae_eq`, `System.memLp_output`, `System.memLp_mild`
(`System/Mild`); `ioWindowSynth_eq_comp_windowSynth`, `coeFn_window_of_memLp`, `window_eq_toLp`,
`memLp_comp_add` (`Signal/Shift`); `IsBoundedBelow.adjointCompSelfEquiv_symm_adjoint_apply`,
`IsBoundedBelow.isClosed_range` (`Analysis/BoundedBelow`).
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped InnerProductSpace

noncomputable section

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace DataDrivenControl

namespace System

variable {U W X V Y : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]

variable (sys : System U W X V Y)

/-- The **input–output behaviour** on `[0, T]` (`def:io-behavior`):
`𝓑_T^{u,y} = {(u, y) ∈ L²(0, T; U) × L²(0, T; Y) : y = 𝓞_T x₀ + 𝓕_T u for some x₀ ∈ X}`. -/
def ioBehavior (T : ℝ) : Set (WithLp 2 (L2 U T × L2 Y T)) :=
  {p | ∃ x₀ : X, p.snd = sys.𝓞 T x₀ + sys.𝓕 T p.fst}

/-- The **input–output parametrisation** (`lem:io-parametrization`)
`𝓜_T : L²(0, T; U) × X → L²(0, T; U) × L²(0, T; Y)`, `(u, x₀) ↦ (u, 𝓕_T u + 𝓞_T x₀)`. -/
def ioParam (T : ℝ) : WithLp 2 (L2 U T × X) →L[ℝ] WithLp 2 (L2 U T × L2 Y T) :=
  ((WithLp.prodContinuousLinearEquiv 2 ℝ (L2 U T) (L2 Y T)).symm :
      (L2 U T × L2 Y T) →L[ℝ] WithLp 2 (L2 U T × L2 Y T)) ∘L
    (WithLp.fstL 2 ℝ (L2 U T) X).prod
      (sys.𝓕 T ∘L WithLp.fstL 2 ℝ (L2 U T) X + sys.𝓞 T ∘L WithLp.sndL 2 ℝ (L2 U T) X)

variable {sys}

/-- The input component of `𝓜_T (u, x₀)` is `u`. -/
@[simp] theorem fst_ioParam {T : ℝ} (p : WithLp 2 (L2 U T × X)) :
    (sys.ioParam T p).fst = p.fst :=
  rfl

/-- The output component of `𝓜_T (u, x₀)` is `𝓕_T u + 𝓞_T x₀`. -/
@[simp] theorem snd_ioParam {T : ℝ} (p : WithLp 2 (L2 U T × X)) :
    (sys.ioParam T p).snd = sys.𝓕 T p.fst + sys.𝓞 T p.snd :=
  rfl

/-- `lem:io-parametrization`: `im 𝓜_T = 𝓑_T^{u,y}`. -/
theorem range_ioParam (T : ℝ) : Set.range (sys.ioParam T) = sys.ioBehavior T := by
  ext p
  constructor
  · rintro ⟨q, rfl⟩
    exact ⟨q.snd, by rw [snd_ioParam, fst_ioParam, add_comm]⟩
  · rintro ⟨x₀, hx₀⟩
    refine ⟨WithLp.toLp 2 (p.fst, x₀), WithLp.ofLp_injective 2 (Prod.ext rfl ?_)⟩
    change (sys.ioParam T (WithLp.toLp 2 (p.fst, x₀))).snd = p.snd
    rw [snd_ioParam, hx₀, add_comm]
    rfl

/-- `lem:io-parametrization`: if `(A, C)` is approximately observable in time `T`, then `𝓜_T`
is injective. -/
theorem ioParam_injective {T : ℝ} (h : sys.ApproxObservable T) :
    Function.Injective (sys.ioParam T) := by
  refine (injective_iff_map_eq_zero (sys.ioParam T)).2 fun p hp => ?_
  have h1 : p.fst = 0 := by
    rw [← fst_ioParam (sys := sys), hp]
    rfl
  have h2 : p.snd ∈ LinearMap.ker (sys.𝓞 T : X →ₗ[ℝ] L2 Y T) := by
    have := congrArg WithLp.snd hp
    rw [snd_ioParam, h1, map_zero, zero_add, WithLp.zero_snd] at this
    exact this
  rw [h, Submodule.mem_bot] at h2
  exact WithLp.ofLp_injective 2 (Prod.ext h1 h2)

/-- Exact observability is the bounded-belowness of `𝓞_T`. -/
theorem ExactlyObservable.isBoundedBelow {T : ℝ} (h : sys.ExactlyObservable T) :
    IsBoundedBelow (sys.𝓞 T) :=
  h

/-- `lem:io-parametrization`: if `(A, C)` is exactly observable in time `T`, then `𝓜_T` is
bounded below, hence a homeomorphism onto its closed range `𝓑_T^{u,y}`. -/
theorem isBoundedBelow_ioParam {T : ℝ} (h : sys.ExactlyObservable T) :
    IsBoundedBelow (sys.ioParam T) := by
  obtain ⟨c, hc, hcO⟩ := h
  have hK : 0 ≤ ‖sys.𝓕 T‖ := (sys.𝓕 T).opNorm_nonneg
  refine IsBoundedBelow.of_bound (c := c / (c + 1 + ‖sys.𝓕 T‖)) (by positivity) fun p => ?_
  set q := sys.ioParam T p with hq
  have hu : ‖p.fst‖ ≤ ‖q‖ := by
    have := WithLp.norm_fst_le (x := q)
    rwa [hq, fst_ioParam] at this
  have hy : ‖q.snd‖ ≤ ‖q‖ := WithLp.norm_snd_le (x := q)
  have hO : sys.𝓞 T p.snd = q.snd - sys.𝓕 T p.fst := by
    rw [hq, snd_ioParam, add_sub_cancel_left]
  have hF : ‖sys.𝓕 T p.fst‖ ≤ ‖sys.𝓕 T‖ * ‖p.fst‖ := (sys.𝓕 T).le_opNorm _
  have hx1 : c * ‖p.snd‖ ≤ ‖q.snd‖ + ‖sys.𝓕 T p.fst‖ := by
    have h1 := hcO p.snd
    rw [hO] at h1
    exact h1.trans (norm_sub_le _ _)
  have hp2 := WithLp.prod_norm_sq_eq_of_L2 p
  have hnp0 := norm_nonneg p
  have ha := norm_nonneg p.fst
  have hb := norm_nonneg p.snd
  generalize ‖p‖ = np at hp2 hnp0 ⊢
  generalize ‖q‖ = nq at hu hy ⊢
  generalize ‖p.fst‖ = a at hu hF hp2 ha
  generalize ‖p.snd‖ = b at hx1 hp2 hb
  generalize ‖q.snd‖ = d at hy hx1
  generalize ‖sys.𝓕 T p.fst‖ = e at hF hx1
  generalize ‖sys.𝓕 T‖ = K at hK hF ⊢
  have hnp : np ≤ a + b := by nlinarith
  rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
  nlinarith

/-- `lem:io-parametrization`: under exact observability in time `T`, the behaviour
`𝓑_T^{u,y}` is closed. -/
theorem isClosed_ioBehavior {T : ℝ} (h : sys.ExactlyObservable T) :
    IsClosed (sys.ioBehavior T) := by
  rw [← range_ioParam]
  exact (isBoundedBelow_ioParam h).isClosed_range

/-- **State recovery** (`eq:io-state-recovery`, `lem:io-parametrization`): under exact
observability in time `T`, the latent state of `(u, y) ∈ 𝓑_T^{u,y}` is
`x₀ = (𝓞_T† 𝓞_T)⁻¹ 𝓞_T† (y - 𝓕_T u)`. -/
theorem eq_ioStateRecovery {T : ℝ} (h : sys.ExactlyObservable T) {u : L2 U T} {y : L2 Y T}
    {x₀ : X} (hy : y = sys.𝓞 T x₀ + sys.𝓕 T u) :
    x₀ = h.isBoundedBelow.adjointCompSelfEquiv.symm
      ((ContinuousLinearMap.adjoint (sys.𝓞 T)) (y - sys.𝓕 T u)) := by
  rw [hy, add_sub_cancel_right, IsBoundedBelow.adjointCompSelfEquiv_symm_adjoint_apply]

/-- **Window factorisation** (`eq:window-factorization`, `lem:io-parametrization`): for the record
`(ū, x̄, ȳ)` on `[0, T + T']` generated by `(x₀, ū) ∈ X × L²(0, T + T'; U)`,
`𝒴_{T,T'}^{ū,ȳ} = 𝓜_T 𝒵_{T,T'}^{ū,x̄}`. -/
theorem ioWindowSynth_eq_ioParam_comp {T T' : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T)
    (hT : 0 < T) {x₀ : X} {u : ℝ → U} (hu : MemLp u 2 (μI (T + T'))) :
    ioWindowSynth T T' u (sys.output (T + T') x₀ u) =
      sys.ioParam T ∘L windowSynth T T' u (sys.mild x₀ u) := by
  refine ioWindowSynth_eq_comp_windowSynth _ hu
    (memLp_mild hH1 hT (memLp_μI_of_le hu (by linarith)) x₀) (memLp_output hH1 hT hu x₀) ?_
  refine (ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall fun s hs => ?_)
  have hs0 : 0 ≤ s := hs.1.le
  have hsT : s + T ≤ T + T' := by linarith [hs.2]
  have hus : MemLp (fun r => u (s + r)) 2 (μI T) := memLp_comp_add hu hs0 hsT
  refine WithLp.ofLp_injective 2 (Prod.ext rfl ?_)
  change window T (sys.output (T + T') x₀ u) s =
    sys.𝓕 T (window T u s) + sys.𝓞 T (sys.mild x₀ u s)
  rw [window_eq_toLp hus, add_comm (sys.𝓕 T _)]
  refine Lp.ext ?_
  filter_upwards [coeFn_window_of_memLp (memLp_output hH1 hT hu x₀) hs0 hsT,
    output_shift hH1 hH2 hT hs0 hsT hu x₀, output_ae_eq hH1 hT hus (sys.mild x₀ u s)]
    with t h1 h2 h3
  rw [h1, h2, h3]

/-- **Fundamental lemma, input–output** (`thm:windowed-io-fundamental-lemma`,
`eq:io-behavior-identification`): under Assumptions `hyp:H1` and `hyp:H2`, let `(ū, x̄, ȳ)` be the
record on `[0, T + T']` generated by `ū` and `x₀ ∈ X`.  If `(ū, x̄)` is window informative, then
`closure (im 𝒴_{T,T'}^{ū,ȳ}) = closure 𝓑_T^{u,y}`. -/
theorem closure_range_ioWindowSynth {T T' : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T) (hT : 0 < T)
    {x₀ : X} {u : ℝ → U} (hu : MemLp u 2 (μI (T + T')))
    (hw : WindowInformative T T' u (sys.mild x₀ u)) :
    closure (Set.range (ioWindowSynth T T' u (sys.output (T + T') x₀ u))) =
      closure (sys.ioBehavior T) := by
  rw [ioWindowSynth_eq_ioParam_comp hH1 hH2 hT hu, ← range_ioParam]
  have hr : Set.range (sys.ioParam T ∘L windowSynth T T' u (sys.mild x₀ u)) =
      sys.ioParam T '' Set.range (windowSynth T T' u (sys.mild x₀ u)) := by
    rw [ContinuousLinearMap.coe_comp, Set.range_comp]
  refine subset_antisymm (closure_mono (hr ▸ Set.image_subset_range _ _)) ?_
  refine closure_minimal ?_ isClosed_closure
  rintro _ ⟨p, rfl⟩
  have hp : p ∈ closure (Set.range (windowSynth T T' u (sys.mild x₀ u))) := by
    rw [DenseRange.closure_range hw]
    trivial
  rw [hr]
  exact image_closure_subset_closure_image (sys.ioParam T).continuous ⟨p, hp, rfl⟩

end System

end DataDrivenControl
