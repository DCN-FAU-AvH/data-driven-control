module

public import DataDrivenControl.FundamentalLemma.Graph
public import DataDrivenControl.Signal.WeakDerivative

/-!
# Willems' fundamental lemma

Paper: `thm:willems-gramian`, `eq:graph-identification`, `eq:record-dynamics`,
`rmk:input-state-case` (`app:willems-gramian`).

## Conventions

The record is generated by `(x̄₀, ū) ∈ W × L²(I; U)`: state `x̄ = sys.mildW x̄₀ ū` (`C(I; W)`),
output `ȳ = C x̄ = sys.outputW x̄₀ ū`.  Its derivative `ẋ̄ ∈ L²(I; V₋₁)` enters the Gramian
`𝒢 = 𝒢(ū, x̄, ẋ̄, ȳ)` as an **explicit signal** `xd`, any weak derivative of `x̄` in `V₋₁`
(hypothesis `HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (x̄ t))) xd`; all of them agree
a.e. and give the same Gramian, and one exists by `eq:record-dynamics`).
A candidate trajectory is `u : ℝ → U` with `MemLp u 2 (μI T)`, `x : ℝ → W` with
`ContinuousOn x (Icc 0 T)` and weak derivative `xd` in `V₋₁` (`x ∈ C(I; W) ∩ H¹(I; V₋₁)`), and
`y : ℝ → Y` with `MemLp y 2 (μI T)`.

## Main declarations

* `System.recordGramian T x̄₀ ū xd`: `𝒢(ū, x̄, ẋ̄, ȳ)` on `U × W × V₋₁ × Y` for the record.
* `System.hasWeakDeriv_mildW`: `eq:record-dynamics`, `x̄ ∈ H¹(I; V₋₁)` with
  `ẋ̄ = A x̄ + B ū` (`app:willems-gramian`, Step 1, via Ball's theorem).
* `System.graph_identification`: `eq:graph-identification`,
  `(ker 𝒢)ᗮ = closure (im 𝒲_{(ū,x̄,ȳ)}) = im Γ` (`thm:willems-gramian`, first part).
* `System.willems_tfae`: the equivalence (i) ⇔ (ii) ⇔ (iii) of `thm:willems-gramian`.
* `System.eq_mild_of_trajectory`: "then `(x, y)` is the mild solution generated by
  `(x(0), u)`" (`thm:willems-gramian`, last sentence; `app:willems-gramian`, Step 4).  It only
  needs condition (i) and `hyp:H1` (strengthening: no record, no informativity).
* `System.inputState Y₀`, `System.H1.inputState`, `System.inputState_mildW`:
  `rmk:input-state-case`.  The input–state system replaces `W` by `X` (`ιW = id`) and the
  output by `C = 0` into `Y₀` (take `Y₀ = {0}`); `hyp:H1` is inherited, and its mild solution
  is that of `sys`.  `thm:willems-gramian` applied to `sys.inputState Y₀` is the input–state
  case: informativity in `U × X`, graph in `U × X × V₋₁ × Y₀` with vanishing fourth component.

Helpers: `System.integral_smul_vecField` (`A`, `B` through the Bochner integral),
`System.record_ae_eq_graphOp` (`v̄ = Γ z̄` a.e.), `System.orthogonal_ker_recordGramian`
(`(ker 𝒢)ᗮ = im Γ`), `System.exists_submodule_moments` and `System.dense_moments` (the moment
space `𝒩` is a dense subspace of `U × W`).

## Proof notes (`app:willems-gramian`)

* Step 2: `(ker 𝒢)ᗮ = cspan v̄` (`orthogonal_ker_gramian`), `v̄ = Γ z̄` a.e. (`cspan_congr`), and
  `cspan (Γ z̄) = im Γ` (`cspan_comp_eq_range`, `Γ` bounded below, informativity).  Density of `𝒩`
  uses the fundamental lemma on test functions (`ae_eq_zero_of_integral_smul_eq_zero`) instead of
  the density of `H₀¹(I)` in `L²(I)`; then `im Γ = Γ (closure 𝒩) ⊆ closure (Γ 𝒩) = closure (im 𝒲)`.
* Step 3: (ii) ⇒ (iii) writes `𝒲 φ` as the Bochner integral of `φ (u, x, ẋ, y)`
  (`GraphSpace.integral_mk`) and uses `integral_mem_of_ae_mem`; (iii) ⇒ (i) compares components
  (`GraphSpace.mk_inj`) and concludes with `ae_eq_of_integral_smul_eq`.
* Step 4 (**different route**): instead of "`x` is a strong solution on `V₋₁`", the integral form
  `ẋ = A₋₁ x + B u` in `V₋₁` is Ball's weak formulation on `V` (`isWeakSol_iff_extrap`), so Ball's
  theorem (`IsWeakSol.eq_mildSol`) makes `ιWV x` the mild solution on `V`, which is `ιWV` of
  `sys.mildW (x 0) u` under `hyp:H1` (`ιWV_mildW_eq_mildSol`); `ιWV` is injective.
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped InnerProductSpace

noncomputable section

set_option linter.unusedSectionVars false

namespace DataDrivenControl

namespace System

variable {U W X V Y : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]

variable (sys : System U W X V Y)

/-- The Gramian `𝒢 = 𝒢(ū, x̄, ẋ̄, ȳ)` on `U × W × V₋₁ × Y` (`thm:willems-gramian`) of the record
generated by `(x̄₀, ū) ∈ W × L²(I; U)`, with state `x̄ = sys.mildW x̄₀ ū`, output
`ȳ = sys.outputW x̄₀ ū` and state derivative `ẋ̄ = xd` (an explicit `V₋₁`-valued signal). -/
def recordGramian (T : ℝ) (w₀ : W) (u : ℝ → U) (xd : ℝ → sys.SV.Extrap) :
    sys.GraphSpace →L[ℝ] sys.GraphSpace :=
  sys.graphGramian T u (sys.mildW w₀ u) xd (sys.outputW w₀ u)

variable {sys}

/-- **Regularity of the record** (`eq:record-dynamics`, `app:willems-gramian` Step 1): under
`hyp:H1`, the state `x̄ = x(·; x̄₀, ū)` of the record generated by `(x̄₀, ū) ∈ W × L²(I; U)` is in
`H¹(I; V₋₁)` with `ẋ̄ = A x̄ + B ū` in `L²(I; V₋₁)`. -/
theorem hasWeakDeriv_mildW {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {w₀ : W} {u : ℝ → U}
    (hu : MemLp u 2 (μI T)) :
    HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (sys.mildW w₀ u t)))
      (fun t => sys.vecField (u t) (sys.mildW w₀ u t)) :=
  hasWeakDeriv_toExtrap_mildW hH1 hT hu

/-- `∫₀ᵀ φ (A x + B u) = A ∫₀ᵀ φ x + B ∫₀ᵀ φ u` in `V₋₁` (`A`, `B` pass through the Bochner
integrals, `app:willems-gramian` Step 2). -/
theorem integral_smul_vecField {T : ℝ} {u : ℝ → U} {x : ℝ → W} {φ : ℝ → ℝ}
    (hu : Integrable (fun t => φ t • u t) (μI T)) (hx : Integrable (fun t => φ t • x t) (μI T)) :
    ∫ t in Ioc 0 T, φ t • sys.vecField (u t) (x t) =
      sys.vecField (∫ t in Ioc 0 T, φ t • u t) (∫ t in Ioc 0 T, φ t • x t) := by
  have e : (fun t => φ t • sys.vecField (u t) (x t)) = fun t =>
      (sys.SV.genExtrap ∘L sys.ιWV) (φ t • x t) + (sys.SV.toExtrap ∘L sys.B) (φ t • u t) := by
    funext t
    simp only [vecField, smul_add, map_smul, ContinuousLinearMap.comp_apply]
  rw [e, integral_add ((sys.SV.genExtrap ∘L sys.ιWV).integrable_comp hx)
      ((sys.SV.toExtrap ∘L sys.B).integrable_comp hu),
    (sys.SV.genExtrap ∘L sys.ιWV).integral_comp_comm hx,
    (sys.SV.toExtrap ∘L sys.B).integral_comp_comm hu]
  rfl

/-- The record `(ū, x̄, ẋ̄, ȳ)` is `Γ (ū, x̄)` almost everywhere (`app:willems-gramian` Step 2,
from `eq:record-dynamics` and `ȳ = C x̄`). -/
theorem record_ae_eq_graphOp {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {w₀ : W} {ū : ℝ → U}
    (hū : MemLp ū 2 (μI T)) {xd : ℝ → sys.SV.Extrap}
    (hxd : HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (sys.mildW w₀ ū t))) xd) :
    (fun t => GraphSpace.mk (ū t) (sys.mildW w₀ ū t) (xd t) (sys.outputW w₀ ū t)) =ᵐ[μI T]
      fun t => sys.graphOp (WithLp.toLp 2 (ū t, sys.mildW w₀ ū t)) := by
  filter_upwards [hxd.ae_eq (hasWeakDeriv_toExtrap_mildW hH1 hT hū)] with t ht
  rw [graphOp_apply, ht]
  rfl

/-- `(ker 𝒢)ᗮ = cspan (Γ z̄) = Γ (cspan z̄) = im Γ` (`app:willems-gramian` Step 2). -/
theorem orthogonal_ker_recordGramian {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {w₀ : W}
    {ū : ℝ → U} (hū : MemLp ū 2 (μI T)) {xd : ℝ → sys.SV.Extrap}
    (hxd : HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (sys.mildW w₀ ū t))) xd)
    (hinf : Informative T ū (sys.mildW w₀ ū)) :
    (sys.recordGramian T w₀ ū xd).kerᗮ = sys.graphOp.range := by
  have hv := record_ae_eq_graphOp hH1 hT hū hxd
  have hz : MemLp (fun t => WithLp.toLp 2 (ū t, sys.mildW w₀ ū t)) 2 (μI T) :=
    MemLp.of_fst_of_snd_prodLp ⟨hū, memLp_mildW hH1 hT hū w₀⟩
  have hΓz : MemLp (fun t => sys.graphOp (WithLp.toLp 2 (ū t, sys.mildW w₀ ū t))) 2 (μI T) :=
    sys.graphOp.comp_memLp' hz
  have hvm : MemLp (fun t => GraphSpace.mk (ū t) (sys.mildW w₀ ū t) (xd t)
      (sys.outputW w₀ ū t)) 2 (μI T) :=
    MemLp.ae_eq hv.symm hΓz
  have h1 : (sys.recordGramian T w₀ ū xd).kerᗮ = cspan ℝ (μI T) (fun t => GraphSpace.mk (ū t)
      (sys.mildW w₀ ū t) (xd t) (sys.outputW w₀ ū t)) := by
    rw [recordGramian, graphGramian]
    exact orthogonal_ker_gramian hvm
  have h2 : cspan ℝ (μI T) (fun t => GraphSpace.mk (ū t) (sys.mildW w₀ ū t) (xd t)
      (sys.outputW w₀ ū t)) =
      cspan ℝ (μI T) (fun t => sys.graphOp (WithLp.toLp 2 (ū t, sys.mildW w₀ ū t))) :=
    cspan_congr hv
  have h3 : cspan ℝ (μI T) (fun t => sys.graphOp (WithLp.toLp 2 (ū t, sys.mildW w₀ ū t))) =
      sys.graphOp.range :=
    cspan_comp_eq_range isBoundedBelow_graphOp hinf
  exact h1.trans (h2.trans h3)

/-- The moments `𝒩 = {(∫₀ᵀ φ u, ∫₀ᵀ φ x) : φ ∈ C_c^∞(0, T)}` form a subspace of `U × W`. -/
theorem exists_submodule_moments {T : ℝ} {u : ℝ → U} {x : ℝ → W} (hu : Integrable u (μI T))
    (hx : Integrable x (μI T)) :
    ∃ N : Submodule ℝ (WithLp 2 (U × W)), (N : Set (WithLp 2 (U × W))) =
      (fun φ : ℝ → ℝ => WithLp.toLp 2 (∫ t in Ioc 0 T, φ t • u t, ∫ t in Ioc 0 T, φ t • x t)) ''
        {φ | IsTestFunction T φ} := by
  refine ⟨{ carrier := (fun φ : ℝ → ℝ => WithLp.toLp 2
      (∫ t in Ioc 0 T, φ t • u t, ∫ t in Ioc 0 T, φ t • x t)) '' {φ | IsTestFunction T φ}
            add_mem' := ?_
            zero_mem' := ?_
            smul_mem' := ?_ }, rfl⟩
  · rintro _ _ ⟨φ, hφ, rfl⟩ ⟨ψ, hψ, rfl⟩
    refine ⟨φ + ψ, hφ.add hψ, ?_⟩
    simp only [Pi.add_apply, add_smul]
    rw [integral_add (hφ.integrable_smul hu).restrict (hψ.integrable_smul hu).restrict,
      integral_add (hφ.integrable_smul hx).restrict (hψ.integrable_smul hx).restrict,
      ← WithLp.toLp_add, Prod.mk_add_mk]
  · exact ⟨0, IsTestFunction.zero, by simp⟩
  · rintro c _ ⟨φ, hφ, rfl⟩
    refine ⟨c • φ, hφ.const_smul c, ?_⟩
    simp only [Pi.smul_apply, smul_eq_mul, mul_smul, integral_smul, ← WithLp.toLp_smul,
      Prod.smul_mk]

/-- **Density of `𝒩`** (`app:willems-gramian` Step 2): for an informative pair `(u, x)`, the
moments `(∫₀ᵀ φ u, ∫₀ᵀ φ x)` over test functions `φ` are dense in `U × W`. -/
theorem dense_moments {T : ℝ} {u : ℝ → U} {x : ℝ → W} (hu : Integrable u (μI T))
    (hx : Integrable x (μI T)) (hinf : Informative T u x) :
    Dense ((fun φ : ℝ → ℝ => WithLp.toLp 2 (∫ t in Ioc 0 T, φ t • u t,
      ∫ t in Ioc 0 T, φ t • x t)) '' {φ | IsTestFunction T φ}) := by
  obtain ⟨N, hN⟩ := exists_submodule_moments hu hx
  rw [← hN, Submodule.dense_iff_topologicalClosure_eq_top,
    Submodule.topologicalClosure_eq_top_iff, Submodule.eq_bot_iff]
  rintro ⟨a, b⟩ hp
  have hmom : ∀ φ, IsTestFunction T φ →
      ⟪a, ∫ t in Ioc 0 T, φ t • u t⟫_ℝ + ⟪b, ∫ t in Ioc 0 T, φ t • x t⟫_ℝ = 0 := by
    intro φ hφ
    have hmem : WithLp.toLp 2 (∫ t in Ioc 0 T, φ t • u t, ∫ t in Ioc 0 T, φ t • x t) ∈ N := by
      rw [← SetLike.mem_coe, hN]
      exact ⟨φ, hφ, rfl⟩
    have := Submodule.inner_right_of_mem_orthogonal hmem hp
    simp only [WithLp.prod_inner_apply] at this
    rw [← real_inner_comm a, ← real_inner_comm b]
    exact this
  have hg : Integrable (fun t => ⟪a, u t⟫_ℝ + ⟪b, x t⟫_ℝ) (μI T) :=
    (hu.const_inner a).add (hx.const_inner b)
  have hae := ae_eq_zero_of_integral_smul_eq_zero hg fun φ hφ => by
    rw [hφ.integral_smul_eq_setIntegral]
    have e : (fun t => φ t • (⟪a, u t⟫_ℝ + ⟪b, x t⟫_ℝ)) =
        fun t => ⟪a, φ t • u t⟫_ℝ + ⟪b, φ t • x t⟫_ℝ := by
      funext t
      simp only [smul_eq_mul, inner_smul_right, mul_add]
    rw [e, integral_add ((hφ.integrable_smul hu).restrict.const_inner a)
        ((hφ.integrable_smul hx).restrict.const_inner b),
      integral_inner (hφ.integrable_smul hu).restrict, integral_inner (hφ.integrable_smul hx).restrict]
    exact hmom φ hφ
  obtain ⟨ha, hb⟩ := hinf.eq_zero hae
  subst ha hb
  rfl

/-- **Graph identification** (`eq:graph-identification`, first part of `thm:willems-gramian`):
under `hyp:H1`, let `(x̄, ȳ)` be the mild solution generated by `(x̄₀, ū) ∈ W × L²(I; U)`, `ẋ̄` a
weak derivative of `x̄` in `V₋₁`, and suppose `(ū, x̄)` is informative in `U × W`.  With
`𝒢 = 𝒢(ū, x̄, ẋ̄, ȳ)`,
`(ker 𝒢)ᗮ = closure (im 𝒲_{(ū,x̄,ȳ)}) = im Γ`
(`𝒲` on test functions). -/
theorem graph_identification {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {w₀ : W} {ū : ℝ → U}
    (hū : MemLp ū 2 (μI T)) {xd : ℝ → sys.SV.Extrap}
    (hxd : HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (sys.mildW w₀ ū t))) xd)
    (hinf : Informative T ū (sys.mildW w₀ ū)) :
    ((sys.recordGramian T w₀ ū xd).kerᗮ : Set sys.GraphSpace) =
        closure (sys.synth T ū (sys.mildW w₀ ū) (sys.outputW w₀ ū) '' {φ | IsTestFunction T φ}) ∧
      (sys.recordGramian T w₀ ū xd).kerᗮ = sys.graphOp.range := by
  have hK := orthogonal_ker_recordGramian hH1 hT hū hxd hinf
  refine ⟨?_, hK⟩
  have hui : Integrable ū (μI T) := hū.integrable one_le_two
  have hxi : Integrable (sys.mildW w₀ ū) (μI T) :=
    (memLp_mildW hH1 hT hū w₀).integrable one_le_two
  have himg : sys.synth T ū (sys.mildW w₀ ū) (sys.outputW w₀ ū) '' {φ | IsTestFunction T φ} =
      sys.graphOp '' ((fun φ : ℝ → ℝ => WithLp.toLp 2 (∫ t in Ioc 0 T, φ t • ū t,
        ∫ t in Ioc 0 T, φ t • sys.mildW w₀ ū t)) '' {φ | IsTestFunction T φ}) := by
    rw [Set.image_image]
    exact Set.image_congr fun φ hφ => synth_eq_graphOp hH1 hT hū hφ
  rw [hK, himg, LinearMap.coe_range, ContinuousLinearMap.coe_coe]
  refine Set.Subset.antisymm ?_ (closure_minimal (Set.image_subset_range _ _)
    isClosed_range_graphOp)
  rintro _ ⟨p, rfl⟩
  have hp : p ∈ closure ((fun φ : ℝ → ℝ => WithLp.toLp 2 (∫ t in Ioc 0 T, φ t • ū t,
      ∫ t in Ioc 0 T, φ t • sys.mildW w₀ ū t)) '' {φ | IsTestFunction T φ}) := by
    rw [(dense_moments hui hxi hinf).closure_eq]
    trivial
  exact image_closure_subset_closure_image sys.graphOp.continuous ⟨p, hp, rfl⟩

/-- **Willems' fundamental lemma** (`thm:willems-gramian`, the equivalences): under the
hypotheses of `graph_identification`, for every `u ∈ L²(I; U)`, `x ∈ C(I; W) ∩ H¹(I; V₋₁)` with
weak derivative `ẋ = xd`, and `y ∈ L²(I; Y)`, the following are equivalent:
1. (i) `(u, x, y)` is a trajectory: `ẋ = A x + B u` in `L²(I; V₋₁)` and `y = C x` in
   `L²(I; Y)`;
2. (ii) `(u, x, ẋ, y)(t) ∈ (ker 𝒢)ᗮ` for a.e. `t ∈ I`;
3. (iii) `im 𝒲_{(u,x,y)} ⊆ (ker 𝒢)ᗮ` (on test functions). -/
theorem willems_tfae {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {w₀ : W} {ū : ℝ → U}
    (hū : MemLp ū 2 (μI T)) {xdr : ℝ → sys.SV.Extrap}
    (hxdr : HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (sys.mildW w₀ ū t))) xdr)
    (hinf : Informative T ū (sys.mildW w₀ ū))
    {u : ℝ → U} {x : ℝ → W} {xd : ℝ → sys.SV.Extrap} {y : ℝ → Y}
    (hu : MemLp u 2 (μI T)) (hxc : ContinuousOn x (Icc 0 T))
    (hxd : HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (x t))) xd)
    (hy : MemLp y 2 (μI T)) :
    List.TFAE
      [(∀ᵐ t ∂(μI T), xd t = sys.vecField (u t) (x t)) ∧ (∀ᵐ t ∂(μI T), y t = sys.C (x t)),
        ∀ᵐ t ∂(μI T),
          GraphSpace.mk (u t) (x t) (xd t) (y t) ∈ (sys.recordGramian T w₀ ū xdr).kerᗮ,
        ∀ φ : ℝ → ℝ, IsTestFunction T φ →
          sys.synth T u x y φ ∈ (sys.recordGramian T w₀ ū xdr).kerᗮ] := by
  have hK := orthogonal_ker_recordGramian hH1 hT hū hxdr hinf
  have hxi : Integrable x (μI T) := (memLp_μI_of_continuousOn hxc).integrable one_le_two
  have hui : Integrable u (μI T) := hu.integrable one_le_two
  have hyi : Integrable y (μI T) := hy.integrable one_le_two
  have hxdi : Integrable xd (μI T) := hxd.integrable_deriv
  tfae_have 1 → 2 := by
    rintro ⟨h1, h2⟩
    filter_upwards [h1, h2] with t ht1 ht2
    rw [hK, ht1, ht2, ← graphOp_apply]
    exact LinearMap.mem_range_self _ _
  tfae_have 2 → 3 := by
    intro h φ hφ
    rw [synth_eq_of_hasWeakDeriv hxc hxd hφ, ← GraphSpace.integral_mk
      (hφ.integrable_smul hui).restrict (hφ.integrable_smul hxi).restrict
      (hφ.integrable_smul hxdi).restrict (hφ.integrable_smul hyi).restrict]
    refine integral_mem_of_ae_mem (Submodule.isClosed_orthogonal _) ?_
    filter_upwards [h] with t ht
    rw [← GraphSpace.smul_mk]
    exact Submodule.smul_mem _ _ ht
  tfae_have 3 → 1 := by
    intro h
    have key : ∀ φ, IsTestFunction T φ →
        (∫ t, φ t • xd t = ∫ t, φ t • sys.vecField (u t) (x t)) ∧
          ∫ t, φ t • y t = ∫ t, φ t • sys.C (x t) := by
      intro φ hφ
      have hm := h φ hφ
      rw [hK, synth_eq_of_hasWeakDeriv hxc hxd hφ] at hm
      obtain ⟨⟨v, ξ⟩, hp⟩ := LinearMap.mem_range.1 hm
      rw [ContinuousLinearMap.coe_coe, graphOp_apply, GraphSpace.mk_inj] at hp
      obtain ⟨rfl, rfl, h3, h4⟩ := hp
      have hφu := (hφ.integrable_smul hui).restrict (s := Ioc 0 T)
      have hφx := (hφ.integrable_smul hxi).restrict (s := Ioc 0 T)
      rw [hφ.integral_smul_eq_setIntegral, hφ.integral_smul_eq_setIntegral,
        hφ.integral_smul_eq_setIntegral, hφ.integral_smul_eq_setIntegral,
        integral_smul_vecField hφu hφx, h3]
      refine ⟨rfl, ?_⟩
      rw [← h4, ← sys.C.integral_comp_comm hφx]
      simp only [map_smul]
    have hvi : Integrable (fun t => sys.vecField (u t) (x t)) (μI T) :=
      ((sys.SV.genExtrap ∘L sys.ιWV).integrable_comp hxi).add
        ((sys.SV.toExtrap ∘L sys.B).integrable_comp hui)
    exact ⟨ae_eq_of_integral_smul_eq hxdi hvi fun φ hφ => (key φ hφ).1,
      ae_eq_of_integral_smul_eq hyi (sys.C.integrable_comp hxi) fun φ hφ => (key φ hφ).2⟩
  tfae_finish

/-- **Trajectories are mild solutions** (`thm:willems-gramian`, last sentence;
`app:willems-gramian` Step 4): under `hyp:H1`, if `u ∈ L²(I; U)`, `x ∈ C(I; W) ∩ H¹(I; V₋₁)` and
`y ∈ L²(I; Y)` satisfy `ẋ = A x + B u` in `L²(I; V₋₁)` and `y = C x`, then `(x, y)` is the mild
solution generated by `(x(0), u)`: `x = x(·; x(0), u)` on `I` and `y = C x(·; x(0), u)` a.e.
Strengthening: only condition (i) is assumed (no record, no informativity). -/
theorem eq_mild_of_trajectory {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T)
    {u : ℝ → U} {x : ℝ → W} {xd : ℝ → sys.SV.Extrap} {y : ℝ → Y}
    (hu : MemLp u 2 (μI T)) (hxc : ContinuousOn x (Icc 0 T))
    (hxd : HasWeakDeriv T (fun t => sys.SV.toExtrap (sys.ιWV (x t))) xd)
    (hdyn : ∀ᵐ t ∂(μI T), xd t = sys.vecField (u t) (x t))
    (hout : ∀ᵐ t ∂(μI T), y t = sys.C (x t)) :
    EqOn x (sys.mildW (x 0) u) (Icc 0 T) ∧ y =ᵐ[μI T] sys.outputW (x 0) u := by
  have hBu : IntegrableOn (fun r => sys.B (u r)) (Ioc 0 T) :=
    sys.B.integrable_comp (hu.integrable one_le_two)
  have hXc : ContinuousOn (fun t => sys.ιWV (x t)) (Icc 0 T) :=
    sys.ιWV.continuous.comp_continuousOn hxc
  have hdyn' : ∀ᵐ s, s ∈ Ioc 0 T → xd s = sys.vecField (u s) (x s) :=
    (ae_restrict_iff' measurableSet_Ioc).1 hdyn
  have hint : ∀ t ∈ Icc 0 T, sys.SV.toExtrap (sys.ιWV (x t)) =
      sys.SV.toExtrap (sys.ιWV (x 0)) +
        ∫ s in (0 : ℝ)..t, (sys.SV.genExtrap (sys.ιWV (x s)) + sys.SV.toExtrap (sys.B (u s))) := by
    intro t ht
    refine (hxd.eq_add_integral t ht).trans ?_
    congr 1
    refine intervalIntegral.integral_congr_ae ?_
    filter_upwards [hdyn'] with s hs hs'
    rw [uIoc_of_le ht.1] at hs'
    exact hs ⟨hs'.1, hs'.2.trans ht.2⟩
  have hweak : sys.SV.IsWeakSol T (sys.ιWV (x 0)) (fun r => sys.B (u r))
      (fun t => sys.ιWV (x t)) :=
    (sys.SV.isWeakSol_iff_extrap hBu).2 ⟨hXc, rfl, hint⟩
  have hx : EqOn x (sys.mildW (x 0) u) (Icc 0 T) := fun t ht =>
    sys.ιWV_injective (by
      rw [hweak.eq_mildSol sys.SV hBu t ht, ιWV_mildW_eq_mildSol hH1 hT hu ht.2])
  refine ⟨hx, ?_⟩
  filter_upwards [hout, ae_restrict_mem measurableSet_Ioc] with t h1 h2
  rw [h1, outputW, hx (Ioc_subset_Icc_self h2)]

/-! ### `rmk:input-state-case` -/

variable (sys)

/-- The **input–state system** of `rmk:input-state-case`: the state is measured in `X`
(`W` replaced by `X`, `ιW = id`, `S_W = S_X`) and the output is not recorded (`C = 0` into
`Y₀`; the remark takes `Y₀ = {0}`).  `thm:willems-gramian` for `sys.inputState Y₀` is the
input–state version: informativity in `U × X`, and the fourth components of `Γ` and `𝒲`
vanish. -/
def inputState (Y₀ : Type*) [NormedAddCommGroup Y₀] [InnerProductSpace ℝ Y₀] :
    System U X X V Y₀ where
  ιW := ContinuousLinearMap.id ℝ X
  ιV := sys.ιV
  ιW_injective := Function.injective_id
  ιV_injective := sys.ιV_injective
  ιW_denseRange := denseRange_id
  ιV_denseRange := sys.ιV_denseRange
  SW := sys.SX
  SX := sys.SX
  SV := sys.SV
  consistentW := sys.SX.consistent_id
  consistentV := sys.consistentV
  B := sys.B
  C := 0

variable {sys}

/-- `rmk:input-state-case`: `hyp:H1` for `sys` (control convolution in `W`) gives `hyp:H1` for
the input–state system (control convolution in `X`), since `W ↪ X` is continuous. -/
theorem H1.inputState {T : ℝ} (h : sys.H1 T) (Y₀ : Type*) [NormedAddCommGroup Y₀]
    [InnerProductSpace ℝ Y₀] : (sys.inputState Y₀).H1 T := by
  obtain ⟨b, hb⟩ := h
  refine ⟨‖sys.ιW‖ * b, fun u => ?_⟩
  obtain ⟨w, hw, hwb⟩ := hb u
  refine ⟨sys.ιW w, hw, ?_⟩
  calc ‖sys.ιW w‖ ≤ ‖sys.ιW‖ * ‖w‖ := sys.ιW.le_opNorm w
    _ ≤ ‖sys.ιW‖ * (b * ‖u‖) := mul_le_mul_of_nonneg_left hwb (norm_nonneg _)
    _ = ‖sys.ιW‖ * b * ‖u‖ := by ring

/-- `rmk:input-state-case`: the mild solution of the input–state system is the mild solution
`x(t; x₀, u) ∈ X` of `sys`, for `u ∈ L²(0, t; U)`. -/
theorem inputState_mildW {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) (Y₀ : Type*)
    [NormedAddCommGroup Y₀] [InnerProductSpace ℝ Y₀] [CompleteSpace Y₀] {t : ℝ} {u : ℝ → U}
    (hu : MemLp u 2 (μI t)) (x₀ : X) :
    (sys.inputState Y₀).mildW x₀ u t = sys.mild x₀ u t := by
  have h : (sys.inputState Y₀).L t u = sys.ιW (sys.L t u) :=
    L_eq_of_ιWV (by
      change sys.ιV (sys.ιW (sys.L t u)) = sys.convV t u
      exact ιWV_L hH1 hT hu)
  change (sys.inputState Y₀).SW.real t x₀ + (sys.inputState Y₀).L t u = _
  rw [h]
  rfl

end System

end DataDrivenControl
