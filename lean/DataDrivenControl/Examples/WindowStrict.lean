module

public import DataDrivenControl.Informativity.Window
public import DataDrivenControl.System.Controllability
public import DataDrivenControl.Analysis.ExpSums

/-!
# Informativity does not imply window informativity

Paper: `ex:window-strictly-stronger`, `eq:window-strictly-stronger-input`, `eq:wss-state`
(`app:window-strictly-stronger`).

## Setting

`U = X = ℓ²(ℕ)`, Mathlib's `lp (fun _ : ℕ => ℝ) 2` (`WindowStrict.ℓ2`), with orthonormal basis
`e n = lp.single 2 n 1`.  **Indexing starts at `0`:** the paper's `eₙ`, `n ≥ 1`, is our
`e (n - 1)`, so the paper's coefficient `2^{-n} sin(n t)` of `eₙ` is our
`2^{-(n+1)} sin((n+1) t)` of `e n`.  `A = 0` (the identity semigroup `idSemigroup`,
`generator_idSemigroup`), `B = id`, `W = V = X` (`System.bounded`; the output is irrelevant and
taken to be `C = 0 : ℓ² → ℝ`), `x̄₀ = 0`.

## Main declarations

* `WindowStrict.input` (`eq:window-strictly-stronger-input`):
  `ū(t) = ∑ₙ 2^{-n} sin(n t) eₙ`; `continuous_input`, `memLp_input`.
* `WindowStrict.mild_input` (`eq:wss-state`): `x̄(t) = ∫₀ᵗ ū = ∑ₙ 2^{-n} n⁻¹ (1 - cos(n t)) eₙ`.
* `WindowStrict.exactlyControllable`: `(A, B)` is exactly controllable in every time `T > 0`.
* `WindowStrict.informative` (`ex:window-strictly-stronger`, first claim): the record
  `(ū, x̄)` is informative on every interval `(0, τ)`, `τ > 0`.
* `WindowStrict.not_windowInformative` (`ex:window-strictly-stronger`, second claim): it is
  window informative for no `T, T' > 0`.

Helpers: coordinates in `ℓ²` (`norm_e`, `smul_e`, `apply_eq_inner_e`, `memℓp_of_abs_le`,
`tsum_smul_e`, `tsum_smul_e_apply`), `input_apply` (`ū(t)ₙ = 2^{-(n+1)} sin((n+1) t)`),
`H1_sys`, `mild_eq_integral` (`x(t; 0, u) = ∫₀ᵗ u`), `hasSum_inner_input`, `hasSum_inner_mild`,
`summable_shift`, `memLp_mild_input`, `exists_orth`.

## Proofs (`app:window-strictly-stronger`)

* Exact controllability: `L_T` of the constant input `T⁻¹ x` is `x`.
* `eq:wss-state`: `x̄(t) = ∫₀ᵗ ū` (`mild_eq_integral`), computed coordinatewise
  (`⟪eₙ, ∫ ū⟫ = ∫ ⟪eₙ, ū⟫`).
* Informativity: an annihilator `(α, β)` gives, a.e. on `(0, τ)`, the trigonometric series
  `c + ∑_{m ≥ 1} (cos (m t) (-2^{-m} m⁻¹ β_m) + sin (m t) 2^{-m} α_m) = 0` with
  `c = ∑ 2^{-m} m⁻¹ β_m` (paper's indexing); its coefficients decay like `2^{-m}`, so
  `trigSeries_coeff_eq_zero` (with `ρ = 3/2`, inside the paper's annulus `1/2 < |q| < 2`) on a set
  accumulating in `(0, τ)` (`accPt_Ioo_inter_of_ae`) gives `α = β = 0`.
* Failure of window informativity: as in the paper, `(g, ξ) = (ψ e₁, 0)` (our `ψ • e 0`) with
  `ψ ≠ 0` orthogonal to `sin` and `cos` on `(0, T)` annihilates every window, since the
  first coordinate of `ū(s + t)` is `½ (cos s sin t + sin s cos t)`.  The paper's "`dim L² = ∞`"
  is made concrete (`exists_orth`): `ψ = ∑ₖ gₖ e^{k t}`, `k = 0, 1, 2`, with `g ≠ 0` in the
  kernel of the moment map `ℝ³ → ℝ²`; `ψ ≠ 0` in `L²` by uniqueness of exponential sums
  (`coeff_eq_zero_of_sum_rexp_eq_zero`).

## Upstream results used

`System.bounded_H1`, `System.mild_zero_left`, `System.ιWV_L`, `System.memLp_mild`,
`memLp_μI_of_continuousOn` (`System/Mild`), `informative_iff` (`Informativity/Informative`),
`windowInformative_iff` (`Informativity/Window`), `trigSeries_coeff_eq_zero`,
`accPt_Ioo_inter_of_ae`, `coeff_eq_zero_of_sum_rexp_eq_zero` (`Analysis/ExpSums`),
`C0Semigroup.generator_apply_eq` (`Semigroup/Generator`); `lp.single`, `lp.hasSum_single` and the
`lp` inner product (Mathlib).
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped InnerProductSpace NNReal

noncomputable section

namespace DataDrivenControl

namespace WindowStrict

/-- `ℓ²(ℕ)`, the state and input space of `ex:window-strictly-stronger` (indexed from `0`). -/
abbrev ℓ2 : Type := lp (fun _ : ℕ => ℝ) 2

/-- The orthonormal basis vector `e n` of `ℓ²(ℕ)` (the paper's `e_{n+1}`). -/
def e (n : ℕ) : ℓ2 := lp.single 2 n (1 : ℝ)

/-- The identity semigroup `S(t) = id`, generated by `A = 0`. -/
def idSemigroup : C0Semigroup ℝ ℓ2 where
  toFun _ := 1
  map_zero' := rfl
  map_add' _ _ := ContinuousLinearMap.ext fun _ => rfl
  continuous_apply' _ := continuous_const

@[simp] theorem idSemigroup_apply (t : ℝ≥0) (x : ℓ2) : idSemigroup t x = x := rfl

/-- `S(t) = id` also at real times. -/
@[simp] theorem idSemigroup_real_apply (t : ℝ) (x : ℓ2) : idSemigroup.real t x = x := rfl

/-- The generator of `idSemigroup` is `A = 0` (with domain `X`). -/
theorem generator_idSemigroup :
    idSemigroup.generator = (0 : ℓ2 →ₗ[ℝ] ℓ2).toPMap ⊤ := by
  have hdq : ∀ (x : ℓ2) (h : ℝ), idSemigroup.diffQuot x h = 0 := fun x h => by
    show h⁻¹ • (idSemigroup.real h x - x) = 0
    rw [idSemigroup_real_apply, sub_self, smul_zero]
  have hlim : ∀ x : ℓ2, Tendsto (idSemigroup.diffQuot x) (𝓝[>] 0) (𝓝 0) := fun x => by
    rw [show idSemigroup.diffQuot x = fun _ => 0 from funext (hdq x)]
    exact tendsto_const_nhds
  have hmem : ∀ x : ℓ2, x ∈ idSemigroup.generator.domain := fun x =>
    idSemigroup.mem_generator_domain_of_tendsto (hlim x)
  refine LinearPMap.ext ?_ fun x hx _ => ?_
  · simp only [LinearMap.toPMap_domain]
    exact eq_top_iff.2 fun x _ => hmem x
  · rw [idSemigroup.generator_apply_eq hx (hlim x)]
    rfl

/-- The system of `ex:window-strictly-stronger`: `A = 0`, `B = id` on `U = X = ℓ²`,
`W = V = X`; the output `C = 0 : ℓ² → ℝ` plays no role. -/
def sys : System ℓ2 ℓ2 ℓ2 ℓ2 ℝ :=
  System.bounded idSemigroup (ContinuousLinearMap.id ℝ ℓ2) 0

/-- The input `ū(t) = ∑_{n ≥ 1} 2^{-n} sin(n t) eₙ` (`eq:window-strictly-stronger-input`), in
our `0`-based indexing `∑ₙ 2^{-(n+1)} sin((n+1) t) e n`. -/
def input (t : ℝ) : ℓ2 :=
  ∑' n : ℕ, ((2 : ℝ)⁻¹ ^ (n + 1) * Real.sin (((n : ℝ) + 1) * t)) • e n

/-! ### Coordinates in `ℓ²` -/

/-- `‖eₙ‖ = 1`. -/
theorem norm_e (n : ℕ) : ‖e n‖ = 1 := by
  rw [e, lp.norm_single (by norm_num), norm_one]

/-- `c eₙ` is the sequence with `n`-th entry `c`. -/
theorem smul_e (c : ℝ) (n : ℕ) : c • e n = lp.single 2 n c := by
  rw [e, ← lp.single_smul, smul_eq_mul, mul_one]

/-- The `i`-th coordinate is `⟪eᵢ, f⟫`. -/
theorem apply_eq_inner_e (f : ℓ2) (i : ℕ) : f i = ⟪e i, f⟫_ℝ := by
  rw [e, lp.inner_single_left]
  simp

/-- `∑ₙ C 2^{-(n+1)}` converges. -/
theorem summable_geom (C : ℝ) : Summable fun n : ℕ => C * (2 : ℝ)⁻¹ ^ (n + 1) := by
  refine Summable.mul_left C ?_
  simp_rw [pow_succ]
  exact (summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_right _

/-- A sequence dominated by `C 2^{-(n+1)}` is in `ℓ²`. -/
theorem memℓp_of_abs_le {c : ℕ → ℝ} {C : ℝ} (h : ∀ n, |c n| ≤ C * (2 : ℝ)⁻¹ ^ (n + 1)) :
    Memℓp c 2 := by
  refine (memℓp_gen (p := 1) ?_).of_exponent_ge (by norm_num)
  simp only [ENNReal.toReal_one, Real.rpow_one, Real.norm_eq_abs]
  exact Summable.of_nonneg_of_le (fun n => abs_nonneg _) h (summable_geom C)

/-- For `c ∈ ℓ²`, `∑ₙ cₙ eₙ = c`. -/
theorem tsum_smul_e {c : ℕ → ℝ} (hc : Memℓp c 2) : ∑' n, c n • e n = ⟨c, hc⟩ := by
  simp_rw [smul_e]
  exact (lp.hasSum_single (by norm_num) (⟨c, hc⟩ : ℓ2)).tsum_eq

/-- For `c ∈ ℓ²`, the `i`-th coordinate of `∑ₙ cₙ eₙ` is `cᵢ`. -/
theorem tsum_smul_e_apply {c : ℕ → ℝ} (hc : Memℓp c 2) (i : ℕ) :
    (∑' n, c n • e n) i = c i := by
  rw [tsum_smul_e hc]

/-- The coefficients of `ū(t)` are in `ℓ²`. -/
theorem memℓp_input_coeff (t : ℝ) :
    Memℓp (fun n : ℕ => (2 : ℝ)⁻¹ ^ (n + 1) * Real.sin (((n : ℝ) + 1) * t)) 2 :=
  memℓp_of_abs_le (C := 1) fun n => by
    rw [abs_mul, abs_of_pos (by positivity), one_mul]
    exact mul_le_of_le_one_right (by positivity) (Real.abs_sin_le_one _)

/-- The coordinates of the input: `ū(t)ₙ = 2^{-(n+1)} sin((n+1) t)`. -/
theorem input_apply (t : ℝ) (i : ℕ) :
    input t i = (2 : ℝ)⁻¹ ^ (i + 1) * Real.sin (((i : ℝ) + 1) * t) :=
  tsum_smul_e_apply (memℓp_input_coeff t) i

/-- The coefficients of `x̄(t)` (`eq:wss-state`) are in `ℓ²`. -/
theorem memℓp_state_coeff (t : ℝ) :
    Memℓp (fun n : ℕ => (2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) *
      (1 - Real.cos (((n : ℝ) + 1) * t))) 2 :=
  memℓp_of_abs_le (C := 2) fun n => by
    have h1 : 1 ≤ (n : ℝ) + 1 := by linarith [n.cast_nonneg (α := ℝ)]
    have h2 : |1 - Real.cos (((n : ℝ) + 1) * t)| ≤ 2 := by
      rw [abs_le]; constructor <;> linarith [Real.neg_one_le_cos (((n : ℝ) + 1) * t),
        Real.cos_le_one (((n : ℝ) + 1) * t)]
    rw [abs_mul, abs_of_pos (by positivity)]
    calc (2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) * |1 - Real.cos (((n : ℝ) + 1) * t)|
        ≤ (2 : ℝ)⁻¹ ^ (n + 1) * 2 := by
          gcongr
          · exact div_le_self (by positivity) h1
      _ = 2 * (2 : ℝ)⁻¹ ^ (n + 1) := mul_comm _ _

/-! ### The input and the state -/

/-- The input is continuous (`app:window-strictly-stronger`: it is bounded and continuous,
`‖ū(t)‖² ≤ 1/3`). -/
theorem continuous_input : Continuous input := by
  refine continuous_tsum (u := fun n => 1 * (2 : ℝ)⁻¹ ^ (n + 1)) (fun n => ?_) (summable_geom 1)
    fun n t => ?_
  · fun_prop
  · rw [norm_smul, norm_e, mul_one, Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity),
      one_mul]
    exact mul_le_of_le_one_right (by positivity) (Real.abs_sin_le_one _)

theorem memLp_input (T : ℝ) : MemLp input 2 (μI T) :=
  memLp_μI_of_continuousOn continuous_input.continuousOn

/-- `hyp:H1` holds for `sys` (bounded `B`, `W = V = X`). -/
theorem H1_sys (T : ℝ) : sys.H1 T :=
  System.bounded_H1 idSemigroup (ContinuousLinearMap.id ℝ ℓ2) 0 T

/-- With `A = 0`, `B = id` and `x₀ = 0`, the mild solution is `x(t; 0, u) = ∫₀ᵗ u`
(`app:window-strictly-stronger`). -/
theorem mild_eq_integral {t : ℝ} {u : ℝ → ℓ2} (hu : MemLp u 2 (μI t)) :
    sys.mild 0 u t = ∫ r in Ioc 0 t, u r := by
  have h := System.ιWV_L (H1_sys 1) one_pos hu
  rw [System.mild_zero_left]
  simpa [sys, System.convV, System.ιWV] using h

/-- The state from `x̄₀ = 0` (`eq:wss-state`):
`x̄(t) = ∫₀ᵗ ū = ∑_{n ≥ 1} 2^{-n} n⁻¹ (1 - cos(n t)) eₙ`, for `t ≥ 0` (`0`-based indexing). -/
theorem mild_input {t : ℝ} (ht : 0 ≤ t) :
    sys.mild 0 input t =
      ∑' n : ℕ, ((2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) *
        (1 - Real.cos (((n : ℝ) + 1) * t))) • e n := by
  rw [mild_eq_integral (memLp_input t), tsum_smul_e (memℓp_state_coeff t)]
  refine lp.ext (funext fun i => ?_)
  show (∫ r in Ioc 0 t, input r) i = (2 : ℝ)⁻¹ ^ (i + 1) / ((i : ℝ) + 1) *
    (1 - Real.cos (((i : ℝ) + 1) * t))
  rw [apply_eq_inner_e, ← integral_inner (continuous_input.integrableOn_Ioc)]
  simp_rw [← apply_eq_inner_e, input_apply]
  rw [← intervalIntegral.integral_of_le ht, intervalIntegral.integral_const_mul,
    intervalIntegral.integral_comp_mul_left (fun r => Real.sin r) (by positivity), integral_sin,
    mul_zero, Real.cos_zero, smul_eq_mul]
  have hne : (i : ℝ) + 1 ≠ 0 := by positivity
  field_simp

/-- `(A, B) = (0, id)` is exactly controllable in every time `T > 0`
(`ex:window-strictly-stronger`; `ℛ_τ(0) = {∫₀^τ u} = X`). -/
theorem exactlyControllable {T : ℝ} (hT : 0 < T) : sys.ExactlyControllable T := by
  refine Set.eq_univ_of_forall fun x => ⟨fun _ => T⁻¹ • x, memLp_const _, ?_⟩
  rw [mild_eq_integral (memLp_const _)]
  simp [integral_const, hT.le, hT.ne']

/-! ### Informativity -/

/-- `|aₙ| ≤ ‖a‖`. -/
theorem abs_apply_le (a : ℓ2) (n : ℕ) : |a n| ≤ ‖a‖ := by
  rw [← Real.norm_eq_abs]
  exact lp.norm_apply_le_norm (by norm_num) a n

/-- `⟪α, ū(t)⟫ = ∑ₙ αₙ 2^{-(n+1)} sin((n+1) t)`. -/
theorem hasSum_inner_input (a : ℓ2) (t : ℝ) :
    HasSum (fun n : ℕ => a n * ((2 : ℝ)⁻¹ ^ (n + 1) * Real.sin (((n : ℝ) + 1) * t)))
      ⟪a, input t⟫_ℝ := by
  have := lp.hasSum_inner (𝕜 := ℝ) a (input t)
  simpa [input_apply, mul_comm] using this

/-- `⟪β, x̄(t)⟫ = ∑ₙ βₙ 2^{-(n+1)} (n+1)⁻¹ (1 - cos((n+1) t))` for `t ≥ 0`. -/
theorem hasSum_inner_mild (b : ℓ2) {t : ℝ} (ht : 0 ≤ t) :
    HasSum (fun n : ℕ => b n * ((2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) *
      (1 - Real.cos (((n : ℝ) + 1) * t)))) ⟪b, sys.mild 0 input t⟫_ℝ := by
  rw [mild_input ht, tsum_smul_e (memℓp_state_coeff t)]
  have := lp.hasSum_inner (𝕜 := ℝ) b ⟨_, memℓp_state_coeff t⟩
  simpa [mul_comm] using this

/-- Coefficients `f (n + 1) = O(2^{-n})` decay geometrically against `ρ = 3/2`. -/
theorem summable_shift {f : ℕ → ℝ} {C : ℝ}
    (h : ∀ n, |f (n + 1)| ≤ C * (2 : ℝ)⁻¹ ^ (n + 1)) :
    Summable fun m => ‖f m‖ * (3 / 2 : ℝ) ^ m := by
  rw [← summable_nat_add_iff 1]
  have hg : Summable fun n : ℕ => C * (3 / 4 : ℝ) ^ (n + 1) := by
    refine Summable.mul_left C ?_
    simp_rw [pow_succ]
    exact (summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_right _
  refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_) hg
  rw [Real.norm_eq_abs]
  calc |f (n + 1)| * (3 / 2 : ℝ) ^ (n + 1)
      ≤ C * (2 : ℝ)⁻¹ ^ (n + 1) * (3 / 2 : ℝ) ^ (n + 1) := by gcongr; exact h n
    _ = C * (3 / 4 : ℝ) ^ (n + 1) := by rw [mul_assoc, ← mul_pow]; norm_num

/-- **The record is informative on every interval** (`ex:window-strictly-stronger`): for every
`τ > 0`, `(ū, x̄)` with `x̄ = x(·; 0, ū)` is informative in `U × X` on `(0, τ)`. -/
theorem informative {τ : ℝ} (hτ : 0 < τ) : Informative τ input (sys.mild 0 input) := by
  rw [informative_iff]
  intro a b hab
  have hcoef : ∀ n : ℕ, (2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) ≤ (2 : ℝ)⁻¹ ^ (n + 1) := fun n =>
    div_le_self (by positivity) (by linarith [n.cast_nonneg (α := ℝ)])
  -- the constant term `c = ∑ 2^{-(n+1)} (n+1)⁻¹ βₙ`
  have hcsum : HasSum (fun n : ℕ => (2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) * b n)
      (∑' n : ℕ, (2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) * b n) := by
    refine (Summable.of_norm_bounded (summable_geom ‖b‖) fun n => ?_).hasSum
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity), mul_comm]
    exact mul_le_mul (abs_apply_le b n) (hcoef n) (by positivity) (norm_nonneg _)
  set c : ℝ := ∑' n : ℕ, (2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) * b n with hc
  -- the cosine and sine coefficients of the annihilation identity
  set A : ℕ → ℝ := fun m => match m with
    | 0 => c
    | n + 1 => -((2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1) * b n) with hA
  set B : ℕ → ℝ := fun m => match m with
    | 0 => 0
    | n + 1 => (2 : ℝ)⁻¹ ^ (n + 1) * a n with hB
  have hAs : Summable fun m => ‖A m‖ * (3 / 2 : ℝ) ^ m := by
    refine summable_shift (C := ‖b‖) fun n => ?_
    simp only [A, abs_neg, abs_mul, mul_comm ‖b‖,
      abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ)⁻¹ ^ (n + 1) / ((n : ℝ) + 1))]
    exact mul_le_mul (hcoef n) (abs_apply_le b n) (abs_nonneg _) (by positivity)
  have hBs : Summable fun m => ‖B m‖ * (3 / 2 : ℝ) ^ m := by
    refine summable_shift (C := ‖a‖) fun n => ?_
    simp only [B, abs_mul, mul_comm ‖a‖,
      abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ)⁻¹ ^ (n + 1))]
    exact mul_le_mul_of_nonneg_left (abs_apply_le a n) (by positivity)
  -- the annihilation identity as a trigonometric series, a.e. on `(0, τ)`
  have hzero : ∀ᵐ t ∂(volume.restrict (Ioo 0 τ)),
      ∑' m : ℕ, (Real.cos (m * t) • A m + Real.sin (m * t) • B m) = 0 := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset Ioo_subset_Ioc_self hab,
      ae_restrict_mem measurableSet_Ioo] with t ht htI
    refine HasSum.tsum_eq ?_
    rw [← hasSum_nat_add_iff' 1]
    have h := ((hasSum_inner_input a t).add (hasSum_inner_mild b htI.1.le)).sub hcsum
    rw [ht] at h
    convert h using 1
    · funext n
      simp only [A, B, smul_eq_mul]
      push_cast
      ring
    · simp [A, B]
  obtain ⟨hA0, hB0⟩ := trigSeries_coeff_eq_zero (E := ℝ) (by norm_num : (1 : ℝ) < 3 / 2) hAs hBs
    (accPt_Ioo_inter_of_ae hzero (t₀ := τ / 2) ⟨by linarith, by linarith⟩) fun t ht => ht.2
  refine ⟨lp.ext (funext fun i => ?_), lp.ext (funext fun i => ?_)⟩
  · have := hB0 (i + 1) (Nat.succ_ne_zero i)
    simp only [B] at this
    simpa using this
  · have := hA0 (i + 1)
    have hne : (i : ℝ) + 1 ≠ 0 := by positivity
    simp only [A] at this
    simpa [hne] using this

/-! ### Window informativity fails -/

/-- The first coordinate of the input (the paper's `e₁`-component): `ū(r)₀ = ½ sin r`. -/
theorem input_apply_zero (r : ℝ) : input r 0 = 2⁻¹ * Real.sin r := by
  rw [input_apply]; simp

/-- The state is square integrable on every window. -/
theorem memLp_mild_input (τ : ℝ) : MemLp (sys.mild 0 input) 2 (μI τ) :=
  System.memLp_mild (H1_sys 1) one_pos (memLp_input τ) 0

/-- A nontrivial combination `ψ = ∑ₖ gₖ e^{k t}` of `1, e^t, e^{2t}` is orthogonal to `sin` and
`cos` on `(0, T]` (the three moment vectors lie in the plane `ℝ × ℝ`).  This is the function
`ψ ∈ L²(0, T) ∖ {0}` of `app:window-strictly-stronger`. -/
theorem exists_orth (T : ℝ) : ∃ g : Fin 3 → ℝ, (∃ k, g k ≠ 0) ∧
    ∫ t in Ioc 0 T, (∑ k, g k * Real.exp ((k : ℕ) * t)) * Real.sin t = 0 ∧
    ∫ t in Ioc 0 T, (∑ k, g k * Real.exp ((k : ℕ) * t)) * Real.cos t = 0 := by
  set v : Fin 3 → ℝ × ℝ := fun k => (∫ t in Ioc 0 T, Real.exp ((k : ℕ) * t) * Real.sin t,
    ∫ t in Ioc 0 T, Real.exp ((k : ℕ) * t) * Real.cos t) with hv
  have hli : ¬ LinearIndependent ℝ v := fun h => by
    have := h.fintype_card_le_finrank
    simp at this
  obtain ⟨g, hg, k, hk⟩ := Fintype.not_linearIndependent_iff.1 hli
  have hint : ∀ (f : ℝ → ℝ), Continuous f → ∀ k : Fin 3,
      Integrable (fun t => g k * (Real.exp ((k : ℕ) * t) * f t)) (volume.restrict (Ioc 0 T)) :=
    fun f hf k => (by fun_prop : Continuous _).integrableOn_Ioc
  refine ⟨g, ⟨k, hk⟩, ?_, ?_⟩
  · have h1 := congrArg Prod.fst hg
    simp only [Prod.fst_sum, Prod.smul_fst, v, smul_eq_mul, Prod.fst_zero] at h1
    simp_rw [Finset.sum_mul, mul_assoc]
    rw [integral_finsetSum _ fun k _ => hint _ Real.continuous_sin k]
    simp_rw [integral_const_mul]
    exact h1
  · have h1 := congrArg Prod.snd hg
    simp only [Prod.snd_sum, Prod.smul_snd, v, smul_eq_mul, Prod.snd_zero] at h1
    simp_rw [Finset.sum_mul, mul_assoc]
    rw [integral_finsetSum _ fun k _ => hint _ Real.continuous_cos k]
    simp_rw [integral_const_mul]
    exact h1

/-- **The record is window informative for no `T, T' > 0`** (`ex:window-strictly-stronger`). -/
theorem not_windowInformative {T T' : ℝ} (hT : 0 < T) (hT' : 0 < T') :
    ¬ WindowInformative T T' input (sys.mild 0 input) := by
  -- the argument works for every `T'`
  have _ := hT'
  rw [windowInformative_iff (memLp_input _) (memLp_mild_input _)]
  obtain ⟨g, ⟨k, hk⟩, hsin, hcos⟩ := exists_orth T
  set ψ : ℝ → ℝ := fun t => ∑ k, g k * Real.exp ((k : ℕ) * t) with hψ
  have hψc : Continuous ψ := by fun_prop
  have hG : MemLp (fun t => ψ t • e 0) 2 (μI T) :=
    memLp_μI_of_continuousOn (hψc.smul continuous_const).continuousOn
  intro h
  -- `(g, ξ) = (ψ e₀, 0)` annihilates every window, so it is `0`
  have h0 := h (WithLp.toLp 2 (hG.toLp _, 0)) (Eventually.of_forall fun s => ?_)
  · -- then `ψ = 0` a.e. on `(0, T)`, so every coefficient `gₖ` vanishes
    have hG0 : hG.toLp _ = 0 := by simpa using h0
    have hae : ∀ᵐ t ∂(volume.restrict (Ioo 0 T)), ∑ k : Fin 3,
        Real.exp (((k : ℕ) : ℝ) * t) • g k = 0 := by
      have h1 := (Lp.eq_zero_iff_ae_eq_zero.1 hG0)
      have h2 : (fun t => ψ t • e 0) =ᵐ[μI T] 0 := hG.coeFn_toLp.symm.trans h1
      filter_upwards [ae_restrict_of_ae_restrict_of_subset Ioo_subset_Ioc_self h2] with t ht
      have he : e 0 ≠ 0 := by
        intro he; have := norm_e 0; rw [he, norm_zero] at this; exact zero_ne_one this
      have : ψ t = 0 := by simpa [he] using ht
      simpa [hψ, smul_eq_mul, mul_comm] using this
    have := coeff_eq_zero_of_sum_rexp_eq_zero (E := ℝ) (μ := fun k : Fin 3 => ((k : ℕ) : ℝ))
      (fun i j hij => Fin.val_injective (Nat.cast_injective (R := ℝ) hij))
      (accPt_Ioo_inter_of_ae hae (t₀ := T / 2) ⟨by linarith, by linarith⟩) (fun t ht => ht.2) k
    exact hk this
  · -- the annihilation identity: `∫₀ᵀ ψ(t) ½ sin(s + t) dt = 0`
    simp only [WithLp.toLp_fst, WithLp.toLp_snd, inner_zero_left, add_zero]
    have hcongr : (fun t => ⟪hG.toLp _ t, input (s + t)⟫_ℝ) =ᵐ[volume.restrict (Ioc 0 T)]
        fun t => (2⁻¹ * Real.cos s) * (ψ t * Real.sin t) +
          (2⁻¹ * Real.sin s) * (ψ t * Real.cos t) := by
      filter_upwards [hG.coeFn_toLp] with t ht
      rw [ht, real_inner_smul_left, ← apply_eq_inner_e, input_apply_zero, Real.sin_add]
      ring
    rw [integral_congr_ae hcongr, integral_add, integral_const_mul, integral_const_mul,
      hsin, hcos]
    · ring
    · exact (by fun_prop : Continuous _).integrableOn_Ioc
    · exact (by fun_prop : Continuous _).integrableOn_Ioc

end WindowStrict

end DataDrivenControl
