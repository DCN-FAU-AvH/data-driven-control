module

public import DataDrivenControl.Examples.Delay.Regularity
public import DataDrivenControl.Semigroup.Generator

/-!
# The delay semigroup and its generator

The state of the delay equation of `ex:intro-delay` is `(x(t) - M x_t, x_t)` in
`X = E × L²(-h, 0; E)` (`State h E`, history on `(0, h]`).  Following Burns, Herdman and
Stech (*Linear functional differential equations as semigroups on product spaces*, SIAM J. Math.
Anal. 14 (1983) 98–116), the solution operators

`S(t) (r, ψ) = (ρ(t), x_t)`,  `ρ(t) = r + ∫₀ᵗ L x_s ds = x(t) - M x_t`,

form a C₀-semigroup on `X`, where `x` solves the delay equation with `x(0) - M x_0 = r` and
history `ψ` (`Equation.stateAt`, `Equation.fstAt`, `Equation.orbit`, `Equation.trajOf`).  For
`L`, `M` given by measures, with `M` without atom at `0`, the construction follows O. J. Staffans
(*Semigroups generated by a neutral functional differential equation*, SIAM J. Math. Anal. 17
(1986) 46–57, Thm 2.3 with the future forcing set to `0`): the first state component is
`z = x - M x_t` rather than a point value of the `L²` history.

## Main results

* Linearity `stateAt_add`, `stateAt_smul`; the bound `norm_stateAt_le`
  (from `Equation.norm_solL_le`); continuity `continuousOn_stateAt` (continuity of `ρ` and of
  translation in `L²`); the semigroup law `stateAt_stateAt` (time shift and uniqueness).
* `Equation.semigroup : C0Semigroup ℝ (State h E)`, `semigroup_apply`, `semigroup_real_apply`.
* **The generator** (`mem_generator_domain_iff`, `generator_apply`):
  `D(A) = {(g(h) - M g, g) : g ∈ H¹(0, h; E)}` and `A (g(h) - M g, g) = (L g, g')`.  The easy
  inclusion (`tendsto_diffQuot_of_hasWeakDeriv`) uses the regularity
  `Equation.IsSolOn.exists_hasWeakDeriv` and the `L²` convergence of difference quotients of `H¹`
  signals (`tendsto_diffQuot_window`); the hard inclusion
  (`exists_hasWeakDeriv_of_mem_generator_domain`) gets `g ∈ H¹` from the `L²` difference
  quotients of the history (`exists_ae_eq_of_tendsto_diffQuot_window`), the same at a later time
  gives an `H¹` representative of the trajectory just after `0`, and stitching the two gives an
  `H¹` (hence continuous) representative `Z` of the trajectory on `[0, h + s]`.  The endpoint
  relation `r = g(h) - M g` follows by passing to `t → 0` in `Z(h + t) = M Z_t + ρ(t)`, where
  `t ↦ M Z_t` is continuous for every finite delay measure.  `generator_apply` needs only
  `v ∈ D(A)` and `v₂ = g`.
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped NNReal ENNReal InnerProductSpace

noncomputable section

set_option linter.unusedSectionVars false

namespace DataDrivenControl

namespace Delay

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- The **state space** `X = E × L²(-h, 0; E)` of the delay equation (`ex:intro-delay`), with the
history on `(0, h]` (`ψ(s) = φ(s - h)`) and the Hilbert product norm. -/
abbrev State (h : ℝ) (E : Type*) [NormedAddCommGroup E] : Type _ := WithLp 2 (E × L2 E h)

/-- A state is determined by its components. -/
theorem state_ext {h : ℝ} {v w : State h E} (h1 : v.fst = w.fst) (h2 : v.snd = w.snd) : v = w := by
  rw [WithLp.ext_iff]
  exact Prod.ext h1 h2

/-- `‖(a, b)‖ ≤ ‖a‖ + ‖b‖` in `WithLp 2 (E × F)`. -/
theorem norm_toLp_le {F : Type*} [NormedAddCommGroup F] (a : E) (b : F) :
    ‖WithLp.toLp 2 (a, b)‖ ≤ ‖a‖ + ‖b‖ := by
  rw [WithLp.prod_norm_eq_of_L2]
  simp only [WithLp.toLp_fst, WithLp.toLp_snd]
  rw [← Real.sqrt_sq (add_nonneg (norm_nonneg a) (norm_nonneg b))]
  exact Real.sqrt_le_sqrt (by nlinarith [norm_nonneg a, norm_nonneg b])

namespace Equation

variable {h : ℝ} (d : Equation h E)

/-- The zero forcing is integrable. -/
theorem integrableOn_zero_forcing (τ : ℝ) : IntegrableOn (0 : ℝ → E) (Ioc 0 τ) :=
  integrableOn_zero

/-- The free solution `t ↦ x(t)` from the state `v = (r, ψ)`. -/
def orbit (v : State h E) : ℝ → E := d.sol v.fst (⇑v.snd) 0

/-- The trajectory (in shifted time) of the state `v`. -/
def trajOf (v : State h E) : ℝ → E := traj h (⇑v.snd) (d.orbit v)

/-- The first state component `ρ(t) = r + ∫₀ᵗ L x_s ds = x(t) - M x_t`. -/
def fstAt (v : State h E) (t : ℝ) : E := d.prim v.fst (⇑v.snd) 0 (d.orbit v) t

/-- The state `(x(t) - M x_t, x_t)` reached at time `t` from `v`. -/
def stateAt (v : State h E) (t : ℝ) : State h E :=
  WithLp.toLp 2 (d.fstAt v t, window h (d.trajOf v) t)

/-- The first component of `S(t) v` is `ρ(t)`. -/
@[simp] theorem stateAt_fst (v : State h E) (t : ℝ) : (d.stateAt v t).fst = d.fstAt v t := rfl

/-- The second component of `S(t) v` is the history `x_t`. -/
@[simp] theorem stateAt_snd (v : State h E) (t : ℝ) :
    (d.stateAt v t).snd = window h (d.trajOf v) t := rfl

/-- The free orbit solves the delay equation. -/
theorem isSolOn_orbit (v : State h E) {τ : ℝ} (hτ : 0 ≤ τ) :
    d.IsSolOn τ v.fst (⇑v.snd) 0 (d.orbit v) :=
  d.isSolOn_sol (Lp.memLp v.snd) integrableOn_zero_forcing hτ

/-- The trajectory of a state is square integrable on `(0, h + τ]`. -/
theorem memLp_trajOf (v : State h E) {τ : ℝ} (hτ : 0 ≤ τ) :
    MemLp (d.trajOf v) 2 (μI (h + τ)) :=
  memLp_traj_of_memLp d.h_pos.le hτ (Lp.memLp v.snd) (d.isSolOn_orbit v hτ).1

/-- `ρ(t) = r + ∫₀ᵗ L x_s ds`. -/
theorem fstAt_eq (v : State h E) (t : ℝ) :
    d.fstAt v t = v.fst + ∫ s in (0 : ℝ)..t, d.L.eval (d.trajOf v) s := by
  simp [fstAt, prim, trajOf]

/-- `ρ(0) = r`. -/
@[simp] theorem fstAt_zero (v : State h E) : d.fstAt v 0 = v.fst := by simp [fstAt]

/-- `ρ` is continuous. -/
theorem continuousOn_fstAt (v : State h E) (τ : ℝ) : ContinuousOn (d.fstAt v) (Icc 0 τ) := by
  rcases lt_or_ge τ 0 with hτ | hτ
  · rw [Icc_eq_empty (not_le.2 hτ)]
    exact continuousOn_empty _
  exact d.continuousOn_prim hτ (Lp.memLp v.snd) (d.isSolOn_orbit v hτ).1
    (integrableOn_zero_forcing τ)

/-- `t ↦ (ρ(t), x_t)` is continuous in `X` (continuity of translation in `L²`). -/
theorem continuousOn_stateAt (v : State h E) (τ : ℝ) : ContinuousOn (d.stateAt v) (Icc 0 τ) := by
  rcases lt_or_ge τ 0 with hτ | hτ
  · rw [Icc_eq_empty (not_le.2 hτ)]
    exact continuousOn_empty _
  exact (WithLp.prod_continuous_toLp (p := 2) (α := E) (β := L2 E h)).comp_continuousOn
    ((d.continuousOn_fstAt v τ).prodMk (continuousOn_window (d.memLp_trajOf v hτ)))

/-- `S(0) v = v`. -/
theorem stateAt_zero (v : State h E) : d.stateAt v 0 = v := by
  refine state_ext ?_ ?_
  · simp
  · rw [stateAt_snd, ← window_coeFn_zero v.snd]
    exact window_congr (ae_restrict_of_forall_mem measurableSet_Ioc fun σ hσ =>
      traj_of_le _ _ (by simpa using hσ.2))

/-! ### Linearity -/

/-- The free solution is additive in the state. -/
theorem orbit_add (v w : State h E) {τ : ℝ} (hτ : 0 ≤ τ) :
    d.orbit (v + w) =ᵐ[μI τ] d.orbit v + d.orbit w := by
  have hs := (d.isSolOn_orbit v hτ).add hτ (Lp.memLp v.snd) (Lp.memLp w.snd)
    (integrableOn_zero_forcing τ) (integrableOn_zero_forcing τ) (d.isSolOn_orbit w hτ)
  rw [add_zero] at hs
  have hs' : d.IsSolOn τ (v + w).fst (⇑(v + w).snd) 0 (d.orbit v + d.orbit w) := by
    rw [WithLp.add_fst, WithLp.add_snd]
    exact hs.congr_hist (Lp.coeFn_add v.snd w.snd).symm
  exact (d.isSolOn_orbit (v + w) hτ).ae_eq hτ (Lp.memLp _) (integrableOn_zero_forcing τ) hs'

/-- The free solution is homogeneous in the state. -/
theorem orbit_smul (c : ℝ) (v : State h E) {τ : ℝ} (hτ : 0 ≤ τ) :
    d.orbit (c • v) =ᵐ[μI τ] c • d.orbit v := by
  have hs := (d.isSolOn_orbit v hτ).smul c
  rw [smul_zero] at hs
  have hs' : d.IsSolOn τ (c • v).fst (⇑(c • v).snd) 0 (c • d.orbit v) := by
    rw [WithLp.smul_fst, WithLp.smul_snd]
    exact hs.congr_hist (Lp.coeFn_smul c v.snd).symm
  exact (d.isSolOn_orbit (c • v) hτ).ae_eq hτ (Lp.memLp _) (integrableOn_zero_forcing τ) hs'

/-- The trajectory is additive in the state. -/
theorem trajOf_add (v w : State h E) {τ : ℝ} (hτ : 0 ≤ τ) :
    d.trajOf (v + w) =ᵐ[μI (h + τ)] d.trajOf v + d.trajOf w := by
  rw [trajOf, trajOf, trajOf, ← traj_add]
  refine (traj_ae_congr_right _ (d.orbit_add v w hτ)).trans (traj_ae_congr ?_ _ _)
  rw [WithLp.add_snd]
  exact Lp.coeFn_add _ _

/-- The trajectory is homogeneous in the state. -/
theorem trajOf_smul (c : ℝ) (v : State h E) {τ : ℝ} (hτ : 0 ≤ τ) :
    d.trajOf (c • v) =ᵐ[μI (h + τ)] c • d.trajOf v := by
  rw [trajOf, trajOf, ← traj_smul]
  refine (traj_ae_congr_right _ (d.orbit_smul c v hτ)).trans (traj_ae_congr ?_ _ _)
  rw [WithLp.smul_snd]
  exact Lp.coeFn_smul _ _

/-- `L x_s` along the trajectory is integrable on `[0, t]`. -/
theorem intervalIntegrable_L (v : State h E) {t : ℝ} (ht : 0 ≤ t) :
    IntervalIntegrable (d.L.eval (d.trajOf v)) volume 0 t :=
  intervalIntegrable_of_integrableOn (d.L.integrableOn_eval (d.memLp_trajOf v ht)) ⟨ht, le_rfl⟩

/-- `ρ` is additive in the state. -/
theorem fstAt_add (v w : State h E) {t : ℝ} (ht : 0 ≤ t) :
    d.fstAt (v + w) t = d.fstAt v t + d.fstAt w t := by
  have h1 : d.L.eval (d.trajOf (v + w)) =ᵐ[μI t]
      fun s => d.L.eval (d.trajOf v) s + d.L.eval (d.trajOf w) s := by
    filter_upwards [d.L.ae_eval_eq (d.trajOf_add v w ht),
      d.L.ae_eval_add (d.memLp_trajOf v ht) (d.memLp_trajOf w ht)] with s e1 e2
    rw [e1, e2]
  rw [fstAt_eq, fstAt_eq, fstAt_eq, WithLp.add_fst, intervalIntegral_congr_μI h1 ⟨ht, le_rfl⟩,
    intervalIntegral.integral_add (d.intervalIntegrable_L v ht) (d.intervalIntegrable_L w ht)]
  abel

/-- `ρ` is homogeneous in the state. -/
theorem fstAt_smul (c : ℝ) (v : State h E) {t : ℝ} (ht : 0 ≤ t) :
    d.fstAt (c • v) t = c • d.fstAt v t := by
  have h1 : d.L.eval (d.trajOf (c • v)) =ᵐ[μI t] fun s => c • d.L.eval (d.trajOf v) s := by
    filter_upwards [d.L.ae_eval_eq (d.trajOf_smul c v ht)] with s e1
    rw [e1, d.L.eval_smul]
  rw [fstAt_eq, fstAt_eq, WithLp.smul_fst, intervalIntegral_congr_μI h1 ⟨ht, le_rfl⟩,
    intervalIntegral.integral_smul, smul_add]

/-- `S(t)` is additive. -/
theorem stateAt_add (v w : State h E) {t : ℝ} (ht : 0 ≤ t) :
    d.stateAt (v + w) t = d.stateAt v t + d.stateAt w t := by
  refine state_ext ?_ ?_
  · simp only [stateAt_fst, WithLp.add_fst, d.fstAt_add v w ht]
  · simp only [stateAt_snd, WithLp.add_snd]
    rw [window_congr_ae (d.trajOf_add v w ht) ht (by linarith), window_add_of_memLp
      (memLp_comp_add (d.memLp_trajOf v ht) ht (by linarith))
      (memLp_comp_add (d.memLp_trajOf w ht) ht (by linarith))]

/-- `S(t)` is homogeneous. -/
theorem stateAt_smul (c : ℝ) (v : State h E) {t : ℝ} (ht : 0 ≤ t) :
    d.stateAt (c • v) t = c • d.stateAt v t := by
  refine state_ext ?_ ?_
  · simp only [stateAt_fst, WithLp.smul_fst, d.fstAt_smul c v ht]
  · simp only [stateAt_snd, WithLp.smul_snd]
    rw [window_congr_ae (d.trajOf_smul c v ht) ht (by linarith), window_smul]

/-! ### Bounds -/

/-- The bound `‖(1 - 𝒦)⁻¹‖ c(τ)` of the solution operator on `(0, τ]`. -/
def solBound (τ : ℝ) : ℝ := ‖Ring.inverse (1 - d.opK τ)‖ * d.cforc τ

/-- The bound of the solution operator is nonnegative. -/
theorem solBound_nonneg {τ : ℝ} (hτ : 0 ≤ τ) : 0 ≤ d.solBound τ :=
  mul_nonneg (norm_nonneg (Ring.inverse (1 - d.opK τ)))
    (add_nonneg (add_nonneg (Real.sqrt_nonneg _) (d.M.bound_nonneg τ))
      (mul_nonneg hτ (d.L.bound_nonneg τ)))

/-- `‖x‖_{L²(0, τ)} ≤ 2 ‖(1 - 𝒦)⁻¹‖ c(τ) ‖v‖`. -/
theorem eLpNorm_orbit_le (v : State h E) {τ : ℝ} (hτ : 0 ≤ τ) :
    (eLpNorm (d.orbit v) 2 (μI τ)).toReal ≤ 2 * d.solBound τ * ‖v‖ := by
  have h1 := d.norm_solL_le (r := v.fst) hτ (Lp.memLp v.snd) (integrableOn_zero_forcing τ)
  rw [Lp.norm_def, ← eLpNorm_congr_ae
    (d.sol_ae_eq_solL (Lp.memLp v.snd) integrableOn_zero_forcing hτ)] at h1
  simp only [Pi.zero_apply, norm_zero, integral_zero, add_zero] at h1
  rw [← Lp.norm_def] at h1
  refine (show (eLpNorm (d.orbit v) 2 (μI τ)).toReal ≤ _ from h1).trans ?_
  have h2 := WithLp.norm_fst_le (x := v)
  have h3 := WithLp.norm_snd_le (x := v)
  have h4 := d.solBound_nonneg hτ
  rw [solBound] at h4 ⊢
  nlinarith

/-- `‖x_·‖_{L²(0, h + τ)} ≤ (1 + 2 ‖(1 - 𝒦)⁻¹‖ c(τ)) ‖v‖`. -/
theorem eLpNorm_trajOf_le (v : State h E) {τ : ℝ} (hτ : 0 ≤ τ) :
    (eLpNorm (d.trajOf v) 2 (μI (h + τ))).toReal ≤ (1 + 2 * d.solBound τ) * ‖v‖ := by
  refine (eLpNorm_traj_le d.h_pos.le hτ (Lp.memLp v.snd) (d.isSolOn_orbit v hτ).1).trans ?_
  rw [← Lp.norm_def]
  have := d.eLpNorm_orbit_le v hτ
  have := WithLp.norm_snd_le (x := v)
  linarith

/-- The bound `1 + (√τ bound L τ + 1) (1 + 2 solBound τ)` of the solution operators on
`[0, τ]`. -/
def opBound (τ : ℝ) : ℝ := 1 + (√τ * d.L.bound τ + 1) * (1 + 2 * d.solBound τ)

/-- `‖S(t) v‖ ≤ opBound τ ‖v‖` on `[0, τ]`. -/
theorem norm_stateAt_le (v : State h E) {τ t : ℝ} (ht : t ∈ Icc 0 τ) :
    ‖d.stateAt v t‖ ≤ d.opBound τ * ‖v‖ := by
  have hτ : 0 ≤ τ := ht.1.trans ht.2
  set Z := (eLpNorm (d.trajOf v) 2 (μI (h + τ))).toReal with hZdef
  have hZ := d.eLpNorm_trajOf_le v hτ
  have hz := d.memLp_trajOf v hτ
  have h1 : ‖d.fstAt v t‖ ≤ ‖v.fst‖ + √τ * (d.L.bound τ * Z) := by
    rw [fstAt_eq]
    refine (norm_add_le _ _).trans (add_le_add le_rfl ?_)
    rw [intervalIntegral.integral_of_le ht.1]
    refine (norm_integral_le_integral_norm _).trans ?_
    refine (setIntegral_mono_set (d.L.integrableOn_eval hz).norm
      (ae_of_all _ fun _ => norm_nonneg _) (Ioc_subset_Ioc_right ht.2).eventuallyLE).trans ?_
    exact (integral_norm_le_sqrt_mul hτ (d.L.memLp_eval hz)).trans
      (mul_le_mul_of_nonneg_left (d.L.eLpNorm_eval_le hτ hz) (Real.sqrt_nonneg _))
  have h2 : ‖window h (d.trajOf v) t‖ ≤ Z := norm_window_le hz ht.1 (by linarith [ht.2])
  refine (norm_toLp_le _ _).trans ?_
  have h3 := WithLp.norm_fst_le (x := v)
  have hL := d.L.bound_nonneg τ
  have hsB := d.solBound_nonneg hτ
  have hv := norm_nonneg v
  have hsq := Real.sqrt_nonneg τ
  calc ‖d.fstAt v t‖ + ‖window h (d.trajOf v) t‖
      ≤ ‖v‖ + (√τ * d.L.bound τ + 1) * Z := by nlinarith
    _ ≤ ‖v‖ + (√τ * d.L.bound τ + 1) * ((1 + 2 * d.solBound τ) * ‖v‖) := by gcongr
    _ = d.opBound τ * ‖v‖ := by unfold opBound; ring

/-! ### The semigroup law -/

/-- Restarting at time `s`: `x(t; S(s) v) = x(s + t; v)` (a.e.). -/
theorem orbit_stateAt (v : State h E) {s τ : ℝ} (hs : 0 ≤ s) (hτ : 0 ≤ τ) :
    d.orbit (d.stateAt v s) =ᵐ[μI τ] fun t => d.orbit v (s + t) := by
  have hsh := (d.isSolOn_orbit v (τ := s + τ) (by linarith)).shift hs (Lp.memLp v.snd)
    (integrableOn_zero_forcing _)
  have hsh' : d.IsSolOn τ (d.stateAt v s).fst (⇑(d.stateAt v s).snd) 0
      (fun t => d.orbit v (s + t)) :=
    hsh.congr_hist (coeFn_window (memLp_comp_add (d.memLp_trajOf v hs) hs (by linarith))).symm
  exact (d.isSolOn_orbit _ hτ).ae_eq hτ (Lp.memLp _) (integrableOn_zero_forcing τ) hsh'

/-- Restarting at time `s` translates the trajectory (a.e.). -/
theorem trajOf_stateAt (v : State h E) {s T : ℝ} (hs : 0 ≤ s) (hT : 0 ≤ T) :
    d.trajOf (d.stateAt v s) =ᵐ[μI (h + T)] fun σ => d.trajOf v (s + σ) := by
  have h2 := traj_shift (h := h) hs (⇑v.snd) (d.orbit v)
  refine (traj_ae_congr_right _ (d.orbit_stateAt v hs hT)).trans ?_
  refine (traj_ae_congr (coeFn_window (memLp_comp_add (d.memLp_trajOf v hs) hs (by linarith)))
    _ _).trans ?_
  exact EventuallyEq.of_eq h2

/-- Restarting at time `s`: `ρ(t; S(s) v) = ρ(s + t; v)`. -/
theorem fstAt_stateAt (v : State h E) {s t : ℝ} (hs : 0 ≤ s) (ht : 0 ≤ t) :
    d.fstAt (d.stateAt v s) t = d.fstAt v (s + t) := by
  rw [fstAt, stateAt_fst, stateAt_snd, d.prim_congr (d.orbit_stateAt v hs ht) ⟨ht, le_rfl⟩,
    d.prim_congr_hist (coeFn_window (memLp_comp_add (d.memLp_trajOf v hs) hs (by linarith))) ht]
  exact d.prim_shift hs ht (Lp.memLp v.snd) (d.isSolOn_orbit v (by linarith)).1
    (integrableOn_zero_forcing _)

/-- **The semigroup law** `S(t) S(s) v = S(s + t) v`. -/
theorem stateAt_stateAt (v : State h E) {s t : ℝ} (hs : 0 ≤ s) (ht : 0 ≤ t) :
    d.stateAt (d.stateAt v s) t = d.stateAt v (s + t) := by
  refine state_ext (d.fstAt_stateAt v hs ht) ?_
  rw [stateAt_snd, stateAt_snd, window_congr_ae (d.trajOf_stateAt v hs ht) ht (by linarith)]
  exact window_eq_of_ae (ae_of_all _ fun σ => by simp only [add_assoc])

/-! ### The C₀-semigroup -/

/-- The solution operator `S(t)` as a linear map. -/
def opₗ (t : ℝ≥0) : State h E →ₗ[ℝ] State h E where
  toFun v := d.stateAt v t
  map_add' v w := d.stateAt_add v w t.2
  map_smul' c v := d.stateAt_smul c v t.2

/-- The solution operator `S(t) (r, ψ) = (ρ(t), x_t)`. -/
def op (t : ℝ≥0) : State h E →L[ℝ] State h E :=
  (d.opₗ t).mkContinuous (d.opBound t) fun v => d.norm_stateAt_le v ⟨t.2, le_rfl⟩

/-- `op t v = S(t) v`. -/
theorem op_apply (t : ℝ≥0) (v : State h E) : d.op t v = d.stateAt v t := rfl

/-- `S(0) = 1`. -/
theorem op_zero : d.op 0 = 1 := by
  ext1 v
  rw [op_apply, NNReal.coe_zero, stateAt_zero]
  rfl

/-- The semigroup law `S(s + t) = S(s) S(t)`. -/
theorem op_add (s t : ℝ≥0) : d.op (s + t) = (d.op s).comp (d.op t) := by
  ext1 v
  rw [ContinuousLinearMap.comp_apply, op_apply, op_apply, op_apply, NNReal.coe_add,
    d.stateAt_stateAt v (NNReal.coe_nonneg t) (NNReal.coe_nonneg s), add_comm]

/-- Strong continuity at `0`. -/
theorem tendsto_op (v : State h E) : Tendsto (fun t => d.op t v) (𝓝 0) (𝓝 v) := by
  have hc : ContinuousWithinAt (d.stateAt v) (Icc 0 1) 0 :=
    d.continuousOn_stateAt v 1 0 ⟨le_rfl, zero_le_one⟩
  have h1 : Tendsto (fun t : ℝ≥0 => (t : ℝ)) (𝓝 0) (𝓝[Icc 0 1] 0) := by
    refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
    · simpa using NNReal.continuous_coe.tendsto 0
    · filter_upwards [Iio_mem_nhds (zero_lt_one : (0 : ℝ≥0) < 1)] with t ht
      exact ⟨t.2, le_of_lt (by exact_mod_cast ht)⟩
  have := hc.tendsto.comp h1
  rwa [d.stateAt_zero] at this

/-- **The delay semigroup** `S(t) (r, ψ) = (x(t) - M x_t, x_t)` on
`X = E × L²(-h, 0; E)` (`ex:intro-delay`; Burns–Herdman–Stech 1983, Staffans 1986): semigroup law
`stateAt_stateAt`, strong continuity from the continuity of `ρ` and of translation in `L²`. -/
def semigroup : C0Semigroup ℝ (State h E) :=
  C0Semigroup.ofTendsto d.op d.op_zero d.op_add d.tendsto_op

/-- `S(t) v = (ρ(t), x_t)`. -/
theorem semigroup_apply (t : ℝ≥0) (v : State h E) : d.semigroup t v = d.stateAt v t := rfl

/-- `S(t) v = (ρ(t), x_t)` at real times `t ≥ 0`. -/
theorem semigroup_real_apply {t : ℝ} (ht : 0 ≤ t) (v : State h E) :
    d.semigroup.real t v = d.stateAt v t := by
  rw [C0Semigroup.real, semigroup_apply, Real.coe_toNNReal _ ht]

/-! ### The generator -/

variable {g g' : ℝ → E}

/-- **The generator on `H¹` histories** (easy inclusion): for `g ∈ H¹`, the difference quotients
of `(g(h) - M g, g)` converge to `(L g, g')` (regularity `IsSolOn.exists_hasWeakDeriv` and
`tendsto_diffQuot_window`). -/
theorem tendsto_diffQuot_of_hasWeakDeriv (hg : HasWeakDeriv h g g') :
    Tendsto (d.semigroup.diffQuot (WithLp.toLp 2 (g h - d.M.eval g 0, hg.memLp.toLp g)))
      (𝓝[>] 0) (𝓝 (WithLp.toLp 2 (d.L.eval g 0, hg.memLp_deriv.toLp g'))) := by
  have hcoe : ⇑(hg.memLp.toLp g) =ᵐ[μI h] g := hg.memLp.coeFn_toLp
  have hso : d.IsSolOn 1 (g h - d.M.eval g 0) g 0
      (d.orbit (WithLp.toLp 2 (g h - d.M.eval g 0, hg.memLp.toLp g))) :=
    (d.isSolOn_orbit _ zero_le_one).congr_hist hcoe
  obtain ⟨X, y, hxX, -, -, hZ⟩ := hso.exists_hasWeakDeriv zero_le_one hg MemLp.zero
  have htr : d.trajOf (WithLp.toLp 2 (g h - d.M.eval g 0, hg.memLp.toLp g)) =ᵐ[μI (h + 1)]
      traj h g X :=
    (traj_ae_congr hcoe _ _).trans (traj_ae_congr_right g hxX)
  have hfst : ∀ t ∈ Icc (0 : ℝ) 1,
      d.fstAt (WithLp.toLp 2 (g h - d.M.eval g 0, hg.memLp.toLp g)) t =
        (g h - d.M.eval g 0) + ∫ s in (0 : ℝ)..t, d.L.eval (traj h g X) s := by
    intro t ht
    rw [fstAt_eq, intervalIntegral_congr_μI (d.L.ae_eval_eq htr) ht, WithLp.toLp_fst]
  have hA : Tendsto (fun t : ℝ => t⁻¹ • (d.fstAt (WithLp.toLp 2 (g h - d.M.eval g 0,
      hg.memLp.toLp g)) t - (g h - d.M.eval g 0))) (𝓝[>] 0) (𝓝 (d.L.eval g 0)) := by
    have := tendsto_inv_smul_intervalIntegral zero_lt_one
      (d.L.continuousOn_eval (τ := 1) hZ.continuousOn)
    rw [d.L.eval_traj_zero] at this
    refine this.congr' ?_
    filter_upwards [mem_of_superset (Ioo_mem_nhdsGT zero_lt_one) Ioo_subset_Ioc_self] with t ht
    rw [hfst t (Ioc_subset_Icc_self ht), add_sub_cancel_left]
  have hB := tendsto_diffQuot_window hZ d.h_pos.le (by linarith : h < h + 1)
  have hw0' : window h (traj h g' y) 0 = hg.memLp_deriv.toLp g' := by
    rw [← window_zero_eq_toLp hg.memLp_deriv]
    exact window_congr (ae_restrict_of_forall_mem measurableSet_Ioc fun σ hσ =>
      traj_of_le _ _ (by linarith [hσ.2]))
  have hw0 : window h (traj h g X) 0 = hg.memLp.toLp g := by
    rw [← window_zero_eq_toLp hg.memLp]
    exact window_congr (ae_restrict_of_forall_mem measurableSet_Ioc fun σ hσ =>
      traj_of_le _ _ (by linarith [hσ.2]))
  rw [hw0'] at hB
  have hlim := ((WithLp.prod_continuous_toLp (p := 2) (α := E) (β := L2 E h)).tendsto _).comp
    (hA.prodMk_nhds hB)
  refine hlim.congr' ?_
  filter_upwards [mem_of_superset (Ioo_mem_nhdsGT zero_lt_one) Ioo_subset_Ioc_self] with t ht
  rw [C0Semigroup.diffQuot, d.semigroup_real_apply ht.1.le]
  refine state_ext ?_ ?_
  · simp only [Function.comp_apply, WithLp.toLp_fst, WithLp.smul_fst, WithLp.sub_fst,
      stateAt_fst]
  · have hwt : window h (d.trajOf (WithLp.toLp 2 (g h - d.M.eval g 0, hg.memLp.toLp g))) t =
        window h (traj h g X) t := window_congr_ae htr ht.1.le (by linarith [ht.2])
    simp only [Function.comp_apply, WithLp.toLp_snd, WithLp.smul_snd, WithLp.sub_snd,
      stateAt_snd, hwt, hw0]

/-- `(g(h) - M g, g) ∈ D(A)` for every `H¹` history `g` (`ex:intro-delay`). -/
theorem mem_generator_domain_of_hasWeakDeriv (hg : HasWeakDeriv h g g') :
    WithLp.toLp 2 (g h - d.M.eval g 0, hg.memLp.toLp g) ∈ d.semigroup.generator.domain :=
  d.semigroup.mem_generator_domain_of_tendsto (d.tendsto_diffQuot_of_hasWeakDeriv hg)

/-- A state with an `H¹` representative of its history and the compatible first component. -/
theorem eq_toLp_of_hasWeakDeriv {v : State h E} (hg : HasWeakDeriv h g g')
    (h1 : v.fst = g h - d.M.eval g 0) (h2 : ⇑v.snd =ᵐ[μI h] g) :
    v = WithLp.toLp 2 (g h - d.M.eval g 0, hg.memLp.toLp g) :=
  state_ext h1 (Lp.ext (h2.trans hg.memLp.coeFn_toLp.symm))

/-- **The hard inclusion** `D(A) ⊆ {(g(h) - M g, g) : g ∈ H¹}`.  The `L²` convergence of the
difference quotients of the history gives `g ∈ H¹`, and the same at time `s = h / 2` gives an `H¹`
representative `q` of the trajectory on `[s, s + h]`.  Stitched at `h`, `g` and `q` give an `H¹`
representative `Z` of the trajectory on `[0, h + s]`, so `Z(h + t) = M Z_t + ρ(t)` a.e. on
`(0, s]` with both sides continuous, and `t → 0` gives `g(h) = M g + r`. -/
theorem exists_hasWeakDeriv_of_mem_generator_domain {v : State h E}
    (hv : v ∈ d.semigroup.generator.domain) :
    ∃ g g' : ℝ → E, HasWeakDeriv h g g' ∧ v.fst = g h - d.M.eval g 0 ∧ ⇑v.snd =ᵐ[μI h] g := by
  set z := d.trajOf v with hzdef
  set x := d.orbit v with hxdef
  have hsnd : ∀ (w : State h E) (hw : w ∈ d.semigroup.generator.domain),
      Tendsto (fun t : ℝ => t⁻¹ • ((d.stateAt w t).snd - w.snd)) (𝓝[>] 0)
        (𝓝 (d.semigroup.generator ⟨w, hw⟩).snd) := by
    intro w hw
    have := ((WithLp.continuous_snd (p := 2) (α := E) (β := L2 E h)).tendsto _).comp
      (d.semigroup.tendsto_generator ⟨w, hw⟩)
    refine this.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with t (ht : 0 < t)
    simp only [Function.comp_apply, C0Semigroup.diffQuot, d.semigroup_real_apply ht.le,
      WithLp.smul_snd, WithLp.sub_snd]
  -- Step 1: the history has a weak derivative.
  set G := (d.semigroup.generator ⟨v, hv⟩).snd with hGdef
  have hv0 : window h z 0 = v.snd := by rw [hzdef, ← stateAt_snd, d.stateAt_zero]
  have h1 : Tendsto (fun t : ℝ => t⁻¹ • (window h z t - window h z 0)) (𝓝[>] 0) (𝓝 G) := by
    have := hsnd v hv
    simp only [stateAt_snd] at this
    rwa [← hv0] at this
  obtain ⟨c, hc⟩ := exists_ae_eq_of_tendsto_diffQuot_window d.h_pos zero_lt_one
    (d.memLp_trajOf v zero_le_one) h1
  set gh : ℝ → E := fun σ => c + ∫ u in (0 : ℝ)..σ, G u with hghdef
  have hgh : HasWeakDeriv h gh ⇑G := ⟨Lp.memLp G, fun σ _ => by simp [hghdef]⟩
  have hsndg : ⇑v.snd =ᵐ[μI h] gh := by
    rw [ae_restrict_iff' measurableSet_Ioc] at hc
    rw [EventuallyEq, ae_restrict_iff' measurableSet_Ioc]
    filter_upwards [hc] with σ hσ hσI
    show _ = c + ∫ u in (0 : ℝ)..σ, G u
    rw [← hσ hσI]
    exact (traj_of_le _ _ hσI.2).symm
  refine ⟨gh, G, hgh, ?_, hsndg⟩
  -- Step 2: an `H¹` representative beyond `h`, from the window at time `s = h / 2`.
  set s := h / 2 with hsdef
  have hs0 : 0 < s := half_pos d.h_pos
  have hsh : s < h := half_lt_self d.h_pos
  have hvs : d.stateAt v s ∈ d.semigroup.generator.domain := by
    have := d.semigroup.mem_generator_domain_apply hv s.toNNReal
    rwa [semigroup_apply, Real.coe_toNNReal _ hs0.le] at this
  set G₂ := (d.semigroup.generator ⟨d.stateAt v s, hvs⟩).snd with hG₂def
  have h2 : Tendsto (fun t : ℝ => t⁻¹ • (window h (fun σ => z (s + σ)) t -
      window h (fun σ => z (s + σ)) 0)) (𝓝[>] 0) (𝓝 G₂) := by
    refine (hsnd _ hvs).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with t (ht : 0 < t)
    rw [d.stateAt_stateAt v hs0.le ht.le, stateAt_snd, stateAt_snd, window_comp_add,
      window_comp_add, add_zero]
  have hzs : MemLp (fun σ => z (s + σ)) 2 (μI (h + 1)) :=
    memLp_comp_add (d.memLp_trajOf v (τ := s + 1) (by linarith)) hs0.le (by linarith)
  obtain ⟨c₂, hc₂⟩ := exists_ae_eq_of_tendsto_diffQuot_window d.h_pos zero_lt_one hzs h2
  set q : ℝ → E := fun σ => c₂ + ∫ u in (0 : ℝ)..σ, G₂ u with hqdef
  have hq : HasWeakDeriv h q ⇑G₂ := ⟨Lp.memLp G₂, fun σ _ => by simp [hqdef]⟩
  have hghc : ContinuousOn gh (Icc 0 h) := hgh.continuousOn
  have e1 : EqOn q (fun σ => gh (s + σ)) (Icc 0 (h - s)) := by
    refine eqOn_Icc_of_ae (by linarith) (hq.continuousOn.mono (Icc_subset_Icc_right (by linarith)))
      (hghc.comp (f := fun σ => s + σ) (by fun_prop)
        fun σ hσ => ⟨by linarith [hσ.1], by linarith [hσ.2]⟩) ?_
    have a1 : ∀ᵐ σ ∂(μI (h - s)), z (s + σ) = q σ :=
      ae_restrict_of_ae_restrict_of_subset (Ioc_subset_Ioc_right (by linarith)) hc₂
    have a2 : ∀ᵐ σ ∂(μI (h - s)), (⇑v.snd) (s + σ) = gh (s + σ) :=
      ae_comp_add hsndg hs0.le (by linarith)
    filter_upwards [a1, a2, ae_restrict_mem measurableSet_Ioc] with σ e₁ e₂ e₃
    rw [← e₁, ← e₂]
    exact traj_of_le _ _ (by linarith [e₃.2])
  -- Step 3: the stitched trajectory `traj h gh X`, `X t = q(h - s + t)`, is `H¹` on `[0, h + s]`
  -- and agrees a.e. with `z`.
  have hX := hasWeakDeriv_comp_add hq (T := s) (t := h - s) (by linarith) (by linarith)
  have hX0 : q (h - s + 0) = gh h := by
    have := e1 ⟨by linarith, le_rfl⟩
    simpa [show s + (h - s) = h by ring] using this
  have hZ := hasWeakDeriv_traj_of d.h_pos.le hs0.le hgh hX hX0
  have hxX : x =ᵐ[μI s] fun t => q (h - s + t) := by
    filter_upwards [ae_comp_add hc₂ (s := h - s) (T := s) (by linarith) (by linarith),
      ae_restrict_mem measurableSet_Ioc] with t ht htI
    show x t = c₂ + ∫ u in (0 : ℝ)..h - s + t, G₂ u
    rw [← ht, show s + (h - s + t) = h + t by ring, hzdef, trajOf,
      traj_of_lt _ _ (by linarith [htI.1] : h < h + t), add_sub_cancel_left]
  have hzZ : z =ᵐ[μI (h + s)] traj h gh fun t => q (h - s + t) :=
    (traj_ae_congr hsndg _ _).trans (traj_ae_congr_right gh hxX)
  -- Step 4: the endpoint relation, by continuity at `t = 0`.
  have a2 : ∀ᵐ t ∂(μI s), x t = d.M.eval z t + d.fstAt v t := (d.isSolOn_orbit v hs0.le).2
  have hae : ∀ᵐ t ∂(μI s), traj h gh (fun t => q (h - s + t)) (h + t) =
      d.M.eval (traj h gh fun t => q (h - s + t)) t + d.fstAt v t := by
    filter_upwards [ae_comp_add hzZ d.h_pos.le le_rfl, a2, d.M.ae_eval_eq hzZ,
      ae_restrict_mem measurableSet_Ioc] with t e₁ e₂ e₃ ht
    have hzt : z (h + t) = x t := by
      rw [hzdef, trajOf, traj_of_lt _ _ (by linarith [ht.1] : h < h + t), add_sub_cancel_left]
    rw [← e₁, hzt, e₂, e₃]
  have hcl : ContinuousOn (fun t => traj h gh (fun t => q (h - s + t)) (h + t)) (Icc 0 s) :=
    hZ.continuousOn.comp (f := fun t => h + t) (by fun_prop)
      fun t ht => ⟨by linarith [ht.1, d.h_pos], by linarith [ht.2]⟩
  have heq := eqOn_Icc_of_ae hs0 hcl
    ((d.M.continuousOn_eval hZ.continuousOn).add (d.continuousOn_fstAt v s)) hae ⟨le_rfl, hs0.le⟩
  simp only [add_zero, Pi.add_apply, fstAt_zero] at heq
  rw [traj_of_le _ _ le_rfl, d.M.eval_traj_zero] at heq
  rw [heq]
  abel

/-- **The generator of the delay semigroup** (`ex:intro-delay`):
`D(A) = {(g(h) - M g, g) : g ∈ H¹(0, h; E)}`. -/
theorem mem_generator_domain_iff (v : State h E) :
    v ∈ d.semigroup.generator.domain ↔
      ∃ g g' : ℝ → E, HasWeakDeriv h g g' ∧ v.fst = g h - d.M.eval g 0 ∧
        ⇑v.snd =ᵐ[μI h] g := by
  refine ⟨d.exists_hasWeakDeriv_of_mem_generator_domain, ?_⟩
  rintro ⟨g, g', hg, h1, h2⟩
  rw [d.eq_toLp_of_hasWeakDeriv hg h1 h2]
  exact d.mem_generator_domain_of_hasWeakDeriv hg

/-- On `D(A)`, the first component is determined by any `H¹` representative of the history:
`v₁ = g(h) - M g`. -/
theorem fst_eq_of_mem_generator_domain {v : State h E} (hv : v ∈ d.semigroup.generator.domain)
    (hg : HasWeakDeriv h g g') (h2 : ⇑v.snd =ᵐ[μI h] g) : v.fst = g h - d.M.eval g 0 := by
  obtain ⟨g₁, g₁', hg₁, h1, h2'⟩ := d.exists_hasWeakDeriv_of_mem_generator_domain hv
  have heq : EqOn g₁ g (Icc 0 h) :=
    eqOn_Icc_of_ae d.h_pos hg₁.continuousOn hg.continuousOn (h2'.symm.trans h2)
  rw [h1, heq ⟨d.h_pos.le, le_rfl⟩, d.M.eval_zero_congr heq]

/-- **The generator acts by differentiation**: for `v ∈ D(A)` whose history has an `H¹`
representative `g`, `A v = (L g, g')`, `L g = ∑ₖ Aₖ ∫ g(h - δ) dλₖ(δ) + L_d g`. -/
theorem generator_apply {v : State h E} (hv : v ∈ d.semigroup.generator.domain)
    (hg : HasWeakDeriv h g g') (h2 : ⇑v.snd =ᵐ[μI h] g) :
    d.semigroup.generator ⟨v, hv⟩ = WithLp.toLp 2 (d.L.eval g 0, hg.memLp_deriv.toLp g') :=
  d.semigroup.generator_apply_eq hv (by
    rw [d.eq_toLp_of_hasWeakDeriv hg (d.fst_eq_of_mem_generator_domain hv hg h2) h2]
    exact d.tendsto_diffQuot_of_hasWeakDeriv hg)

