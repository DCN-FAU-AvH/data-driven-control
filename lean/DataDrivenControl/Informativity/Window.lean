module

public import DataDrivenControl.Informativity.Informative
public import DataDrivenControl.Signal.Shift

/-!
# Window informativity

Paper: `def:window-informative`, `lem:window-implies-informative`
(`app:window-implies-informative`).

## Main declarations

* `WindowInformative T T' ū x̄`: the record `(ū, x̄)` on `[0, T + T']` is **window
  informative** (`def:window-informative`): the window synthesis operator
  `𝒵_{T,T'}^{ū,x̄} = windowSynth T T' ū x̄ : L²(0, T') → L²(0, T; U) × X` (`Signal/Shift`) has
  dense range.  "Window informative at horizon `ρ`" is `WindowInformative ρ T' ū x̄`.
* `windowInformative_iff`: the kernel form, only `(g, ξ) = 0` satisfies
  `∫₀ᵀ ⟪g t, ū (s + t)⟫ dt + ⟪ξ, x̄ s⟫ = 0` for a.e. `s ∈ (0, T')`.
* `System.informative_of_windowInformative`: `lem:window-implies-informative`; under `hyp:H1`, a
  window-informative record generated by `(x̄₀, ū) ∈ X × L²(0, T + T'; U)` is informative on
  `(0, T + T')`.

## Proof of `lem:window-implies-informative`

The paper tests the annihilator identity against each `φ ∈ L²(0, T)` and represents the two
resulting functionals by `ξ_φ = ∫ φ(t) S(t)† β dt ∈ X` and (Riesz) `g_φ ∈ L²(0, T; U)`.  We
package all `φ` at once: for an annihilator `(α, β)` the **annihilator operator**
`𝒜 (v, ξ) = (t ↦ ⟪α, v t⟫ + ⟪β, x(t; ξ, v)⟫) : L²(0, T; U) × X → L²(0, T)` is bounded under
`hyp:H1` (`exists_annihilatorOp`, built by `exists_clm_toL2`), and `(ξ_φ, ·)` above are the
components of `𝒜† φ`.  By the flow property `x̄(s + t) = x(t; x̄(s), ū(s + ·))`
(`System.mild_add_time`), `𝒜` kills every state window `(ū(s + ·), x̄(s))`, so `𝒜 ∘ 𝒵 = 0`
(`comp_pointSynth`), and window informativity gives `𝒜 = 0`.  Then `𝒜 (0, β) = 0` says that the
continuous function `t ↦ ⟪β, S(t) β⟫` vanishes a.e. on `(0, T)`, hence at `t = 0`, so `β = 0`;
and `𝒜 (α, 0) = ‖α‖² = 0` (constant input `α`) gives `α = 0`.
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped InnerProductSpace ENNReal

noncomputable section

set_option autoImplicit false

namespace DataDrivenControl

variable {U X : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]

/-- **Window informativity** (`def:window-informative`): the record `(ū, x̄)` on `[0, T + T']`
is *window informative* if the window synthesis operator
`𝒵_{T,T'}^{ū,x̄} φ = ∫₀^{T'} φ(s) (ū(s + ·), x̄(s)) ds` (`windowSynth`) has dense range in
`L²(0, T; U) × X`.  It is meaningful for `ū ∈ L²(0, T + T'; U)` and `x̄ ∈ L²(0, T'; X)`.
"Window informative at horizon `ρ`" is `WindowInformative ρ T' ū x̄`. -/
def WindowInformative (T T' : ℝ) (u : ℝ → U) (x : ℝ → X) : Prop :=
  DenseRange (windowSynth T T' u x)

variable {T T' : ℝ} {u : ℝ → U} {x : ℝ → X}

/-- Window informativity through the kernel of `𝒵†`: only `(g, ξ) = 0` satisfies
`∫₀ᵀ ⟪g t, ū (s + t)⟫ dt + ⟪ξ, x̄ s⟫ = 0` for a.e. `s ∈ (0, T')`. -/
theorem windowInformative_iff (hu : MemLp u 2 (μI (T + T'))) (hx : MemLp x 2 (μI T')) :
    WindowInformative T T' u x ↔
      ∀ p : WithLp 2 (L2 U T × X),
        (∀ᵐ s ∂(μI T'), (∫ t in Ioc 0 T, ⟪p.fst t, u (s + t)⟫_ℝ) + ⟪p.snd, x s⟫_ℝ = 0) →
          p = 0 :=
  denseRange_windowSynth_iff hu hx

/-- A family of signals `f e ∈ L²(0, τ; F)`, additive and homogeneous in `e` pointwise on
`(0, τ]` and bounded uniformly in time by a multiple of `‖e‖`, defines a bounded operator
`E → L²(0, τ; F)`. -/
private theorem exists_clm_toL2 {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] {τ : ℝ} (f : E → ℝ → F)
    (hmem : ∀ e, MemLp (f e) 2 (μI τ))
    (hadd : ∀ e e', ∀ t ∈ Ioc 0 τ, f (e + e') t = f e t + f e' t)
    (hsmul : ∀ (c : ℝ) e, ∀ t ∈ Ioc 0 τ, f (c • e) t = c • f e t)
    {C : ℝ} (hC : ∀ e, ∀ t ∈ Ioc 0 τ, ‖f e t‖ ≤ C * ‖e‖) :
    ∃ A : E →L[ℝ] L2 F τ, ∀ e, ⇑(A e) =ᵐ[μI τ] f e := by
  let A₀ : E →ₗ[ℝ] L2 F τ :=
    { toFun := fun e => (hmem e).toLp _
      map_add' := fun e e' => by
        rw [← MemLp.toLp_add]
        exact MemLp.toLp_congr _ _
          ((ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall (hadd e e')))
      map_smul' := fun c e => by
        rw [RingHom.id_apply, ← MemLp.toLp_const_smul]
        exact MemLp.toLp_congr _ _
          ((ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall (hsmul c e))) }
  refine ⟨A₀.mkContinuous ((measureUnivNNReal (μI τ) : ℝ) ^ (2 : ℝ≥0∞).toReal⁻¹ * max C 0)
    fun e => ?_, fun e => (hmem e).coeFn_toLp⟩
  have := Lp.norm_le_of_ae_bound (f := (hmem e).toLp _) (C := max C 0 * ‖e‖) (by positivity) ?_
  · change ‖(hmem e).toLp _‖ ≤ _
    refine this.trans_eq ?_
    ring
  · filter_upwards [(hmem e).coeFn_toLp, ae_restrict_mem measurableSet_Ioc] with t h1 h2
    rw [h1]
    exact (hC e t h2).trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (norm_nonneg _))

namespace System

variable {W V Y : Type*}
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]
  {sys : System U W X V Y}

/-- The **annihilator operator** of `(α, β) ∈ U × X` on windows of length `T`:
`𝒜 (v, ξ) = (t ↦ ⟪α, v t⟫ + ⟪β, x(t; ξ, v)⟫) ∈ L²(0, T)`, bounded on `L²(0, T; U) × X`
under `hyp:H1`.  It vanishes on every state window `(ū(s + ·), x̄(s))` of a record annihilated
by `(α, β)` (`app:window-implies-informative`). -/
private theorem exists_annihilatorOp (hH1 : sys.H1 T) (hT : 0 < T) (a : U) (b : X) :
    ∃ 𝒜 : WithLp 2 (L2 U T × X) →L[ℝ] L2 ℝ T, ∀ p,
      ⇑(𝒜 p) =ᵐ[μI T] fun t => ⟪a, p.fst t⟫_ℝ + ⟪b, sys.mild p.snd p.fst t⟫_ℝ := by
  obtain ⟨M, -, hM⟩ := sys.SX.exists_norm_real_le T
  obtain ⟨K, hK⟩ := exists_norm_L_le hH1 hT T
  have hsub : ∀ t ∈ Ioc 0 T, ∀ {f g : ℝ → U}, f =ᵐ[μI T] g → f =ᵐ[μI t] g :=
    fun t ht _ _ hfg => ae_restrict_of_ae_restrict_of_subset (Ioc_subset_Ioc_right ht.2) hfg
  obtain ⟨R, hR⟩ := exists_clm_toL2 (τ := T)
    (fun (p : WithLp 2 (L2 U T × X)) t => ⟪b, sys.mild p.snd p.fst t⟫_ℝ)
    (fun p => memLp_μI_of_continuousOn (continuousOn_const.inner
      (continuousOn_mild hH1 hT (Lp.memLp p.fst) p.snd)))
    (fun p q t ht => by
      simp only [WithLp.add_fst, WithLp.add_snd]
      rw [mild_congr_ae (hsub t ht (Lp.coeFn_add p.fst q.fst)),
        mild_add hH1 hT (memLp_μI_of_le (Lp.memLp p.fst) ht.2)
          (memLp_μI_of_le (Lp.memLp q.fst) ht.2), inner_add_right])
    (fun c p t ht => by
      simp only [WithLp.smul_fst, WithLp.smul_snd]
      rw [mild_congr_ae (hsub t ht (Lp.coeFn_smul c p.fst)),
        mild_smul hH1 hT (memLp_μI_of_le (Lp.memLp p.fst) ht.2), inner_smul_right,
        smul_eq_mul])
    (C := ‖b‖ * (M + ‖sys.ιW‖ * max K 0)) (fun p t ht => by
      have hv : ‖sys.L t p.fst‖ ≤ max K 0 * ‖p.fst‖ :=
        (hK p.fst t (Ioc_subset_Icc_self ht)).trans
          (mul_le_mul_of_nonneg_right (le_max_left _ _) (norm_nonneg _))
      have hS : ‖sys.SX.real t p.snd‖ ≤ M * ‖p.snd‖ :=
        ((sys.SX.real t).le_opNorm _).trans
          (mul_le_mul_of_nonneg_right (hM t ht.2) (norm_nonneg _))
      have hι : ‖sys.ιW (sys.L t p.fst)‖ ≤ ‖sys.ιW‖ * (max K 0 * ‖p.fst‖) :=
        (sys.ιW.le_opNorm _).trans (mul_le_mul_of_nonneg_left hv (norm_nonneg _))
      have h1 := WithLp.norm_fst_le (x := p)
      have h2 := WithLp.norm_snd_le (x := p)
      have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM t ht.2)
      rw [Real.norm_eq_abs]
      refine (abs_real_inner_le_norm _ _).trans ?_
      change ‖b‖ * ‖sys.SX.real t p.snd + sys.ιW (sys.L t p.fst)‖ ≤ _
      calc ‖b‖ * ‖sys.SX.real t p.snd + sys.ιW (sys.L t p.fst)‖
          ≤ ‖b‖ * (M * ‖p‖ + ‖sys.ιW‖ * (max K 0 * ‖p‖)) := by
            refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
            refine (norm_add_le _ _).trans (add_le_add (hS.trans ?_) (hι.trans ?_))
            · exact mul_le_mul_of_nonneg_left h2 hM0
            · exact mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_left h1 (le_max_right _ _)) (norm_nonneg _)
        _ = ‖b‖ * (M + ‖sys.ιW‖ * max K 0) * ‖p‖ := by ring)
  refine ⟨(innerSL ℝ a).compLpL 2 (μI T) ∘L WithLp.fstL 2 ℝ (L2 U T) X + R, fun p => ?_⟩
  filter_upwards [Lp.coeFn_add ((innerSL ℝ a).compLpL 2 (μI T) p.fst) (R p),
    (innerSL ℝ a).coeFn_compLpL p.fst, hR p] with t h1 h2 h3
  rw [add_apply, ContinuousLinearMap.comp_apply, WithLp.fstL_apply, h1,
    Pi.add_apply, h2, h3, innerSL_apply_apply]

/-- **Window informativity implies informativity** (`lem:window-implies-informative`): under
Assumption `hyp:H1`, let `(ū, x̄)` be the record on `[0, T + T']` generated by
`(x̄₀, ū) ∈ X × L²(0, T + T'; U)`.  If `(ū, x̄)` is window informative, it is informative on
`(0, T + T')`. -/
theorem informative_of_windowInformative (hH1 : sys.H1 T) (hT : 0 < T) {x₀ : X}
    (hu : MemLp u 2 (μI (T + T'))) (h : WindowInformative T T' u (sys.mild x₀ u)) :
    Informative (T + T') u (sys.mild x₀ u) := by
  rw [informative_iff]
  intro a b hab
  obtain ⟨𝒜, h𝒜⟩ := exists_annihilatorOp hH1 hT a b
  have hx : MemLp (sys.mild x₀ u) 2 (μI T') :=
    memLp_mild hH1 hT (memLp_μI_of_le hu (by linarith)) x₀
  have hg : MemLp (fun s => WithLp.toLp 2 (window T u s, sys.mild x₀ u s)) 2 (μI T') :=
    MemLp.of_fst_of_snd_prodLp ⟨memLp_window hu, hx⟩
  -- `𝒜` vanishes on every state window of the record
  have hkey : ∀ s ∈ Ioc 0 T', 𝒜 (WithLp.toLp 2 (window T u s, sys.mild x₀ u s)) = 0 := by
    intro s hs
    have hs0 : 0 ≤ s := hs.1.le
    have hsT : s + T ≤ T + T' := by linarith [hs.2]
    have hw := coeFn_window_of_memLp hu hs0 hsT
    refine Lp.eq_zero_iff_ae_eq_zero.2 ?_
    filter_upwards [h𝒜 (WithLp.toLp 2 (window T u s, sys.mild x₀ u s)), hw,
      ae_comp_add hab hs0 hsT, ae_restrict_mem measurableSet_Ioc] with t h1 h2 h3 ht
    rw [h1, Pi.zero_apply, WithLp.toLp_fst, WithLp.toLp_snd, h2,
      mild_congr_ae (ae_restrict_of_ae_restrict_of_subset (Ioc_subset_Ioc_right ht.2) hw),
      ← mild_add_time hH1 hT hs0 ht.1.le (memLp_μI_of_le hu (by linarith [ht.2])), h3]
  -- hence `𝒜 ∘ 𝒵 = 0`, and `𝒜 = 0` by window informativity
  have hcomp : 𝒜 ∘L windowSynth T T' u (sys.mild x₀ u) = 0 := by
    rw [windowSynth_eq_pointSynth hu hx, comp_pointSynth hg,
      pointSynth_congr_ae (g' := fun _ => (0 : L2 ℝ T))
        ((ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall hkey))]
    have h0 := comp_pointSynth hg (0 : WithLp 2 (L2 U T × X) →L[ℝ] L2 ℝ T)
    rw [ContinuousLinearMap.zero_comp] at h0
    exact h0.symm
  have h𝒜0 : 𝒜 = 0 := by
    refine DFunLike.coe_injective (DenseRange.equalizer h 𝒜.continuous
      (0 : WithLp 2 (L2 U T × X) →L[ℝ] L2 ℝ T).continuous ?_)
    funext φ
    exact DFunLike.congr_fun hcomp φ
  -- the state component: `t ↦ ⟪β, S(t) β⟫` vanishes a.e. on `(0, T)`, hence at `t = 0`
  have hL0 : ∀ t, sys.L t (0 : ℝ → U) = 0 := fun t => by
    have := L_smul hH1 hT (t := t) (u := (0 : ℝ → U)) MemLp.zero 0
    simpa using this
  have hb : b = 0 := by
    have h1 := h𝒜 (WithLp.toLp 2 (0, b))
    rw [h𝒜0, zero_apply] at h1
    have h2 : (fun t => ⟪b, sys.SX.real t b⟫_ℝ) =ᵐ[volume.restrict (Icc 0 T)] fun _ => 0 := by
      rw [← Measure.restrict_congr_set Ioc_ae_eq_Icc]
      filter_upwards [h1, Lp.coeFn_zero ℝ 2 (μI T), Lp.coeFn_zero U 2 (μI T),
        ae_restrict_mem measurableSet_Ioc] with t h1 h2 h3 ht
      rw [WithLp.toLp_fst, WithLp.toLp_snd, h2, Pi.zero_apply, h3, Pi.zero_apply,
        inner_zero_right, zero_add,
        mild_congr_ae (ae_restrict_of_ae_restrict_of_subset (Ioc_subset_Ioc_right ht.2)
          (Lp.coeFn_zero U 2 (μI T))), mild, hL0, map_zero, add_zero] at h1
      exact h1.symm
    have h3 := Measure.eqOn_of_ae_eq h2
      (continuous_const.inner (sys.SX.continuous_real_apply b)).continuousOn
      continuousOn_const (by rw [interior_Icc, closure_Ioo hT.ne]) (left_mem_Icc.2 hT.le)
    simpa using h3
  -- the input component: `⟪α, α⟫ = 0`
  have ha : a = 0 := by
    have h1 := h𝒜 (WithLp.toLp 2 (Lp.const 2 (μI T) a, 0))
    rw [h𝒜0, zero_apply] at h1
    have h2 : ∀ᵐ t ∂(μI T), ⟪a, a⟫_ℝ = 0 := by
      filter_upwards [h1, Lp.coeFn_zero ℝ 2 (μI T), Lp.coeFn_const (μ := μI T) (p := 2) a]
        with t h1 h2 h3
      rw [WithLp.toLp_fst, h2, h3, hb, inner_zero_left, add_zero] at h1
      exact h1.symm
    have hne : μI T ≠ 0 := by
      simp [μI, Measure.restrict_eq_zero, Real.volume_Ioc, hT]
    have : (ae (μI T)).NeBot := ae_neBot.2 hne
    obtain ⟨t, ht⟩ := h2.exists
    exact inner_self_eq_zero.1 ht
  exact ⟨ha, hb⟩

end System

end DataDrivenControl
