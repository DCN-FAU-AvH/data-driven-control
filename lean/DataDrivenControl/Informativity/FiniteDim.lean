module

public import DataDrivenControl.Informativity.PE
public import DataDrivenControl.System.Controllability
public import DataDrivenControl.Semigroup.Inhomogeneous

/-!
# Finite-dimensional sufficiency

Paper: `prop:finite-pe-sufficient` (`app:finite-pe-sufficiency`, `eq:finite-suff-annihilator`,
`eq:finite-suff-recursion`).

## Main declarations

* `KalmanControllable A B`: the Kalman condition
  `span {Aᵏ B v : v ∈ U, k = 0, …, N - 1} = X`, `N = dim X`, for a matrix `A : X →L[ℝ] X` and a
  bounded `B : U →L[ℝ] X` (`U` may be infinite-dimensional).
* `kalmanControllable_iff`: its dual form `⋂_{k < N} ker (B† (A†)ᵏ) = {0}`, the form used in
  `app:finite-pe-sufficiency`.
* `System.approxControllable_bounded_iff_kalman`, `System.exactlyControllable_bounded_iff_kalman`:
  for a semigroup `S` on a finite-dimensional `X` whose generator is the matrix `A`
  (`S.generator = A.toPMap ⊤`) and bounded `B`, approximate and exact controllability in any time
  `T > 0` are both equivalent to the Kalman condition.
* `System.exists_matrix_of_finiteDimensional`: in finite dimensions every system of the standing
  setting is a matrix system with bounded control operator: `A = sys.A` is everywhere defined,
  and the mild solution of `sys` is that of `System.bounded sys.SX B 0` for some `B ∈ L(U, X)`.
* `System.informative_of_persistentlyExciting` (`prop:finite-pe-sufficient`): if
  `dim X = N < ∞`, `(A, B)` is controllable and `ū` is persistently exciting of order `N + 1`,
  then the record `(ū, x̄)` generated by any `x̄₀ ∈ X` is informative.  "Controllable" is taken as
  approximate controllability in time `T`, the weakest of the equivalent finite-dimensional
  notions.

## Proof route

* Algebra (namespace `FiniteDim`): Cayley–Hamilton in `L(X)` (`aeval_self_charpoly`,
  `pow_finrank`), the Krylov closure `inner_pow_apply_eq_zero`, the closed form `closed_form` of
  `X_{j+1} = A X_j + B U_j`, the coefficients `zeta` of the relation
  `∑_{i ≤ N} ⟪ζᵢ, Dⁱ ū⟫ = 0` (`sum_inner_zeta`) and their reading from the top down
  (`eq_zero_of_zeta_eq_zero`).
* Semigroups: a bounded generator gives `S(t) = exp (t A)` (`real_eq_exp`, by uniqueness for the
  abstract Cauchy problem) and `A† = (adjoint A)` on all of `X` (`generator_adjoint_of_eq`); the
  record of a matrix system is `H¹` with `ẋ = A x + B u` (`hasWeakDeriv_bounded_mild`, Ball's
  theorem `isWeakSol_mildSol`).
* Controllability: `η ⊥ ℛ_T(0)` iff `B† (A†)ᵏ η = 0` for `k < N`
  (`inner_conv_eq_zero_of_dual`: exponential series; `dual_of_inner_conv_eq_zero`: fundamental
  lemma on `(0, T)`, differentiation in time, `t → 0`).  In finite dimensions `ℛ_T(0)` is closed,
  so exact and approximate controllability agree (`System.exactlyControllable_iff_approxControllable`).
* `prop:finite-pe-sufficient`: the derivative moments `X_j = ⟨Dʲ x̄, φ⟩`, `U_j = ⟨Dʲ ū, φ⟩` satisfy
  `X_{j+1} = A X_j + B U_j` and `⟪α, U_j⟫ + ⟪β, X_j⟫ = 0`; this is the paper's recursion
  `eq:finite-suff-recursion`, written for the vector moments instead of the scalars `s_k`.
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped InnerProductSpace

noncomputable section

namespace DataDrivenControl

set_option linter.unusedSectionVars false

variable {U X : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]

/-- The **Kalman controllability condition** for a matrix `A` on a finite-dimensional `X` and a
bounded `B : U → X` (`app:finite-pe-sufficiency`):
`span {Aᵏ B v : v ∈ U, k = 0, …, N - 1} = X` with `N = dim X`. -/
def KalmanControllable (A : X →L[ℝ] X) (B : U →L[ℝ] X) : Prop :=
  ⨆ k ∈ Finset.range (Module.finrank ℝ X), ((A ^ k).comp B).range = ⊤

namespace FiniteDim

/-- `⟪β, Aᵏ B v⟫ = ⟪B† (A†)ᵏ β, v⟫`. -/
theorem inner_pow_apply (A : X →L[ℝ] X) (B : U →L[ℝ] X) (k : ℕ) (β : X) (v : U) :
    ⟪β, (A ^ k) (B v)⟫_ℝ =
      ⟪ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ k) β), v⟫_ℝ := by
  induction k generalizing β with
  | zero => simp [ContinuousLinearMap.adjoint_inner_left]
  | succ k ih =>
    rw [pow_succ', mul_apply_eq_comp,
      ← ContinuousLinearMap.adjoint_inner_left, ih, pow_succ,
      mul_apply_eq_comp]

/-- `toLinearMap` as an algebra homomorphism. -/
def toLinearMapAlgHom : (X →L[ℝ] X) →ₐ[ℝ] (X →ₗ[ℝ] X) :=
  { ContinuousLinearMap.toLinearMapRingHom with commutes' := fun r => by ext; simp }

/-- Cayley–Hamilton in the algebra of bounded operators. -/
theorem aeval_self_charpoly [FiniteDimensional ℝ X] (A : X →L[ℝ] X) :
    Polynomial.aeval A (A : X →ₗ[ℝ] X).charpoly = 0 := by
  have h := LinearMap.aeval_self_charpoly (A : X →ₗ[ℝ] X)
  have e := Polynomial.aeval_algHom_apply (toLinearMapAlgHom (X := X)) A (A : X →ₗ[ℝ] X).charpoly
  have : toLinearMapAlgHom (Polynomial.aeval A (A : X →ₗ[ℝ] X).charpoly) = 0 := by
    rw [← e]; exact h
  exact ContinuousLinearMap.coe_injective this

variable [FiniteDimensional ℝ X]

/-- The characteristic polynomial of the matrix `A`. -/
abbrev cp (A : X →L[ℝ] X) : Polynomial ℝ := (A : X →ₗ[ℝ] X).charpoly

/-- `deg p = N`. -/
theorem cp_natDegree (A : X →L[ℝ] X) : (cp A).natDegree = Module.finrank ℝ X :=
  LinearMap.charpoly_natDegree _

/-- `p` is monic of degree `N`. -/
theorem cp_coeff_finrank (A : X →L[ℝ] X) : (cp A).coeff (Module.finrank ℝ X) = 1 := by
  rw [← cp_natDegree]; exact (LinearMap.charpoly_monic _).coeff_natDegree

/-- Cayley–Hamilton: `∑_{k ≤ N} pₖ Aᵏ = 0`. -/
theorem sum_coeff_smul_pow (A : X →L[ℝ] X) :
    ∑ k ∈ Finset.range (Module.finrank ℝ X + 1), (cp A).coeff k • A ^ k = 0 := by
  rw [← cp_natDegree, ← Polynomial.aeval_eq_sum_range]; exact aeval_self_charpoly A

/-- Cayley–Hamilton: `A^N = -∑_{k < N} pₖ Aᵏ`. -/
theorem pow_finrank (A : X →L[ℝ] X) :
    A ^ Module.finrank ℝ X = -∑ k ∈ Finset.range (Module.finrank ℝ X), (cp A).coeff k • A ^ k := by
  have h := sum_coeff_smul_pow A
  rw [Finset.sum_range_succ, cp_coeff_finrank, one_smul] at h
  exact eq_neg_of_add_eq_zero_right h

/-- Cayley–Hamilton closes the Krylov sequence: `⟪η, Aᵏ B v⟫ = 0` for `k < N` gives it for every
`k`. -/
theorem inner_pow_apply_eq_zero {A : X →L[ℝ] X} {B : U →L[ℝ] X} {η : X}
    (h : ∀ k < Module.finrank ℝ X, ∀ v, ⟪η, (A ^ k) (B v)⟫_ℝ = 0) (n : ℕ) (v : U) :
    ⟪η, (A ^ n) (B v)⟫_ℝ = 0 := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases lt_or_ge n (Module.finrank ℝ X) with hn | hn
    · exact h n hn v
    · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le' hn
      rw [pow_add, pow_finrank, mul_neg, Finset.mul_sum, neg_apply,
        inner_neg_right, sum_apply, inner_sum, neg_eq_zero]
      refine Finset.sum_eq_zero fun k hk => ?_
      rw [mul_smul_comm, ← pow_add, smul_apply, inner_smul_right,
        ih _ (by simp at hk; omega), mul_zero]

/-- Closed form of the recursion `X_{j+1} = A X_j + B U_j`. -/
theorem closed_form {A : X →L[ℝ] X} {B : U →L[ℝ] X} {Xs : ℕ → X} {Us : ℕ → U}
    (hrec : ∀ j, Xs (j + 1) = A (Xs j) + B (Us j)) (k : ℕ) :
    Xs k = (A ^ k) (Xs 0) + ∑ i ∈ Finset.range k, (A ^ (k - 1 - i)) (B (Us i)) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [hrec, ih, map_add, map_sum, Finset.sum_range_succ, Nat.add_sub_cancel, Nat.sub_self,
      pow_zero, one_apply_eq_self, pow_succ', mul_apply_eq_comp, add_assoc]
    congr 2
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [Finset.mem_range] at hi
    rw [show k - i = (k - 1 - i) + 1 by omega, pow_succ', mul_apply_eq_comp]

/-- The coefficients `ζᵢ = pᵢ α + ∑_{i < k ≤ N} pₖ B† (A†)^{k-1-i} β` of the relation
`∑_{i ≤ N} ⟪ζᵢ, Dⁱ ū⟫ = 0` (`app:finite-pe-sufficiency`, `eq:finite-suff-recursion`). -/
def zeta (A : X →L[ℝ] X) (B : U →L[ℝ] X) (α : U) (β : X) (i : ℕ) : U :=
  (cp A).coeff i • α + ∑ k ∈ Finset.Ioc i (Module.finrank ℝ X),
    (cp A).coeff k • ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ (k - 1 - i)) β)

/-- The algebraic core of `app:finite-pe-sufficiency`: if `X_{j+1} = A X_j + B U_j` and
`⟪α, U_j⟫ + ⟪β, X_j⟫ = 0` for all `j`, then `∑_{i ≤ N} ⟪ζᵢ, U_i⟫ = 0`. -/
theorem sum_inner_zeta {A : X →L[ℝ] X} {B : U →L[ℝ] X} {α : U} {β : X} {Xs : ℕ → X}
    {Us : ℕ → U} (hrec : ∀ j, Xs (j + 1) = A (Xs j) + B (Us j))
    (hann : ∀ j, ⟪α, Us j⟫_ℝ + ⟪β, Xs j⟫_ℝ = 0) :
    ∑ i ∈ Finset.range (Module.finrank ℝ X + 1), ⟪zeta A B α β i, Us i⟫_ℝ = 0 := by
  set N := Module.finrank ℝ X
  set c : ℕ → U := fun m =>
    ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ m) β) with hc
  have h1 : ∀ k, ⟪β, Xs k⟫_ℝ =
      ⟪β, (A ^ k) (Xs 0)⟫_ℝ + ∑ i ∈ Finset.range k, ⟪c (k - 1 - i), Us i⟫_ℝ := by
    intro k
    rw [closed_form hrec k, inner_add_right, inner_sum]
    simp only [inner_pow_apply, hc]
  have h2 : ∑ k ∈ Finset.range (N + 1), (cp A).coeff k * ⟪β, (A ^ k) (Xs 0)⟫_ℝ = 0 := by
    have := congrArg (fun T : X →L[ℝ] X => ⟪β, T (Xs 0)⟫_ℝ) (sum_coeff_smul_pow A)
    simpa only [sum_apply, smul_apply, inner_sum,
      inner_smul_right, zero_apply, inner_zero_right] using this
  have h3 : ∑ k ∈ Finset.range (N + 1), ∑ i ∈ Finset.range k,
        (cp A).coeff k * ⟪c (k - 1 - i), Us i⟫_ℝ =
      ∑ i ∈ Finset.range (N + 1), ∑ k ∈ Finset.Ioc i N,
        (cp A).coeff k * ⟪c (k - 1 - i), Us i⟫_ℝ :=
    Finset.sum_comm' fun k i => by simp only [Finset.mem_range, Finset.mem_Ioc]; omega
  have h0 : ∑ k ∈ Finset.range (N + 1), (cp A).coeff k * (⟪α, Us k⟫_ℝ + ⟪β, Xs k⟫_ℝ) = 0 :=
    Finset.sum_eq_zero fun k _ => by rw [hann, mul_zero]
  rw [← h0]
  simp only [zeta, inner_add_left, sum_inner, inner_smul_left, RCLike.conj_to_real,
    Finset.sum_add_distrib, h1, mul_add, Finset.mul_sum, h2, h3]
  ring

/-- Reading the coefficients `ζᵢ = 0` from the highest down: `α = 0` and
`B† (A†)ᵐ β = 0` for `m < N`. -/
theorem eq_zero_of_zeta_eq_zero {A : X →L[ℝ] X} {B : U →L[ℝ] X} {α : U} {β : X}
    (h : ∀ i ≤ Module.finrank ℝ X, zeta A B α β i = 0) :
    α = 0 ∧ ∀ m < Module.finrank ℝ X,
      ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ m) β) = 0 := by
  set N := Module.finrank ℝ X
  have hα : α = 0 := by
    have := h N le_rfl
    rwa [zeta, Finset.Ioc_self, Finset.sum_empty, add_zero, cp_coeff_finrank, one_smul] at this
  refine ⟨hα, fun m => ?_⟩
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    intro hm
    have := h (N - 1 - m) (by omega)
    rw [zeta, hα, smul_zero, zero_add, Finset.sum_eq_single N] at this
    · rwa [cp_coeff_finrank, one_smul, show N - 1 - (N - 1 - m) = m by omega] at this
    · intro k hk hkN
      rw [Finset.mem_Ioc] at hk
      rw [ih _ (by omega) (by omega), smul_zero]
    · intro hN
      exact absurd (Finset.mem_Ioc.2 ⟨by omega, le_rfl⟩) hN

end FiniteDim

open FiniteDim in
/-- The dual form of the Kalman condition (`app:finite-pe-sufficiency`):
`⋂_{k = 0}^{N-1} ker (B† (A†)ᵏ) = {0}`. -/
theorem kalmanControllable_iff [FiniteDimensional ℝ X] {A : X →L[ℝ] X} {B : U →L[ℝ] X} :
    KalmanControllable A B ↔
      ∀ β : X, (∀ k < Module.finrank ℝ X,
        ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ k) β) = 0) → β = 0 := by
  set K := ⨆ k ∈ Finset.range (Module.finrank ℝ X), ((A ^ k).comp B).range with hK
  have key : ∀ β : X, β ∈ Kᗮ ↔ ∀ k < Module.finrank ℝ X,
      ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ k) β) = 0 := by
    intro β
    constructor
    · intro hβ k hk
      have hv : ∀ v : U, ⟪ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ k) β),
          v⟫_ℝ = 0 := fun v => by
        rw [← inner_pow_apply, real_inner_comm]
        refine (Submodule.mem_orthogonal _ _).1 hβ _ ?_
        exact Submodule.mem_iSup_of_mem k (Submodule.mem_iSup_of_mem (Finset.mem_range.2 hk)
          (LinearMap.mem_range.2 ⟨v, rfl⟩))
      exact inner_self_eq_zero.1 (hv _)
    · intro h
      have hle : K ≤ (ℝ ∙ β)ᗮ := iSup₂_le fun k hk x hx => by
        obtain ⟨v, rfl⟩ := LinearMap.mem_range.1 hx
        rw [Submodule.mem_orthogonal_singleton_iff_inner_right]
        change ⟪β, (A ^ k) (B v)⟫_ℝ = 0
        rw [inner_pow_apply, h k (Finset.mem_range.1 hk), inner_zero_left]
      rw [Submodule.mem_orthogonal]
      intro x hx
      rw [real_inner_comm]
      exact Submodule.mem_orthogonal_singleton_iff_inner_right.1 (hle hx)
  rw [KalmanControllable, ← hK, ← Submodule.orthogonal_eq_bot_iff, Submodule.eq_bot_iff]
  exact forall_congr' fun β => imp_congr_left (key β)

namespace FiniteDim

section Semigroup

variable {Y : Type*} [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]

omit [CompleteSpace X] in
/-- A partial map equal to an everywhere defined linear map is defined everywhere. -/
theorem mem_domain_of_eq_toPMap {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F]
    [Module ℝ F] {f : E →ₗ.[ℝ] F} {L : E →ₗ[ℝ] F} (h : f = L.toPMap ⊤) (x : E) :
    x ∈ f.domain := by
  rw [h]; trivial

/-- A partial map equal to an everywhere defined linear map `L` acts as `L`. -/
theorem apply_of_eq_toPMap {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F]
    [Module ℝ F] {f : E →ₗ.[ℝ] F} {L : E →ₗ[ℝ] F} (h : f = L.toPMap ⊤) (x : f.domain) :
    f x = L x := by
  obtain ⟨-, hval⟩ := LinearPMap.ext_iff.1 h
  exact hval (x := (x : E)) (hf := x.2) (hg := Submodule.mem_top)

/-- A C₀-semigroup with bounded generator `A` is `t ↦ exp (t A)`. -/
theorem real_eq_exp {S : C0Semigroup ℝ X} {A : X →L[ℝ] X}
    (hA : S.generator = (A : X →ₗ[ℝ] X).toPMap ⊤) {t : ℝ} (ht : 0 ≤ t) :
    S.real t = NormedSpace.exp (t • A) := by
  ext x
  have hd : ∀ s : ℝ, HasDerivAt (fun s : ℝ => NormedSpace.exp (s • A) x)
      (A (NormedSpace.exp (s • A) x)) s := by
    intro s
    have := (hasDerivAt_exp_smul_const' (𝕂 := ℝ) A s).clm_apply (hasDerivAt_const s x)
    simpa [mul_apply_eq_comp] using this
  have := S.eq_real_apply_of_hasDerivWithinAt (w := fun s => NormedSpace.exp (s • A) x) ht
    (Continuous.continuousOn (continuous_iff_continuousAt.2 fun s => (hd s).continuousAt))
    (fun s _ => mem_domain_of_eq_toPMap hA _)
    (fun s _ => by rw [apply_of_eq_toPMap hA]; exact (hd s).hasDerivWithinAt)
  simpa using this.symm

/-- The adjoint of a bounded generator. -/
theorem generator_adjoint_of_eq {S : C0Semigroup ℝ X} {A : X →L[ℝ] X}
    (hA : S.generator = (A : X →ₗ[ℝ] X).toPMap ⊤) :
    S.generator.adjoint = (ContinuousLinearMap.adjoint A : X →ₗ[ℝ] X).toPMap ⊤ := by
  rw [hA]
  exact A.toPMap_adjoint_eq_adjoint_toPMap_of_dense (by simp)

/-- For bounded systems the mild solution is `C0Semigroup.mildSol` with `f = B u`. -/
theorem bounded_mild_eq (S : C0Semigroup ℝ X) (B : U →L[ℝ] X) (C : X →L[ℝ] Y) (x₀ : X)
    (u : ℝ → U) (t : ℝ) :
    (System.bounded S B C).mild x₀ u t = S.mildSol x₀ (fun r => B (u r)) t := by
  rw [System.mild, System.L_eq_of_ιWV (w := ∫ r in Ioc 0 t, S.real (t - r) (B (u r))) rfl]
  rfl

/-- The record of a matrix system is `H¹` with `ẋ = A x + B u` (Ball's theorem). -/
theorem hasWeakDeriv_bounded_mild {S : C0Semigroup ℝ X} {A : X →L[ℝ] X}
    (hA : S.generator = (A : X →ₗ[ℝ] X).toPMap ⊤) (B : U →L[ℝ] X) (C : X →L[ℝ] Y) {T : ℝ}
    {u : ℝ → U} (hu : MemLp u 2 (μI T)) (x₀ : X) :
    HasWeakDeriv T ((System.bounded S B C).mild x₀ u)
      (fun t => A ((System.bounded S B C).mild x₀ u t) + B (u t)) := by
  have hBu : IntegrableOn (fun r => B (u r)) (Ioc 0 T) :=
    B.integrable_comp (hu.integrable one_le_two)
  have hw := S.isWeakSol_mildSol hBu x₀
  have hxe : (System.bounded S B C).mild x₀ u = S.mildSol x₀ (fun r => B (u r)) :=
    funext fun t => bounded_mild_eq S B C x₀ u t
  rw [hxe]
  set x := S.mildSol x₀ (fun r => B (u r)) with hx
  have hg : MemLp (fun t => A (x t) + B (u t)) 2 (μI T) :=
    (memLp_μI_of_continuousOn (A.continuous.comp_continuousOn hw.1)).add (B.comp_memLp' hu)
  refine ⟨hg, fun t ht => ?_⟩
  have hgi : IntervalIntegrable (fun s => A (x s) + B (u s)) volume 0 t :=
    (intervalIntegrable_iff_integrableOn_Ioc_of_le ht.1).2
      (IntegrableOn.mono_set (hg.integrable one_le_two) (Ioc_subset_Ioc_right ht.2))
  refine ext_inner_left ℝ fun η => ?_
  have hη := mem_domain_of_eq_toPMap (generator_adjoint_of_eq hA) η
  have hint : ⟪η, ∫ s in (0 : ℝ)..t, (A (x s) + B (u s))⟫_ℝ =
      ∫ s in (0 : ℝ)..t, ⟪η, A (x s) + B (u s)⟫_ℝ := by
    simpa using ((innerSL ℝ η).intervalIntegral_comp_comm hgi).symm
  rw [hw.2.2 η hη t ht, inner_add_right, hw.2.1, hint,
    apply_of_eq_toPMap (generator_adjoint_of_eq hA)]
  congr 1
  refine intervalIntegral.integral_congr fun s _ => ?_
  simp only [inner_add_right, ContinuousLinearMap.coe_coe,
    ContinuousLinearMap.adjoint_inner_left]

/-- For bounded systems, `L_t u` is the convolution `∫₀ᵗ S(t - r) B u(r) dr`. -/
theorem bounded_L_eq (S : C0Semigroup ℝ X) (B : U →L[ℝ] X) (C : X →L[ℝ] Y) (t : ℝ)
    (u : ℝ → U) :
    (System.bounded S B C).L t u = ∫ r in Ioc 0 t, S.real (t - r) (B (u r)) :=
  System.L_eq_of_ιWV rfl

/-- Approximate controllability of a bounded system: no nonzero `η` is orthogonal to every
`∫₀ᵀ S(T - r) B u(r) dr`. -/
theorem approxControllable_bounded_iff (S : C0Semigroup ℝ X) (B : U →L[ℝ] X) (C : X →L[ℝ] Y)
    {T : ℝ} (hT : 0 < T) :
    (System.bounded S B C).ApproxControllable T ↔
      ∀ η : X, (∀ u : ℝ → U, MemLp u 2 (μI T) →
        ⟪η, ∫ r in Ioc 0 T, S.real (T - r) (B (u r))⟫_ℝ = 0) → η = 0 := by
  rw [System.approxControllable_iff (System.bounded_H1 S B C T) hT]
  refine forall_congr' fun η => imp_congr_left ⟨fun h u hu => ?_, fun h u => ?_⟩
  · have := h (hu.toLp u)
    rwa [System.Lop_apply (System.bounded_H1 S B C T) hT, System.L_congr_ae hu.coeFn_toLp,
      System.bounded_ιW, ContinuousLinearMap.id_apply, bounded_L_eq] at this
  · rw [System.Lop_apply (System.bounded_H1 S B C T) hT, System.bounded_ιW,
      ContinuousLinearMap.id_apply, bounded_L_eq]
    exact h u (Lp.memLp u)

variable [FiniteDimensional ℝ X]

/-- Kalman ⇒ orthogonality: if `B† (A†)ᵏ η = 0` for `k < N`, then `η ⊥ S(t) B v` for all
`t ≥ 0` (`S(t) = exp (t A)` and Cayley–Hamilton), hence `η ⊥ ∫₀ᵀ S(T - r) B u(r) dr`. -/
theorem inner_conv_eq_zero_of_dual {S : C0Semigroup ℝ X} {A : X →L[ℝ] X}
    (hA : S.generator = (A : X →ₗ[ℝ] X).toPMap ⊤) {B : U →L[ℝ] X} {η : X}
    (h : ∀ k < Module.finrank ℝ X,
      ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ k) η) = 0)
    (T : ℝ) (u : ℝ → U) :
    ⟪η, ∫ r in Ioc 0 T, S.real (T - r) (B (u r))⟫_ℝ = 0 := by
  have hk : ∀ n v, ⟪η, (A ^ n) (B v)⟫_ℝ = 0 :=
    inner_pow_apply_eq_zero fun k hk v => by rw [inner_pow_apply, h k hk, inner_zero_left]
  have hexp : ∀ s : ℝ, 0 ≤ s → ∀ v, ⟪η, S.real s (B v)⟫_ℝ = 0 := by
    intro s hs v
    rw [real_eq_exp hA hs]
    have hsum := (NormedSpace.exp_series_hasSum_exp' (𝕂 := ℝ) (s • A)).mapL
      ((innerSL ℝ η).comp (ContinuousLinearMap.apply ℝ X (B v)))
    refine hsum.unique ?_
    convert hasSum_zero with n
    rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.apply_apply, innerSL_apply_apply,
      smul_pow, smul_apply, smul_apply, inner_smul_right, inner_smul_right, hk, mul_zero,
      mul_zero]
  by_cases hi : Integrable (fun r => S.real (T - r) (B (u r))) (volume.restrict (Ioc 0 T))
  · rw [← integral_inner hi]
    exact setIntegral_eq_zero_of_forall_eq_zero fun r hr => hexp _ (by linarith [hr.2]) _
  · rw [integral_undef hi, inner_zero_right]

/-- Orthogonality ⇒ Kalman: if `η ⊥ ∫₀ᵀ S(T - r) B u(r) dr` for every `u ∈ L²`, then
`⟪η, S(s) B v⟫ = 0` on `(0, T)` (fundamental lemma), the set of such `w` is `A`-invariant
(differentiate in `s`), and `s → 0` gives `B† (A†)ᵏ η = 0`. -/
theorem dual_of_inner_conv_eq_zero {S : C0Semigroup ℝ X} {A : X →L[ℝ] X}
    (hA : S.generator = (A : X →ₗ[ℝ] X).toPMap ⊤) {B : U →L[ℝ] X} {T : ℝ} (hT : 0 < T)
    {η : X}
    (h : ∀ u : ℝ → U, MemLp u 2 (μI T) → ⟪η, ∫ r in Ioc 0 T, S.real (T - r) (B (u r))⟫_ℝ = 0)
    (k : ℕ) : ContinuousLinearMap.adjoint B ((ContinuousLinearMap.adjoint A ^ k) η) = 0 := by
  -- Step a: `⟪η, S(s) B v⟫ = 0` on `(0, T)`
  have ha : ∀ v, ∀ s ∈ Ioo 0 T, ⟪η, S.real s (B v)⟫_ℝ = 0 := by
    intro v
    have hcS : Continuous fun r => S.real (T - r) (B v) :=
      (S.continuous_real_apply (B v)).comp (continuous_const.sub continuous_id)
    have hz := eqOn_zero_of_integral_smul_eq_zero (T := T)
      (u := fun r => ⟪η, S.real (T - r) (B v)⟫_ℝ)
      (continuous_const.inner hcS).continuousOn (fun φ hφ => ?_)
    · intro s hs
      have := hz (T - s) ⟨by linarith [hs.2], by linarith [hs.1]⟩
      simpa using this
    · have hu : MemLp (fun r => φ r • v) 2 (μI T) :=
        memLp_μI_of_continuousOn (hφ.continuous.smul continuous_const).continuousOn
      have h1 := h _ hu
      have hint : Integrable (fun r => φ r • S.real (T - r) (B v)) (volume.restrict (Ioc 0 T)) :=
        ((hφ.continuous.smul hcS).integrableOn_Icc).mono_set Ioc_subset_Icc_self
      simp only [map_smul] at h1
      rw [← integral_inner hint] at h1
      rw [hφ.integral_smul_eq_setIntegral]
      simpa only [inner_smul_right, smul_eq_mul] using h1
  -- Step b: invariance under `A`
  have hb : ∀ n v, ∀ s ∈ Ioo 0 T, ⟪η, S.real s ((A ^ n) (B v))⟫_ℝ = 0 := by
    intro n
    induction n with
    | zero => simpa using ha
    | succ n ih =>
      intro v s hs
      set w := (A ^ n) (B v) with hw
      have hd := HasDerivAt.inner ℝ (hasDerivAt_const s η)
        (S.hasDerivAt_real_apply ⟨w, mem_domain_of_eq_toPMap hA w⟩ hs.1)
      rw [apply_of_eq_toPMap hA] at hd
      have hz : (fun r => ⟪η, S.real r w⟫_ℝ) =ᶠ[𝓝 s] fun _ => 0 := by
        filter_upwards [isOpen_Ioo.mem_nhds hs] with r hr using ih v r hr
      have h0 : HasDerivAt (fun r => ⟪η, S.real r w⟫_ℝ) 0 s :=
        (hasDerivAt_const s (0 : ℝ)).congr_of_eventuallyEq hz
      rw [pow_succ', mul_apply_eq_comp]
      have := hd.unique h0
      rwa [inner_zero_left, add_zero] at this
  -- Step c: `s → 0`
  have hc : ∀ n v, ⟪η, (A ^ n) (B v)⟫_ℝ = 0 := by
    intro n v
    have hcl : IsClosed {s : ℝ | ⟪η, S.real s ((A ^ n) (B v))⟫_ℝ = 0} :=
      isClosed_eq (continuous_const.inner (S.continuous_real_apply _)) continuous_const
    have h0 : (0 : ℝ) ∈ closure (Ioo 0 T) := by
      rw [closure_Ioo hT.ne]; exact ⟨le_rfl, hT.le⟩
    have := hcl.closure_subset_iff.2 (fun s hs => hb n v s hs) h0
    simpa using this
  refine inner_self_eq_zero (𝕜 := ℝ).1 ?_
  rw [← inner_pow_apply, hc]

end Semigroup

/-- Derivative moments only depend on the signal a.e. on the window. -/
theorem derivMoment_congr_ae {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {T : ℝ}
    {φ : ℝ → ℝ} (hφ : IsTestFunction T φ) {f g : ℝ → E} (h : f =ᵐ[μI T] g) (k : ℕ) :
    derivMoment k f φ = derivMoment k g φ := by
  rw [hφ.derivMoment_eq_setIntegral, hφ.derivMoment_eq_setIntegral]
  congr 1
  exact integral_congr_ae (h.mono fun t ht => by simp only [ht])

end FiniteDim

namespace System

variable {W V Y : Type*}
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]
  {T : ℝ}

open FiniteDim in
/-- In finite dimensions, approximate controllability in time `T > 0` of the matrix system
`ẋ = A x + B u` (`S.generator = A`, bounded `B`) is the Kalman condition. -/
theorem approxControllable_bounded_iff_kalman [FiniteDimensional ℝ X] {S : C0Semigroup ℝ X}
    {A : X →L[ℝ] X} (hA : S.generator = (A : X →ₗ[ℝ] X).toPMap ⊤) (B : U →L[ℝ] X)
    (C : X →L[ℝ] Y) (hT : 0 < T) :
    (System.bounded S B C).ApproxControllable T ↔ KalmanControllable A B := by
  rw [approxControllable_bounded_iff S B C hT, kalmanControllable_iff]
  exact forall_congr' fun η => imp_congr_left
    ⟨fun h k _ => dual_of_inner_conv_eq_zero hA hT h k,
      fun h u _ => inner_conv_eq_zero_of_dual hA h T u⟩

/-- In finite dimensions, exact and approximate controllability agree (`ℛ_T(0)` is a subspace,
hence closed). -/
theorem exactlyControllable_iff_approxControllable [FiniteDimensional ℝ X]
    (sys : System U W X V Y) (hH1 : sys.H1 T) (hT : 0 < T) :
    sys.ExactlyControllable T ↔ sys.ApproxControllable T := by
  refine ⟨ExactlyControllable.approxControllable, fun h => ?_⟩
  rw [ApproxControllable, reachable_zero_eq_range hH1 hT] at h
  rw [ExactlyControllable, reachable_zero_eq_range hH1 hT]
  have hcl := (sys.ιW.comp (sys.Lop T)).range.closed_of_finiteDimensional
  rw [LinearMap.coe_range, ContinuousLinearMap.coe_coe] at hcl
  exact hcl.closure_eq.symm.trans h.closure_eq

/-- In finite dimensions, exact controllability in time `T > 0` of the matrix system
`ẋ = A x + B u` (`S.generator = A`, bounded `B`) is the Kalman condition; in particular exact
and approximate controllability agree. -/
theorem exactlyControllable_bounded_iff_kalman [FiniteDimensional ℝ X] {S : C0Semigroup ℝ X}
    {A : X →L[ℝ] X} (hA : S.generator = (A : X →ₗ[ℝ] X).toPMap ⊤) (B : U →L[ℝ] X)
    (C : X →L[ℝ] Y) (hT : 0 < T) :
    (System.bounded S B C).ExactlyControllable T ↔ KalmanControllable A B :=
  (exactlyControllable_iff_approxControllable _ (bounded_H1 S B C T) hT).trans
    (approxControllable_bounded_iff_kalman hA B C hT)

open FiniteDim in
/-- **Finite-dimensional systems are matrix systems.**  If `dim X < ∞` then `W ≅ X ≅ V`, the
generator `A` of `sys` is everywhere defined (a matrix), and there is a bounded `B ∈ L(U, X)`
(the operator `ιV⁻¹ ∘ sys.B`) such that the mild solutions of `sys` are those of the bounded
system `System.bounded sys.SX B 0`. -/
theorem exists_matrix_of_finiteDimensional [FiniteDimensional ℝ X] (sys : System U W X V Y)
    (hH1 : sys.H1 T) (hT : 0 < T) :
    ∃ (A : X →L[ℝ] X) (B : U →L[ℝ] X), sys.A = (A : X →ₗ[ℝ] X).toPMap ⊤ ∧
      ∀ (x₀ : X) (u : ℝ → U) (t : ℝ), MemLp u 2 (μI t) →
        sys.mild x₀ u t = (System.bounded sys.SX B (0 : X →L[ℝ] Y)).mild x₀ u t := by
  -- the generator is everywhere defined: a dense subspace of `X` is closed
  have hdom : sys.SX.generator.domain = ⊤ := by
    refine Submodule.coe_eq_univ.1 ?_
    exact (sys.SX.generator.domain.closed_of_finiteDimensional).closure_eq.symm.trans
      sys.SX.dense_generator_domain.closure_eq
  let A : X →L[ℝ] X := LinearMap.toContinuousLinearMap
    (sys.SX.generator.toFun.comp (LinearEquiv.ofTop _ hdom).symm.toLinearMap)
  have hA : sys.A = (A : X →ₗ[ℝ] X).toPMap ⊤ := by
    refine LinearPMap.ext hdom fun x hx _ => ?_
    rfl
  -- `ιV : X → V` is onto: its range is finite-dimensional, hence closed, and dense
  have hsurj : sys.ιV.range = ⊤ := by
    refine Submodule.coe_eq_univ.1 ?_
    have hcl := sys.ιV.range.closed_of_finiteDimensional
    rw [LinearMap.coe_range, ContinuousLinearMap.coe_coe] at hcl ⊢
    exact hcl.closure_eq.symm.trans sys.ιV_denseRange.closure_eq
  let eV : X ≃L[ℝ] V := ContinuousLinearEquiv.ofBijective sys.ιV
    (LinearMap.ker_eq_bot.2 sys.ιV_injective) hsurj
  have heV : ∀ x, eV x = sys.ιV x := fun _ => rfl
  refine ⟨A, (eV.symm : V →L[ℝ] X).comp sys.B, hA, fun x₀ u t hu => ?_⟩
  rw [bounded_mild_eq, System.mild, C0Semigroup.mildSol]
  congr 1
  apply sys.ιV_injective
  rw [← ιWV_apply, ιWV_L hH1 hT hu, convV, ← heV, ← ContinuousLinearEquiv.integral_comp_comm]
  refine integral_congr_ae (Eventually.of_forall fun r => ?_)
  simp only [heV, ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, ιV_SX]
  rw [← heV, ContinuousLinearEquiv.apply_symm_apply]

open FiniteDim in
/-- **Finite-dimensional sufficiency of persistency of excitation**
(`prop:finite-pe-sufficient`): suppose `dim X = N < ∞`, `hyp:H1` holds and `(A, B)` is
controllable (here: approximately controllable in time `T`, equivalent to the Kalman condition
and to exact controllability by `approxControllable_bounded_iff_kalman`,
`exists_matrix_of_finiteDimensional`).  If `ū ∈ L²(I; U)` is persistently exciting of order
`N + 1` on `I = (0, T)`, then for every initial state `x̄₀ ∈ X` the record `(ū, x̄)`,
`x̄ = x(·; x̄₀, ū)`, is informative (in `U × X`). -/
theorem informative_of_persistentlyExciting [FiniteDimensional ℝ X] {sys : System U W X V Y}
    (hH1 : sys.H1 T) (hT : 0 < T) (hc : sys.ApproxControllable T) {u : ℝ → U}
    (hu : MemLp u 2 (μI T)) (hpe : PersistentlyExciting T (Module.finrank ℝ X + 1) u) (x₀ : X) :
    Informative T u (sys.mild x₀ u) := by
  obtain ⟨A, B, hA, hmild⟩ := exists_matrix_of_finiteDimensional sys hH1 hT
  set sb := System.bounded sys.SX B (0 : X →L[ℝ] Y) with hsb
  -- controllability transfers to the matrix system, hence the Kalman condition
  have hcb : sb.ApproxControllable T := by
    have e : sb.reachable T 0 = sys.reachable T 0 := by
      ext y
      simp only [reachable, Set.mem_ofPred_eq]
      exact exists_congr fun v => and_congr_right fun hv => by rw [hmild 0 v T hv]
    rw [ApproxControllable, e]
    exact hc
  have hK := (approxControllable_bounded_iff_kalman hA B 0 hT).1 hcb
  -- the record of `sys` is that of the matrix system on the window
  set x := sb.mild x₀ u with hx
  have hxe : x =ᵐ[μI T] sys.mild x₀ u :=
    (ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall fun t ht =>
      (hmild x₀ u t (memLp_μI_of_le hu ht.2)).symm)
  refine Informative.congr ?_ (EventuallyEq.refl _ _) hxe
  rw [informative_iff]
  intro α β hab
  have hw : HasWeakDeriv T x (fun t => A (x t) + B (u t)) :=
    hasWeakDeriv_bounded_mild hA B (0 : X →L[ℝ] Y) hu x₀
  have hui : Integrable u (μI T) := hu.integrable one_le_two
  have hxi : Integrable x (μI T) := hw.integrable
  -- `eq:finite-suff-annihilator` and the dynamics, tested against every `φ ∈ 𝒟(I)`
  have hrel : ∀ φ, IsTestFunction T φ →
      ∑ i ∈ Finset.range (Module.finrank ℝ X + 1), ⟪zeta A B α β i, derivMoment i u φ⟫_ℝ = 0 := by
    intro φ hφ
    refine sum_inner_zeta (Xs := fun j => derivMoment j x φ) (Us := fun j => derivMoment j u φ)
      (fun j => ?_) (fun j => ?_)
    · rw [hw.derivMoment_succ hφ j, derivMoment_add hφ (A.integrable_comp hxi)
        (B.integrable_comp hui), A.map_derivMoment hφ hxi, B.map_derivMoment hφ hui]
    · have e : ⟪α, derivMoment j u φ⟫_ℝ + ⟪β, derivMoment j x φ⟫_ℝ =
          derivMoment j (fun t => ⟪α, u t⟫_ℝ + ⟪β, x t⟫_ℝ) φ := by
        rw [inner_derivMoment α hφ hui, inner_derivMoment β hφ hxi, derivMoment_add hφ]
        · simpa only [innerSL_apply_apply] using (innerSL ℝ α).integrable_comp hui
        · simpa only [innerSL_apply_apply] using (innerSL ℝ β).integrable_comp hxi
      rw [e, derivMoment_congr_ae hφ (g := fun _ => (0 : ℝ)) hab]
      simp [derivMoment]
  -- persistency of excitation of order `N + 1` kills the coefficients
  have hζ := hpe (fun i => zeta A B α β i) fun φ hφ => by
    rw [Fin.sum_univ_eq_sum_range (fun i => ⟪zeta A B α β i, derivMoment i u φ⟫_ℝ)]
    exact hrel φ hφ
  have hz : ∀ i ≤ Module.finrank ℝ X, zeta A B α β i = 0 := fun i hi =>
    congrFun hζ ⟨i, by omega⟩
  obtain ⟨hα, hβ⟩ := eq_zero_of_zeta_eq_zero hz
  exact ⟨hα, kalmanControllable_iff.1 hK β hβ⟩

end System

end DataDrivenControl
