module

public import DataDrivenControl.Semigroup.Inhomogeneous
public import DataDrivenControl.System.Controllability

/-!
# Bounded perturbations

Used by `prop:infinite-pe-insufficient` (`A = A₀ + b ⊗ b = A₀ + B K` with `K x = ⟪b, x⟫`).

## Main declarations

* `C0Semigroup.perturb S P`: the semigroup generated by `A + P` for bounded `P`, characterised
  by the variation-of-constants (Duhamel) equation `perturb_real_apply` and chosen from
  `exists_perturb`; `generator_perturb`: its generator is `P +ᵥ A` (domain `D(A)`);
* feedback, for bounded `B` and `K`: `mild_perturb_iff` (the trajectories of
  `(A + B K, B)` with input `u` are those of `(A, B)` with input `u + K x`),
  `reachable_perturb` and `approxControllable_perturb_iff` (feedback invariance of `im L_T`).

## Proofs

* Existence: the **Dyson–Phillips series** `T(t) x = ∑ₖ Vₖ(t) x`, `V₀(t) = S(t)`,
  `Vₖ₊₁(t) x = ∫₀ᵗ S(t - r) P Vₖ(r) x dr` (`dysonPhillips`, `dysonSum`), with
  `‖Vₖ(t)‖ ≤ M (M ‖P‖ t)ᵏ / k!`; the semigroup law follows from uniqueness for the Volterra
  equation `D(t) = ∫₀ᵗ S(t - r) P D(r) dr` (`eq_zero_of_volterra`).
* Generator: `h⁻¹ ∫₀ʰ S(h - r) P T(r) x dr → P x` (`tendsto_inv_smul_conv`).
* Feedback: the perturbed mild solution is a weak solution of the feedback equation, because
  `A† + P† ⊆ (A + P)†` (`exists_adjoint_perturb`), hence its mild solution by Ball's theorem
  (`Semigroup/Inhomogeneous`); conversely by Volterra uniqueness.
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped NNReal InnerProductSpace Nat

noncomputable section

namespace DataDrivenControl

namespace C0Semigroup

variable {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]

variable (S : C0Semigroup ℝ X)

/-! ### Volterra estimates -/

omit [CompleteSpace X] in
/-- If `‖f r‖ ≤ K c (K r)ᵏ / k!` on `(0, t]`, then `‖∫₀ᵗ f‖ ≤ c (K t)ᵏ⁺¹ / (k + 1)!`. -/
theorem norm_integral_le_pow_div_factorial {f : ℝ → X} {t c K : ℝ} (ht : 0 ≤ t) (k : ℕ)
    (hf : ∀ r ∈ Ioc 0 t, ‖f r‖ ≤ K * (c * ((K * r) ^ k / k !))) :
    ‖∫ r in Ioc 0 t, f r‖ ≤ c * ((K * t) ^ (k + 1) / (k + 1)!) := by
  have hcont : Continuous fun r : ℝ => K * (c * ((K * r) ^ k / k !)) := by fun_prop
  refine (norm_integral_le_of_norm_le (hcont.integrableOn_Icc.mono_set Ioc_subset_Icc_self)
    ((ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall hf))).trans_eq ?_
  rw [← intervalIntegral.integral_of_le ht]
  have e : (fun r : ℝ => K * (c * ((K * r) ^ k / k !))) =
      fun r => (K ^ (k + 1) * c / k !) * r ^ k := by
    funext r; ring
  rw [e, intervalIntegral.integral_const_mul, integral_pow, Nat.factorial_succ]
  push_cast
  field_simp
  ring

omit [CompleteSpace X] in
/-- `‖S(t - r) P y‖ ≤ M ‖P‖ b` for `‖y‖ ≤ b`, `0 < r` and `t ≤ τ`. -/
theorem norm_real_sub_apply_le {τ M : ℝ} (hM0 : 0 ≤ M) (hM : ∀ s, s ≤ τ → ‖S.real s‖ ≤ M)
    (P : X →L[ℝ] X) {t r : ℝ} (ht : t ≤ τ) (hr : 0 < r) {y : X} {b : ℝ} (hy : ‖y‖ ≤ b) :
    ‖S.real (t - r) (P y)‖ ≤ M * ‖P‖ * b := by
  calc ‖S.real (t - r) (P y)‖ ≤ M * ‖P y‖ :=
        ((S.real (t - r)).le_opNorm _).trans
          (mul_le_mul_of_nonneg_right (hM _ (by linarith)) (norm_nonneg _))
    _ ≤ M * (‖P‖ * b) := mul_le_mul_of_nonneg_left
        ((P.le_opNorm y).trans (mul_le_mul_of_nonneg_left hy (norm_nonneg _))) hM0
    _ = M * ‖P‖ * b := by ring

omit [CompleteSpace X] in
theorem mul_pow_div_factorial_mono {K r t c : ℝ} (hK : 0 ≤ K) (hr : 0 ≤ r) (hrt : r ≤ t)
    (hc : 0 ≤ c) (k : ℕ) : c * ((K * r) ^ k / k !) ≤ c * ((K * t) ^ k / k !) :=
  mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right
    (pow_le_pow_left₀ (mul_nonneg hK hr) (mul_le_mul_of_nonneg_left hrt hK) k) (by positivity)) hc

/-- **Uniqueness for the Volterra equation** `D t = ∫₀ᵗ S(t - r) P D(r) dr`: a solution that is
continuous on `[0, τ]` vanishes there. -/
theorem eq_zero_of_volterra (P : X →L[ℝ] X) {τ : ℝ} {D : ℝ → X}
    (hD : ContinuousOn D (Icc 0 τ))
    (h : ∀ t ∈ Icc 0 τ, D t = ∫ r in Ioc 0 t, S.real (t - r) (P (D r))) :
    ∀ t ∈ Icc 0 τ, D t = 0 := by
  obtain ⟨M, hM0, hM⟩ := S.exists_norm_real_le τ
  obtain ⟨c, hc⟩ := isCompact_Icc.exists_bound_of_continuousOn hD
  have key : ∀ k : ℕ, ∀ t ∈ Icc 0 τ, ‖D t‖ ≤ c * ((M * ‖P‖ * t) ^ k / k !) := by
    intro k
    induction k with
    | zero => intro t ht; simpa using hc t ht
    | succ k ih =>
      intro t ht
      rw [h t ht]
      exact norm_integral_le_pow_div_factorial ht.1 k fun r hr =>
        S.norm_real_sub_apply_le hM0 hM P ht.2 hr.1 (ih r ⟨hr.1.le, hr.2.trans ht.2⟩)
  intro t ht
  have hlim : Tendsto (fun k : ℕ => c * ((M * ‖P‖ * t) ^ k / k !)) atTop (𝓝 0) := by
    simpa using (FloorSemiring.tendsto_pow_div_factorial_atTop (M * ‖P‖ * t)).const_mul c
  exact norm_le_zero_iff.1 (ge_of_tendsto' hlim fun k => key k t ht)

/-- Splitting the convolution at time `s`:
`∫₀^{s+t} S(s + t - r) f r dr = S(t) ∫₀ˢ S(s - r) f r dr + ∫₀ᵗ S(t - r) f (s + r) dr`. -/
theorem integral_conv_add_time {f : ℝ → X} {s t : ℝ} (hs : 0 ≤ s) (ht : 0 ≤ t)
    (hf : IntegrableOn f (Ioc 0 (s + t))) :
    ∫ r in Ioc 0 (s + t), S.real (s + t - r) (f r) =
      S.real t (∫ r in Ioc 0 s, S.real (s - r) (f r)) +
        ∫ r in Ioc 0 t, S.real (t - r) (f (s + r)) := by
  have hint := S.integrableOn_conv hf
  have hst : s ≤ s + t := le_add_of_nonneg_right ht
  rw [← Ioc_union_Ioc_eq_Ioc hs hst, setIntegral_union (Ioc_disjoint_Ioc_of_le le_rfl)
    measurableSet_Ioc (hint.mono_set (Ioc_subset_Ioc_right hst))
    (hint.mono_set (Ioc_subset_Ioc_left hs))]
  congr 1
  · rw [← ContinuousLinearMap.integral_comp_comm _
      (S.integrableOn_conv (hf.mono_set (Ioc_subset_Ioc_right hst)))]
    refine setIntegral_congr_fun measurableSet_Ioc fun r hr => ?_
    rw [← S.real_add_apply ht (by linarith [hr.2] : 0 ≤ s - r)]
    congr 2
    ring
  · rw [← setIntegral_comp_add (fun r => S.real (s + t - r) (f r)) s t]
    refine setIntegral_congr_fun measurableSet_Ioc fun r _ => ?_
    congr 2
    ring

/-- `h⁻¹ ∫₀ʰ S(h - r) f r dr → f 0` as `h → 0⁺`, for continuous `f`. -/
theorem tendsto_inv_smul_conv {f : ℝ → X} (hf : Continuous f) :
    Tendsto (fun h => h⁻¹ • ∫ r in Ioc 0 h, S.real (h - r) (f r)) (𝓝[>] 0) (𝓝 (f 0)) := by
  have hG : Continuous fun p : ℝ × ℝ => S.real (p.1 - p.2) (f p.2) :=
    S.continuous_real_apply₂.comp
      ((continuous_fst.sub continuous_snd).prodMk (hf.comp continuous_snd))
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε hε
  obtain ⟨δ, hδ, hδε⟩ := Metric.continuousAt_iff.1
    (hG.continuousAt (x := ((0 : ℝ), (0 : ℝ)))) (ε / 2) (by positivity)
  refine ⟨δ, hδ, fun {h} hh hdist => ?_⟩
  have h0 : 0 < h := hh
  have hhδ : h < δ := by simpa [Real.dist_eq, abs_of_pos h0] using hdist
  have hbound : ∀ r ∈ Ioc 0 h, ‖S.real (h - r) (f r) - f 0‖ ≤ ε / 2 := by
    intro r hr
    have hd : dist (h, r) ((0 : ℝ), (0 : ℝ)) < δ := by
      rw [Prod.dist_eq, max_lt_iff]
      constructor
      · rw [Real.dist_eq, sub_zero, abs_of_pos h0]; exact hhδ
      · rw [Real.dist_eq, sub_zero, abs_of_pos hr.1]; linarith [hr.2]
    have := hδε hd
    simp only [sub_zero, real_zero, one_apply_eq_self, dist_eq_norm] at this
    exact this.le
  have hint : IntegrableOn (fun r => S.real (h - r) (f r)) (Ioc 0 h) :=
    S.integrableOn_conv (hf.integrableOn_Icc.mono_set Ioc_subset_Icc_self)
  have hc : IntegrableOn (fun _ : ℝ => f 0) (Ioc 0 h) :=
    (continuous_const.integrableOn_Icc (μ := volume)).mono_set Ioc_subset_Icc_self
  have e1 : h⁻¹ • (∫ r in Ioc 0 h, S.real (h - r) (f r)) - f 0 =
      h⁻¹ • ∫ r in Ioc 0 h, (S.real (h - r) (f r) - f 0) := by
    rw [integral_sub hint hc, setIntegral_const, Real.volume_real_Ioc_of_le h0.le, sub_zero,
      smul_sub, smul_smul, inv_mul_cancel₀ h0.ne', one_smul]
  rw [dist_eq_norm, e1, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 h0.le)]
  have h2 := norm_setIntegral_le_of_norm_le_const (μ := volume) measure_Ioc_lt_top hbound
  rw [Real.volume_real_Ioc_of_le h0.le, sub_zero] at h2
  calc h⁻¹ * ‖∫ r in Ioc 0 h, (S.real (h - r) (f r) - f 0)‖ ≤ h⁻¹ * (ε / 2 * h) :=
        mul_le_mul_of_nonneg_left h2 (inv_nonneg.2 h0.le)
    _ = ε / 2 := by field_simp
    _ < ε := by linarith

/-! ### The Dyson–Phillips series -/

/-- The **Dyson–Phillips terms** `V₀(t) x = S(t) x`, `Vₖ₊₁(t) x = ∫₀ᵗ S(t - r) P Vₖ(r) x dr`. -/
def dysonPhillips (P : X →L[ℝ] X) : ℕ → ℝ → X → X
  | 0, t, x => S.real t x
  | k + 1, t, x => ∫ r in Ioc 0 t, S.real (t - r) (P (dysonPhillips P k r x))

omit [CompleteSpace X] in
theorem dysonPhillips_zero (P : X →L[ℝ] X) (t : ℝ) (x : X) :
    S.dysonPhillips P 0 t x = S.real t x := rfl

omit [CompleteSpace X] in
theorem dysonPhillips_succ (P : X →L[ℝ] X) (k : ℕ) (t : ℝ) (x : X) :
    S.dysonPhillips P (k + 1) t x =
      ∫ r in Ioc 0 t, S.real (t - r) (P (S.dysonPhillips P k r x)) := rfl

theorem continuousOn_dysonPhillips (P : X →L[ℝ] X) (k : ℕ) (x : X) (τ : ℝ) :
    ContinuousOn (fun t => S.dysonPhillips P k t x) (Icc 0 τ) := by
  induction k generalizing τ with
  | zero => exact (S.continuous_real_apply x).continuousOn
  | succ k ih =>
    simp only [dysonPhillips_succ]
    exact S.continuousOn_conv
      ((P.continuous.comp_continuousOn (ih τ)).integrableOn_Icc.mono_set Ioc_subset_Icc_self)

theorem integrableOn_dysonPhillips (P : X →L[ℝ] X) (k : ℕ) (x : X) (t : ℝ) :
    IntegrableOn (fun r => S.real (t - r) (P (S.dysonPhillips P k r x))) (Ioc 0 t) :=
  S.integrableOn_conv ((P.continuous.comp_continuousOn
    (S.continuousOn_dysonPhillips P k x t)).integrableOn_Icc.mono_set Ioc_subset_Icc_self)

omit [CompleteSpace X] in
/-- `‖Vₖ(t) x‖ ≤ M ‖x‖ (M ‖P‖ t)ᵏ / k!` on `[0, τ]`, where `‖S(s)‖ ≤ M` for `s ≤ τ`. -/
theorem norm_dysonPhillips_le (P : X →L[ℝ] X) {τ M : ℝ} (hM0 : 0 ≤ M)
    (hM : ∀ s, s ≤ τ → ‖S.real s‖ ≤ M) (k : ℕ) (x : X) :
    ∀ t ∈ Icc 0 τ, ‖S.dysonPhillips P k t x‖ ≤ M * ‖x‖ * ((M * ‖P‖ * t) ^ k / k !) := by
  induction k with
  | zero =>
    intro t ht
    simpa [dysonPhillips_zero] using ((S.real t).le_opNorm x).trans
      (mul_le_mul_of_nonneg_right (hM t ht.2) (norm_nonneg _))
  | succ k ih =>
    intro t ht
    rw [dysonPhillips_succ]
    exact norm_integral_le_pow_div_factorial ht.1 k fun r hr =>
      S.norm_real_sub_apply_le hM0 hM P ht.2 hr.1 (ih r ⟨hr.1.le, hr.2.trans ht.2⟩)

theorem dysonPhillips_add (P : X →L[ℝ] X) (k : ℕ) (t : ℝ) (x y : X) :
    S.dysonPhillips P k t (x + y) = S.dysonPhillips P k t x + S.dysonPhillips P k t y := by
  induction k generalizing t with
  | zero => simp only [dysonPhillips_zero, map_add]
  | succ k ih =>
    simp only [dysonPhillips_succ, ih, map_add]
    exact integral_add (S.integrableOn_dysonPhillips P k x t)
      (S.integrableOn_dysonPhillips P k y t)

omit [CompleteSpace X] in
theorem dysonPhillips_smul (P : X →L[ℝ] X) (k : ℕ) (t c : ℝ) (x : X) :
    S.dysonPhillips P k t (c • x) = c • S.dysonPhillips P k t x := by
  induction k generalizing t with
  | zero => simp only [dysonPhillips_zero, map_smul]
  | succ k ih =>
    simp only [dysonPhillips_succ, ih, map_smul]
    exact integral_smul c _

theorem summable_dysonPhillips (P : X →L[ℝ] X) {t : ℝ} (ht : 0 ≤ t) (x : X) :
    Summable fun k => S.dysonPhillips P k t x := by
  obtain ⟨M, hM0, hM⟩ := S.exists_norm_real_le t
  exact ((Real.summable_pow_div_factorial (M * ‖P‖ * t)).mul_left (M * ‖x‖)).of_norm_bounded
    fun k => S.norm_dysonPhillips_le P hM0 hM k x t ⟨ht, le_rfl⟩

/-- The perturbed orbit `t ↦ ∑ₖ Vₖ(t) x` (Dyson–Phillips series). -/
def dysonSum (P : X →L[ℝ] X) (t : ℝ) (x : X) : X := ∑' k, S.dysonPhillips P k t x

theorem dysonSum_add (P : X →L[ℝ] X) {t : ℝ} (ht : 0 ≤ t) (x y : X) :
    S.dysonSum P t (x + y) = S.dysonSum P t x + S.dysonSum P t y := by
  simp only [dysonSum, dysonPhillips_add]
  exact (S.summable_dysonPhillips P ht x).tsum_add (S.summable_dysonPhillips P ht y)

theorem dysonSum_smul (P : X →L[ℝ] X) {t : ℝ} (ht : 0 ≤ t) (c : ℝ) (x : X) :
    S.dysonSum P t (c • x) = c • S.dysonSum P t x := by
  simp only [dysonSum, dysonPhillips_smul]
  exact ((S.summable_dysonPhillips P ht x).hasSum.const_smul c).tsum_eq

theorem exists_norm_dysonSum_le (P : X →L[ℝ] X) {t : ℝ} (ht : 0 ≤ t) :
    ∃ C, ∀ x, ‖S.dysonSum P t x‖ ≤ C * ‖x‖ := by
  obtain ⟨M, hM0, hM⟩ := S.exists_norm_real_le t
  refine ⟨M * ∑' k : ℕ, (M * ‖P‖ * t) ^ k / k !, fun x => ?_⟩
  refine tsum_of_norm_bounded ?_ fun k => S.norm_dysonPhillips_le P hM0 hM k x t ⟨ht, le_rfl⟩
  have := (Real.summable_pow_div_factorial (M * ‖P‖ * t)).hasSum.mul_left (M * ‖x‖)
  convert this using 1
  ring

omit [CompleteSpace X] in
theorem dysonSum_zero (P : X →L[ℝ] X) (x : X) : S.dysonSum P 0 x = x := by
  rw [dysonSum, tsum_eq_single 0 fun k hk => ?_]
  · simp [dysonPhillips_zero]
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk
    simp [dysonPhillips_succ]

theorem continuousOn_dysonSum (P : X →L[ℝ] X) (x : X) (τ : ℝ) :
    ContinuousOn (fun t => S.dysonSum P t x) (Icc 0 τ) := by
  obtain ⟨M, hM0, hM⟩ := S.exists_norm_real_le τ
  refine continuousOn_tsum (fun k => S.continuousOn_dysonPhillips P k x τ)
    ((Real.summable_pow_div_factorial (M * ‖P‖ * τ)).mul_left (M * ‖x‖)) fun k t ht => ?_
  exact (S.norm_dysonPhillips_le P hM0 hM k x t ht).trans
    (mul_pow_div_factorial_mono (mul_nonneg hM0 (norm_nonneg _)) ht.1 ht.2
      (mul_nonneg hM0 (norm_nonneg _)) k)

/-- The Dyson–Phillips series solves the Duhamel equation
`T(t) x = S(t) x + ∫₀ᵗ S(t - r) P T(r) x dr`. -/
theorem dysonSum_eq (P : X →L[ℝ] X) {t : ℝ} (ht : 0 ≤ t) (x : X) :
    S.dysonSum P t x = S.real t x + ∫ r in Ioc 0 t, S.real (t - r) (P (S.dysonSum P r x)) := by
  obtain ⟨M, hM0, hM⟩ := S.exists_norm_real_le t
  have hs := S.summable_dysonPhillips P ht x
  conv_lhs => rw [dysonSum, hs.tsum_eq_zero_add]
  congr 1
  have key : HasSum (fun k => ∫ r in Ioc 0 t, S.real (t - r) (P (S.dysonPhillips P k r x)))
      (∫ r in Ioc 0 t, S.real (t - r) (P (S.dysonSum P r x))) := by
    refine hasSum_integral_of_dominated_convergence
      (bound := fun k _ => M * ‖P‖ * (M * ‖x‖ * ((M * ‖P‖ * t) ^ k / k !)))
      (fun k => (S.integrableOn_dysonPhillips P k x t).aestronglyMeasurable)
      (fun k => ?_) (Eventually.of_forall fun _ => ?_) (integrable_const _) ?_
    · refine (ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall fun r hr => ?_)
      refine (S.norm_real_sub_apply_le hM0 hM P le_rfl hr.1
        (S.norm_dysonPhillips_le P hM0 hM k x r ⟨hr.1.le, hr.2⟩)).trans ?_
      exact mul_le_mul_of_nonneg_left (mul_pow_div_factorial_mono
        (mul_nonneg hM0 (norm_nonneg _)) hr.1.le hr.2 (mul_nonneg hM0 (norm_nonneg _)) k)
        (mul_nonneg hM0 (norm_nonneg _))
    · exact ((Real.summable_pow_div_factorial (M * ‖P‖ * t)).mul_left (M * ‖x‖)).mul_left _
    · refine (ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall fun r hr => ?_)
      exact (S.summable_dysonPhillips P hr.1.le x).hasSum.mapL ((S.real (t - r)).comp P)
  exact key.tsum_eq

/-- The semigroup law of the Dyson–Phillips series (Volterra uniqueness). -/
theorem dysonSum_add_time (P : X →L[ℝ] X) {s t : ℝ} (hs : 0 ≤ s) (ht : 0 ≤ t) (x : X) :
    S.dysonSum P (t + s) x = S.dysonSum P s (S.dysonSum P t x) := by
  have hW1 : ∀ σ, 0 ≤ σ → S.dysonSum P (t + σ) x = S.real σ (S.dysonSum P t x) +
      ∫ r in Ioc 0 σ, S.real (σ - r) (P (S.dysonSum P (t + r) x)) := by
    intro σ hσ
    have hf : IntegrableOn (fun r => P (S.dysonSum P r x)) (Ioc 0 (t + σ)) :=
      (P.continuous.comp_continuousOn (S.continuousOn_dysonSum P x (t + σ))).integrableOn_Icc.mono_set
        Ioc_subset_Icc_self
    rw [S.dysonSum_eq P (add_nonneg ht hσ) x, S.integral_conv_add_time ht hσ hf,
      S.dysonSum_eq P ht x, map_add, add_comm t σ, S.real_add_apply hσ ht]
    abel
  have hc1 : ContinuousOn (fun σ => S.dysonSum P (t + σ) x) (Icc 0 s) :=
    (S.continuousOn_dysonSum P x (t + s)).comp (continuousOn_const.add continuousOn_id)
      fun σ hσ => ⟨by linarith [hσ.1], by linarith [hσ.2]⟩
  have hD := S.eq_zero_of_volterra P
    (D := fun σ => S.dysonSum P (t + σ) x - S.dysonSum P σ (S.dysonSum P t x)) (τ := s)
    (hc1.sub (S.continuousOn_dysonSum P _ s)) (fun σ hσ => ?_) s ⟨hs, le_rfl⟩
  · exact sub_eq_zero.1 hD
  · have hi1 : IntegrableOn (fun r => S.real (σ - r) (P (S.dysonSum P (t + r) x))) (Ioc 0 σ) :=
      S.integrableOn_conv ((P.continuous.comp_continuousOn
        (hc1.mono (Icc_subset_Icc_right hσ.2))).integrableOn_Icc.mono_set Ioc_subset_Icc_self)
    have hi2 : IntegrableOn (fun r => S.real (σ - r) (P (S.dysonSum P r (S.dysonSum P t x))))
        (Ioc 0 σ) :=
      S.integrableOn_conv ((P.continuous.comp_continuousOn
        (S.continuousOn_dysonSum P _ σ)).integrableOn_Icc.mono_set Ioc_subset_Icc_self)
    rw [hW1 σ hσ.1, S.dysonSum_eq P hσ.1 (S.dysonSum P t x), add_sub_add_left_eq_sub,
      ← integral_sub hi1 hi2]
    refine setIntegral_congr_fun measurableSet_Ioc fun r _ => ?_
    simp only [map_sub]

/-- The operator `T(t) = ∑ₖ Vₖ(t)` of the perturbed semigroup. -/
def perturbOp (P : X →L[ℝ] X) (t : ℝ≥0) : X →L[ℝ] X :=
  LinearMap.mkContinuousOfExistsBound
    { toFun := S.dysonSum P t
      map_add' := S.dysonSum_add P t.2
      map_smul' := S.dysonSum_smul P t.2 }
    (S.exists_norm_dysonSum_le P t.2)

theorem perturbOp_apply (P : X →L[ℝ] X) (t : ℝ≥0) (x : X) :
    S.perturbOp P t x = S.dysonSum P t x := rfl

theorem continuous_dysonSum_nnreal (P : X →L[ℝ] X) (x : X) :
    Continuous fun t : ℝ≥0 => S.dysonSum P t x := by
  rw [continuous_iff_continuousAt]
  intro t₀
  have hmem : Icc (0 : ℝ) (t₀ + 1) ∈ 𝓝[Ici 0] (t₀ : ℝ) :=
    mem_nhdsWithin.2 ⟨Iio ((t₀ : ℝ) + 1), isOpen_Iio, by simp, fun y hy => ⟨hy.2, hy.1.le⟩⟩
  have h1 : ContinuousWithinAt (fun t => S.dysonSum P t x) (Ici 0) t₀ :=
    (S.continuousOn_dysonSum P x (t₀ + 1) t₀ ⟨t₀.2, by linarith⟩).mono_of_mem_nhdsWithin hmem
  exact (continuousWithinAt_univ _ _).1
    (h1.comp NNReal.continuous_coe.continuousWithinAt fun t _ => t.2)

-- `perturb` is defined by choice from this existence theorem.
/-- The Duhamel equation `T t x = S t x + ∫₀ᵗ S (t - r) P T r x dr` has a (unique) solution
that is a C₀-semigroup (Dyson–Phillips series). -/
theorem exists_perturb (P : X →L[ℝ] X) :
    ∃ T : C0Semigroup ℝ X, ∀ (t : ℝ) (x : X), 0 ≤ t →
      T.real t x = S.real t x + ∫ r in Ioc 0 t, S.real (t - r) (P (T.real r x)) := by
  let T : C0Semigroup ℝ X :=
    { toFun := S.perturbOp P
      map_zero' := ContinuousLinearMap.ext fun x => by
        rw [perturbOp_apply, NNReal.coe_zero, dysonSum_zero, one_apply_eq_self]
      map_add' := fun s t => ContinuousLinearMap.ext fun x => by
        rw [ContinuousLinearMap.comp_apply, perturbOp_apply, perturbOp_apply, perturbOp_apply,
          NNReal.coe_add, add_comm (s : ℝ)]
        exact S.dysonSum_add_time P s.2 t.2 x
      continuous_apply' := fun x => S.continuous_dysonSum_nnreal P x }
  have hT : ∀ t : ℝ, 0 ≤ t → ∀ x, T.real t x = S.dysonSum P t x := fun t ht x => by
    change S.perturbOp P t.toNNReal x = _
    rw [perturbOp_apply, Real.coe_toNNReal t ht]
  refine ⟨T, fun t x ht => ?_⟩
  rw [hT t ht, S.dysonSum_eq P ht x]
  congr 1
  refine setIntegral_congr_fun measurableSet_Ioc fun r hr => ?_
  simp only [hT r hr.1.le]

/-- The semigroup generated by `A + P` for bounded `P` (bounded perturbation). -/
def perturb (P : X →L[ℝ] X) : C0Semigroup ℝ X := (S.exists_perturb P).choose

/-- Variation of constants for the perturbed semigroup. -/
theorem perturb_real_apply (P : X →L[ℝ] X) {t : ℝ} (ht : 0 ≤ t) (x : X) :
    (S.perturb P).real t x =
      S.real t x + ∫ r in Ioc 0 t, S.real (t - r) (P ((S.perturb P).real r x)) :=
  (S.exists_perturb P).choose_spec t x ht

/-- The difference quotients of `S.perturb P` and `S` differ by `h⁻¹ ∫₀ʰ S(h - r) P T(r) x`,
which tends to `P x`. -/
theorem tendsto_diffQuot_perturb_sub (P : X →L[ℝ] X) (x : X) :
    Tendsto (fun h => (S.perturb P).diffQuot x h - S.diffQuot x h) (𝓝[>] 0) (𝓝 (P x)) := by
  have hc : Continuous fun r => P ((S.perturb P).real r x) :=
    P.continuous.comp ((S.perturb P).continuous_real_apply x)
  have := S.tendsto_inv_smul_conv hc
  simp only [real_zero, one_apply_eq_self] at this
  refine this.congr' (eventually_nhdsWithin_of_forall fun h hh => ?_)
  simp only [diffQuot]
  rw [S.perturb_real_apply P (le_of_lt hh) x, ← smul_sub]
  congr 1
  abel

/-- The generator of `S.perturb P` is `A + P`, with domain `D(A)`. -/
theorem generator_perturb (P : X →L[ℝ] X) :
    (S.perturb P).generator = (P : X →ₗ[ℝ] X) +ᵥ S.generator := by
  have hQ := S.tendsto_diffQuot_perturb_sub P
  have hdom : ∀ x : X, x ∈ (S.perturb P).generator.domain ↔ x ∈ S.generator.domain := by
    intro x
    constructor
    · rintro ⟨y, hy⟩
      exact ⟨y - P x, (hy.sub (hQ x)).congr fun h => by abel⟩
    · rintro ⟨y, hy⟩
      exact ⟨P x + y, ((hQ x).add hy).congr fun h => by abel⟩
  refine LinearPMap.ext (Submodule.ext hdom) fun x hx hy => ?_
  rw [LinearPMap.vadd_apply, ContinuousLinearMap.coe_coe]
  refine (S.perturb P).generator_apply_eq hx ?_
  exact ((hQ x).add (S.tendsto_generator ⟨x, hy⟩)).congr fun h => by abel

theorem generator_perturb_domain (P : X →L[ℝ] X) :
    (S.perturb P).generator.domain = S.generator.domain := by
  rw [generator_perturb]; rfl

/-- `A† + P† ⊆ (A + P)†`: every `η ∈ D(A†)` lies in the domain of the adjoint of the perturbed
generator, where it acts as `A† η + P† η`. -/
theorem exists_adjoint_perturb (P : X →L[ℝ] X) {η : X} (hη : η ∈ S.generator.adjoint.domain) :
    ∃ h : η ∈ (S.perturb P).generator.adjoint.domain,
      (S.perturb P).generator.adjoint ⟨η, h⟩ =
        S.generator.adjoint ⟨η, hη⟩ + ContinuousLinearMap.adjoint P η := by
  rw [generator_perturb]
  have hd : Dense ((((P : X →ₗ[ℝ] X) +ᵥ S.generator).domain : Set X)) :=
    S.dense_generator_domain
  have hw : ∀ x : ((P : X →ₗ[ℝ] X) +ᵥ S.generator).domain,
      ⟪S.generator.adjoint ⟨η, hη⟩ + ContinuousLinearMap.adjoint P η, (x : X)⟫_ℝ =
        ⟪η, ((P : X →ₗ[ℝ] X) +ᵥ S.generator) x⟫_ℝ := by
    intro x
    have h1 := LinearPMap.adjoint_isFormalAdjoint S.dense_generator_domain ⟨η, hη⟩ x
    rw [LinearPMap.vadd_apply, inner_add_left, inner_add_right,
      ContinuousLinearMap.adjoint_inner_left, ContinuousLinearMap.coe_coe]
    rw [h1]
    ring
  have hmem := LinearPMap.mem_adjoint_domain_of_exists η ⟨_, hw⟩
  exact ⟨hmem, LinearPMap.adjoint_apply_eq hd ⟨η, hmem⟩ hw⟩

end C0Semigroup

namespace System

variable {U X Y : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]

variable (S : C0Semigroup ℝ X) (B : U →L[ℝ] X) (K : X →L[ℝ] U) (C : X →L[ℝ] Y)

/-- For bounded systems the mild solution is `C0Semigroup.mildSol` with `f = B u`. -/
private theorem bounded_mild_eq (S : C0Semigroup ℝ X) (B : U →L[ℝ] X) (x₀ : X) (u : ℝ → U)
    (t : ℝ) : (bounded S B C).mild x₀ u t = S.mildSol x₀ (fun r => B (u r)) t := by
  rw [mild, L_eq_of_ιWV (w := ∫ r in Ioc 0 t, S.real (t - r) (B (u r))) rfl]
  rfl

/-- **Feedback** (bounded `B`, `K`): `x` is the mild solution of `(A + B K, B)` with input `u`
iff it is the mild solution of `(A, B)` with input `u + K x`. -/
theorem mild_perturb_iff {τ : ℝ} {u : ℝ → U} (hu : MemLp u 2 (μI τ)) (x₀ : X) {x : ℝ → X}
    (hx : ContinuousOn x (Icc 0 τ)) :
    (∀ t ∈ Icc 0 τ, x t = (bounded (S.perturb (B.comp K)) B C).mild x₀ u t) ↔
      ∀ t ∈ Icc 0 τ, x t = (bounded S B C).mild x₀ (fun r => u r + K (x r)) t := by
  simp only [bounded_mild_eq]
  have hBu : IntegrableOn (fun r => B (u r)) (Ioc 0 τ) :=
    B.integrable_comp (hu.integrable one_le_two)
  set z := (S.perturb (B.comp K)).mildSol x₀ (fun r => B (u r)) with hz
  have hzc : ContinuousOn z (Icc 0 τ) := (S.perturb (B.comp K)).continuousOn_mildSol hBu x₀
  have hfb : ∀ y : ℝ → X, ContinuousOn y (Icc 0 τ) →
      IntegrableOn (fun r => B (u r + K (y r))) (Ioc 0 τ) := by
    intro y hy
    simp only [map_add]
    exact hBu.add ((B.continuous.comp_continuousOn
      (K.continuous.comp_continuousOn hy)).integrableOn_Icc.mono_set Ioc_subset_Icc_self)
  -- the perturbed mild solution is the mild solution of the feedback equation (Ball)
  have hkey : ∀ t ∈ Icc 0 τ, z t = S.mildSol x₀ (fun r => B (u r + K (z r))) t := by
    have hTw := (S.perturb (B.comp K)).isWeakSol_mildSol hBu x₀
    have hSw : S.IsWeakSol τ x₀ (fun r => B (u r + K (z r))) z := by
      refine ⟨hTw.1, hTw.2.1, fun η hη t ht => ?_⟩
      obtain ⟨hη', heq⟩ := S.exists_adjoint_perturb (B.comp K) hη
      rw [hTw.2.2 η hη' t ht, heq]
      congr 1
      refine intervalIntegral.integral_congr fun s _ => ?_
      simp only [inner_add_left, map_add, inner_add_right, ContinuousLinearMap.adjoint_inner_left,
        ContinuousLinearMap.comp_apply]
      ring
    exact hSw.eq_mildSol S (hfb z hzc)
  -- uniqueness for the feedback equation (Volterra)
  have huniq : ∀ y : ℝ → X, ContinuousOn y (Icc 0 τ) →
      (∀ t ∈ Icc 0 τ, y t = S.mildSol x₀ (fun r => B (u r + K (y r))) t) →
      ∀ t ∈ Icc 0 τ, y t = z t := by
    intro y hy hyeq
    have hD := S.eq_zero_of_volterra (B.comp K) (D := fun t => y t - z t) (hy.sub hzc)
      (fun t ht => ?_)
    · exact fun t ht => sub_eq_zero.1 (hD t ht)
    · have hy' := S.integrableOn_conv ((hfb y hy).mono_set (Ioc_subset_Ioc_right ht.2))
      have hz' := S.integrableOn_conv ((hfb z hzc).mono_set (Ioc_subset_Ioc_right ht.2))
      rw [hyeq t ht, hkey t ht]
      simp only [C0Semigroup.mildSol, add_sub_add_left_eq_sub]
      rw [← integral_sub hy' hz']
      refine setIntegral_congr_fun measurableSet_Ioc fun r _ => ?_
      simp only [← map_sub, ContinuousLinearMap.comp_apply]
      congr 1
      simp only [map_add, map_sub]
      abel
  constructor
  · intro h t ht
    rw [h t ht, hkey t ht]
    simp only [C0Semigroup.mildSol]
    congr 1
    refine setIntegral_congr_fun measurableSet_Ioc fun r hr => ?_
    simp only [h r ⟨hr.1.le, hr.2.trans ht.2⟩]
  · intro h t ht
    exact huniq x hx h t ht

/-- **Feedback invariance** of the reachable set: `im L_T` is the same for `(A + B K, B)` and
`(A, B)`. -/
theorem reachable_perturb (T : ℝ) :
    (bounded (S.perturb (B.comp K)) B C).reachable T 0 = (bounded S B C).reachable T 0 := by
  rcases lt_or_ge T 0 with hT | hT
  · ext y
    simp only [reachable, Set.mem_ofPred_eq, bounded_mild_eq, C0Semigroup.mildSol, map_zero,
      Ioc_eq_empty (not_lt.2 hT.le), Measure.restrict_empty, integral_zero_measure, add_zero]
  · ext y
    constructor
    · rintro ⟨u, hu, rfl⟩
      set z := (bounded (S.perturb (B.comp K)) B C).mild 0 u with hz
      have hzc : ContinuousOn z (Icc 0 T) :=
        continuousOn_mild (bounded_H1 (S.perturb (B.comp K)) B C 1) one_pos hu 0
      have h := (mild_perturb_iff S B K C hu 0 hzc).1 (fun t _ => rfl) T ⟨hT, le_rfl⟩
      exact ⟨fun r => u r + K (z r),
        hu.add (memLp_μI_of_continuousOn (K.continuous.comp_continuousOn hzc)), h.symm⟩
    · rintro ⟨v, hv, rfl⟩
      set x := (bounded S B C).mild 0 v with hx
      have hxc : ContinuousOn x (Icc 0 T) := continuousOn_mild (bounded_H1 S B C 1) one_pos hv 0
      have hu : MemLp (fun r => v r - K (x r)) 2 (μI T) :=
        hv.sub (memLp_μI_of_continuousOn (K.continuous.comp_continuousOn hxc))
      have h := (mild_perturb_iff S B K C hu 0 hxc).2
        (fun t _ => by simp only [sub_add_cancel]; rfl) T ⟨hT, le_rfl⟩
      exact ⟨_, hu, h.symm⟩

/-- Approximate controllability is invariant under bounded feedback. -/
theorem approxControllable_perturb_iff (T : ℝ) :
    (bounded (S.perturb (B.comp K)) B C).ApproxControllable T ↔
      (bounded S B C).ApproxControllable T := by
  rw [ApproxControllable, ApproxControllable, reachable_perturb]

end System

end DataDrivenControl
