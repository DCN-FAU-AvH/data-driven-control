module

public import DataDrivenControl.Semigroup.Modal

/-!
# Block-rotation groups

Tools for the wave equation (`ex:intro-wave`, Section 1) and for the remark of Section 7 that the
wave group is not analytic.

Let `E₁`, `E₂` be real Hilbert spaces with Hilbert bases `f₁`, `f₂` indexed by the same set `ι`,
and let `ω : ι → ℝ`.  On the Hilbert product `WithLp 2 (E₁ × E₂)`, in the coordinates
`aₙ = ⟪f₁ n, x₁⟫`, `bₙ = ⟪f₂ n, x₂⟫`, the **block rotation**
`R(t) : (aₙ, bₙ) ↦ (cos(ωₙ t) aₙ + sin(ωₙ t) bₙ, -sin(ωₙ t) aₙ + cos(ωₙ t) bₙ)`
is an isometric group, strongly continuous, generated by `A (a, b) = (ω b, -ω a)`: the
first-order form of the oscillators `äₙ = -ωₙ² aₙ`.

## Main declarations

* `Rotation.pairL L₁ L₂ : G →L[ℝ] WithLp 2 (E₁ × E₂)`, `z ↦ (L₁ z, L₂ z)`;
* coordinates on the product: `ext_coord`, `exists_coord_eq`, `hasSum_coord_sq` (Parseval),
  `hasSum_inner_coord`;
* `Rotation.rotOp f₁ f₂ ω t` for every real `t`: `inner_fst_rotOp`, `inner_snd_rotOp`,
  `rotOp_zero`, `rotOp_add`, `adjoint_rotOp` (`R(t)† = R(-t)`), `tendsto_rotOp`;
* `Rotation.rotGroup f₁ f₂ ω : C0Semigroup ℝ (WithLp 2 (E₁ × E₂))` (`rotGroup_real`,
  `adjoint_rotGroup`: the adjoint semigroup is the rotation group with frequencies `-ω`);
* the generator in coordinates: `inner_fst_generator`, `inner_snd_generator`
  (`A (a, b) = (ω b, -ω a)`) and `hasSum_sq_generator` (`‖A x‖² = ∑ₙ ωₙ² (aₙ² + bₙ²)`);
* **`not_isAnalytic`**: the group is not analytic as soon as some `y ∈ E₁` has
  `∑ₙ (ωₙ ⟪f₁ n, y⟫)² = ∞`: `R(1)` is onto, so it maps some vector outside `D(A)`, while an
  analytic semigroup maps into `D(A)` at positive times;
* `Rotation.blockDiag`: the diagonal map `(x₁, x₂) ↦ (D x₁, D x₂)` into another product with
  Hilbert bases, with the same multiplier on both components (`inner_fst_blockDiag`,
  `inner_snd_blockDiag`, `injective_blockDiag`, `denseRange_blockDiag`), consistent with the
  rotation groups of the same frequencies (`consistent_blockDiag`).
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped NNReal InnerProductSpace

noncomputable section

set_option linter.unusedSectionVars false

namespace DataDrivenControl

namespace Rotation

open Diagonal

variable {ι E₁ E₂ : Type*} [NormedAddCommGroup E₁] [InnerProductSpace ℝ E₁]
  [NormedAddCommGroup E₂] [InnerProductSpace ℝ E₂]

/-! ### Maps into the product -/

section Pair

variable {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]

/-- The bounded map `z ↦ (L₁ z, L₂ z)` into the Hilbert product `WithLp 2 (E₁ × E₂)`. -/
def pairL (L₁ : G →L[ℝ] E₁) (L₂ : G →L[ℝ] E₂) : G →L[ℝ] WithLp 2 (E₁ × E₂) :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ E₁ E₂).symm.toContinuousLinearMap ∘L L₁.prod L₂

@[simp] theorem pairL_fst (L₁ : G →L[ℝ] E₁) (L₂ : G →L[ℝ] E₂) (z : G) :
    (pairL L₁ L₂ z).fst = L₁ z := rfl

@[simp] theorem pairL_snd (L₁ : G →L[ℝ] E₁) (L₂ : G →L[ℝ] E₂) (z : G) :
    (pairL L₁ L₂ z).snd = L₂ z := rfl

end Pair

/-! ### Coordinates on the product -/

section Coord

variable (f₁ : HilbertBasis ι ℝ E₁) (f₂ : HilbertBasis ι ℝ E₂)

/-- Elements of the product are determined by their coordinates `aₙ = ⟪f₁ n, x₁⟫` and
`bₙ = ⟪f₂ n, x₂⟫`. -/
theorem ext_coord {x y : WithLp 2 (E₁ × E₂)} (h₁ : ∀ n, ⟪f₁ n, x.fst⟫_ℝ = ⟪f₁ n, y.fst⟫_ℝ)
    (h₂ : ∀ n, ⟪f₂ n, x.snd⟫_ℝ = ⟪f₂ n, y.snd⟫_ℝ) : x = y :=
  (WithLp.ext_iff 2).2 (Prod.ext (ext_inner f₁ h₁) (ext_inner f₂ h₂))

/-- Every pair of square-summable coordinate sequences comes from a vector. -/
theorem exists_coord_eq (a b : ι → ℝ) (ha : Summable fun n => a n ^ 2)
    (hb : Summable fun n => b n ^ 2) :
    ∃ x : WithLp 2 (E₁ × E₂), ∀ n, ⟪f₁ n, x.fst⟫_ℝ = a n ∧ ⟪f₂ n, x.snd⟫_ℝ = b n := by
  obtain ⟨y₁, hy₁⟩ := exists_inner_eq f₁ a ha
  obtain ⟨y₂, hy₂⟩ := exists_inner_eq f₂ b hb
  exact ⟨WithLp.toLp 2 (y₁, y₂), fun n => ⟨hy₁ n, hy₂ n⟩⟩

/-- Parseval on the product: `‖x‖² = ∑ₙ (aₙ² + bₙ²)`. -/
theorem hasSum_coord_sq (x : WithLp 2 (E₁ × E₂)) :
    HasSum (fun n => ⟪f₁ n, x.fst⟫_ℝ ^ 2 + ⟪f₂ n, x.snd⟫_ℝ ^ 2) (‖x‖ ^ 2) := by
  rw [WithLp.prod_norm_sq_eq_of_L2]
  exact (hasSum_inner_sq f₁ x.fst).add (hasSum_inner_sq f₂ x.snd)

/-- Parseval for the inner product: `⟪x, y⟫ = ∑ₙ (aₙ aₙ' + bₙ bₙ')`. -/
theorem hasSum_inner_coord (x y : WithLp 2 (E₁ × E₂)) :
    HasSum (fun n => ⟪f₁ n, x.fst⟫_ℝ * ⟪f₁ n, y.fst⟫_ℝ + ⟪f₂ n, x.snd⟫_ℝ * ⟪f₂ n, y.snd⟫_ℝ)
      ⟪x, y⟫_ℝ := by
  rw [WithLp.prod_inner_apply]
  convert (f₁.hasSum_inner_mul_inner x.fst y.fst).add
    (f₂.hasSum_inner_mul_inner x.snd y.snd) using 1
  funext n
  rw [real_inner_comm (f₁ n) x.fst, real_inner_comm (f₂ n) x.snd]
  rfl

end Coord

/-! ### The block rotation -/

section Rot

variable (f₁ : HilbertBasis ι ℝ E₁) (f₂ : HilbertBasis ι ℝ E₂) (ω : ι → ℝ)

theorem abs_cos_mul_le (t : ℝ) (n : ι) : |Real.cos (ω n * t)| ≤ 1 := Real.abs_cos_le_one _

theorem abs_sin_mul_le (t : ℝ) (n : ι) : |Real.sin (ω n * t)| ≤ 1 := Real.abs_sin_le_one _

theorem abs_neg_sin_mul_le (t : ℝ) (n : ι) : |-Real.sin (ω n * t)| ≤ 1 := by
  rw [abs_neg]; exact Real.abs_sin_le_one _

/-- The **block rotation** `R(t)`: in the coordinates `aₙ = ⟪f₁ n, x₁⟫`, `bₙ = ⟪f₂ n, x₂⟫`,
`(aₙ, bₙ) ↦ (cos(ωₙ t) aₙ + sin(ωₙ t) bₙ, -sin(ωₙ t) aₙ + cos(ωₙ t) bₙ)`. -/
def rotOp (t : ℝ) : WithLp 2 (E₁ × E₂) →L[ℝ] WithLp 2 (E₁ × E₂) :=
  pairL
    (diagMap f₁ f₁ (fun n => Real.cos (ω n * t)) 1 (abs_cos_mul_le ω t) ∘L
        WithLp.fstL 2 ℝ E₁ E₂ +
      diagMap f₂ f₁ (fun n => Real.sin (ω n * t)) 1 (abs_sin_mul_le ω t) ∘L
        WithLp.sndL 2 ℝ E₁ E₂)
    (diagMap f₁ f₂ (fun n => -Real.sin (ω n * t)) 1 (abs_neg_sin_mul_le ω t) ∘L
        WithLp.fstL 2 ℝ E₁ E₂ +
      diagMap f₂ f₂ (fun n => Real.cos (ω n * t)) 1 (abs_cos_mul_le ω t) ∘L
        WithLp.sndL 2 ℝ E₁ E₂)

/-- First coordinates of the rotation: `cos(ωₙ t) aₙ + sin(ωₙ t) bₙ`. -/
theorem inner_fst_rotOp (t : ℝ) (x : WithLp 2 (E₁ × E₂)) (n : ι) :
    ⟪f₁ n, (rotOp f₁ f₂ ω t x).fst⟫_ℝ =
      Real.cos (ω n * t) * ⟪f₁ n, x.fst⟫_ℝ + Real.sin (ω n * t) * ⟪f₂ n, x.snd⟫_ℝ := by
  simp only [rotOp, pairL_fst, add_apply, ContinuousLinearMap.comp_apply,
    WithLp.fstL_apply, WithLp.sndL_apply, inner_add_right, inner_diagMap]

/-- Second coordinates of the rotation: `-sin(ωₙ t) aₙ + cos(ωₙ t) bₙ`. -/
theorem inner_snd_rotOp (t : ℝ) (x : WithLp 2 (E₁ × E₂)) (n : ι) :
    ⟪f₂ n, (rotOp f₁ f₂ ω t x).snd⟫_ℝ =
      -Real.sin (ω n * t) * ⟪f₁ n, x.fst⟫_ℝ + Real.cos (ω n * t) * ⟪f₂ n, x.snd⟫_ℝ := by
  simp only [rotOp, pairL_snd, add_apply, ContinuousLinearMap.comp_apply,
    WithLp.fstL_apply, WithLp.sndL_apply, inner_add_right, inner_diagMap]

/-- `R(0) = 1`. -/
theorem rotOp_zero : rotOp f₁ f₂ ω 0 = 1 := by
  ext x : 1
  refine ext_coord f₁ f₂ (fun n => ?_) fun n => ?_
  · simp [inner_fst_rotOp]
  · simp [inner_snd_rotOp]

/-- The group law `R(s + t) = R(s) R(t)`. -/
theorem rotOp_add (s t : ℝ) :
    rotOp f₁ f₂ ω (s + t) = (rotOp f₁ f₂ ω s).comp (rotOp f₁ f₂ ω t) := by
  ext x : 1
  refine ext_coord f₁ f₂ (fun n => ?_) fun n => ?_
  · simp only [ContinuousLinearMap.comp_apply, inner_fst_rotOp, inner_snd_rotOp, mul_add,
      Real.cos_add, Real.sin_add]
    ring
  · simp only [ContinuousLinearMap.comp_apply, inner_fst_rotOp, inner_snd_rotOp, mul_add,
      Real.cos_add, Real.sin_add]
    ring

/-- `R(t) R(-t) = 1`. -/
theorem rotOp_apply_neg (t : ℝ) (x : WithLp 2 (E₁ × E₂)) :
    rotOp f₁ f₂ ω t (rotOp f₁ f₂ ω (-t) x) = x := by
  rw [← ContinuousLinearMap.comp_apply, ← rotOp_add, add_neg_cancel, rotOp_zero,
    one_apply_eq_self]

/-- `R(t)† = R(-t)`. -/
theorem adjoint_rotOp [CompleteSpace E₁] [CompleteSpace E₂] (t : ℝ) :
    ContinuousLinearMap.adjoint (rotOp f₁ f₂ ω t) = rotOp f₁ f₂ ω (-t) := by
  refine ContinuousLinearMap.ext fun y => ext_inner_right ℝ fun x => ?_
  rw [ContinuousLinearMap.adjoint_inner_left]
  refine (hasSum_inner_coord f₁ f₂ y (rotOp f₁ f₂ ω t x)).unique ?_
  convert hasSum_inner_coord f₁ f₂ (rotOp f₁ f₂ ω (-t) y) x using 1
  funext n
  simp only [inner_fst_rotOp, inner_snd_rotOp, mul_neg, Real.cos_neg, Real.sin_neg]
  ring

/-- Reversing the frequencies reverses time: `R_{-ω}(t) = R_ω(-t)`. -/
theorem rotOp_neg_freq (t : ℝ) : rotOp f₁ f₂ (fun n => -ω n) t = rotOp f₁ f₂ ω (-t) := by
  ext x : 1
  refine ext_coord f₁ f₂ (fun n => ?_) fun n => ?_ <;>
    simp only [inner_fst_rotOp, inner_snd_rotOp, neg_mul, mul_neg]

private theorem sq_add_le_aux (C S a b : ℝ) (hC : C ^ 2 ≤ 4) (hS : S ^ 2 ≤ 4) :
    (C * a + S * b) ^ 2 ≤ 8 * (a ^ 2 + b ^ 2) := by
  nlinarith [sq_nonneg (C * a - S * b), mul_le_mul_of_nonneg_right hC (sq_nonneg a),
    mul_le_mul_of_nonneg_right hS (sq_nonneg b)]

private theorem sq_cos_sub_one_le (x : ℝ) : (Real.cos x - 1) ^ 2 ≤ 4 := by
  nlinarith [Real.cos_le_one x, Real.neg_one_le_cos x]

private theorem sq_sin_le_four (x : ℝ) : Real.sin x ^ 2 ≤ 4 := by
  nlinarith [Real.sin_sq_le_one x]

private theorem sq_neg_sin_le_four (x : ℝ) : (-Real.sin x) ^ 2 ≤ 4 := by
  rw [neg_sq]; exact sq_sin_le_four x

/-- **Strong continuity at `0`** (dominated convergence on the coordinates). -/
theorem tendsto_rotOp (x : WithLp 2 (E₁ × E₂)) :
    Tendsto (fun t : ℝ => rotOp f₁ f₂ ω t x) (𝓝 0) (𝓝 x) := by
  have hg : Summable fun n => 8 * (⟪f₁ n, x.fst⟫_ℝ ^ 2 + ⟪f₂ n, x.snd⟫_ℝ ^ 2) :=
    (hasSum_coord_sq f₁ f₂ x).summable.mul_left 8
  have h1 : Tendsto (fun t : ℝ => (rotOp f₁ f₂ ω t x).fst) (𝓝 0) (𝓝 x.fst) := by
    refine tendsto_of_inner f₁ hg (fun n => ?_) (Eventually.of_forall fun t n => ?_)
    · simp only [inner_fst_rotOp]
      have hc : Continuous fun t : ℝ =>
          Real.cos (ω n * t) * ⟪f₁ n, x.fst⟫_ℝ + Real.sin (ω n * t) * ⟪f₂ n, x.snd⟫_ℝ := by
        fun_prop
      simpa using hc.tendsto 0
    · rw [inner_fst_rotOp]
      calc _ = ((Real.cos (ω n * t) - 1) * ⟪f₁ n, x.fst⟫_ℝ +
              Real.sin (ω n * t) * ⟪f₂ n, x.snd⟫_ℝ) ^ 2 := by ring
        _ ≤ _ := sq_add_le_aux _ _ _ _ (sq_cos_sub_one_le _) (sq_sin_le_four _)
  have h2 : Tendsto (fun t : ℝ => (rotOp f₁ f₂ ω t x).snd) (𝓝 0) (𝓝 x.snd) := by
    refine tendsto_of_inner f₂ hg (fun n => ?_) (Eventually.of_forall fun t n => ?_)
    · simp only [inner_snd_rotOp]
      have hc : Continuous fun t : ℝ =>
          -Real.sin (ω n * t) * ⟪f₁ n, x.fst⟫_ℝ + Real.cos (ω n * t) * ⟪f₂ n, x.snd⟫_ℝ := by
        fun_prop
      simpa using hc.tendsto 0
    · rw [inner_snd_rotOp]
      calc _ = (-Real.sin (ω n * t) * ⟪f₁ n, x.fst⟫_ℝ +
              (Real.cos (ω n * t) - 1) * ⟪f₂ n, x.snd⟫_ℝ) ^ 2 := by ring
        _ ≤ _ := sq_add_le_aux _ _ _ _ (sq_neg_sin_le_four _) (sq_cos_sub_one_le _)
  exact ((WithLp.prod_continuous_toLp 2 E₁ E₂).tendsto (x.fst, x.snd)).comp (h1.prodMk_nhds h2)

/-! ### The rotation group -/

variable [CompleteSpace E₁] [CompleteSpace E₂]

/-- The **block-rotation group** as a C₀-semigroup: `S(t) = R(t)`, `t ≥ 0`. -/
def rotGroup : C0Semigroup ℝ (WithLp 2 (E₁ × E₂)) :=
  C0Semigroup.ofTendsto (fun t : ℝ≥0 => rotOp f₁ f₂ ω t)
    (by simp only [NNReal.coe_zero]; exact rotOp_zero f₁ f₂ ω)
    (fun s t => by simp only [NNReal.coe_add]; exact rotOp_add f₁ f₂ ω s t)
    (fun x => (tendsto_rotOp f₁ f₂ ω x).comp (NNReal.continuous_coe.tendsto' 0 0 NNReal.coe_zero))

theorem rotGroup_apply (t : ℝ≥0) : rotGroup f₁ f₂ ω t = rotOp f₁ f₂ ω t := rfl

/-- At real times `t ≥ 0` the group is the rotation `R(t)`. -/
theorem rotGroup_real {t : ℝ} (ht : 0 ≤ t) : (rotGroup f₁ f₂ ω).real t = rotOp f₁ f₂ ω t := by
  rw [C0Semigroup.real, rotGroup_apply, Real.coe_toNNReal t ht]

/-- First coordinates of `S(t) x`, `t ≥ 0`. -/
theorem inner_fst_rotGroup_real {t : ℝ} (ht : 0 ≤ t) (x : WithLp 2 (E₁ × E₂)) (n : ι) :
    ⟪f₁ n, ((rotGroup f₁ f₂ ω).real t x).fst⟫_ℝ =
      Real.cos (ω n * t) * ⟪f₁ n, x.fst⟫_ℝ + Real.sin (ω n * t) * ⟪f₂ n, x.snd⟫_ℝ := by
  rw [rotGroup_real f₁ f₂ ω ht, inner_fst_rotOp]

/-- Second coordinates of `S(t) x`, `t ≥ 0`. -/
theorem inner_snd_rotGroup_real {t : ℝ} (ht : 0 ≤ t) (x : WithLp 2 (E₁ × E₂)) (n : ι) :
    ⟪f₂ n, ((rotGroup f₁ f₂ ω).real t x).snd⟫_ℝ =
      -Real.sin (ω n * t) * ⟪f₁ n, x.fst⟫_ℝ + Real.cos (ω n * t) * ⟪f₂ n, x.snd⟫_ℝ := by
  rw [rotGroup_real f₁ f₂ ω ht, inner_snd_rotOp]

/-- The adjoint semigroup is the rotation group with the frequencies `-ω`. -/
theorem adjoint_rotGroup : (rotGroup f₁ f₂ ω).adjoint = rotGroup f₁ f₂ (fun n => -ω n) := by
  refine C0Semigroup.ext fun t => ?_
  rw [C0Semigroup.adjoint_apply, rotGroup_apply, rotGroup_apply, adjoint_rotOp, rotOp_neg_freq]

/-! ### The generator -/

theorem inner_fst_diffQuot (x : WithLp 2 (E₁ × E₂)) {h : ℝ} (hh : 0 ≤ h) (n : ι) :
    ⟪f₁ n, ((rotGroup f₁ f₂ ω).diffQuot x h).fst⟫_ℝ =
      h⁻¹ * (Real.cos (ω n * h) - 1) * ⟪f₁ n, x.fst⟫_ℝ +
        h⁻¹ * Real.sin (ω n * h) * ⟪f₂ n, x.snd⟫_ℝ := by
  rw [C0Semigroup.diffQuot, WithLp.smul_fst, real_inner_smul_right, WithLp.sub_fst,
    inner_sub_right, inner_fst_rotGroup_real f₁ f₂ ω hh]
  ring

theorem inner_snd_diffQuot (x : WithLp 2 (E₁ × E₂)) {h : ℝ} (hh : 0 ≤ h) (n : ι) :
    ⟪f₂ n, ((rotGroup f₁ f₂ ω).diffQuot x h).snd⟫_ℝ =
      h⁻¹ * (-Real.sin (ω n * h)) * ⟪f₁ n, x.fst⟫_ℝ +
        h⁻¹ * (Real.cos (ω n * h) - 1) * ⟪f₂ n, x.snd⟫_ℝ := by
  rw [C0Semigroup.diffQuot, WithLp.smul_snd, real_inner_smul_right, WithLp.sub_snd,
    inner_sub_right, inner_snd_rotGroup_real f₁ f₂ ω hh]
  ring

private theorem hasDerivAt_cos_mul (w : ℝ) : HasDerivAt (fun h => Real.cos (w * h)) 0 0 := by
  simpa using ((hasDerivAt_id (0 : ℝ)).const_mul w).cos

private theorem hasDerivAt_sin_mul (w : ℝ) : HasDerivAt (fun h => Real.sin (w * h)) w 0 := by
  simpa using ((hasDerivAt_id (0 : ℝ)).const_mul w).sin

theorem tendsto_inner_fst_diffQuot (x : WithLp 2 (E₁ × E₂)) (n : ι) :
    Tendsto (fun h => ⟪f₁ n, ((rotGroup f₁ f₂ ω).diffQuot x h).fst⟫_ℝ) (𝓝[>] 0)
      (𝓝 (ω n * ⟪f₂ n, x.snd⟫_ℝ)) := by
  have h := ((hasDerivAt_cos_mul (ω n)).tendsto_slope_zero_right.mul_const ⟪f₁ n, x.fst⟫_ℝ).add
    ((hasDerivAt_sin_mul (ω n)).tendsto_slope_zero_right.mul_const ⟪f₂ n, x.snd⟫_ℝ)
  rw [zero_mul, zero_add] at h
  refine h.congr' (eventually_nhdsWithin_of_forall fun h hh => ?_)
  dsimp only
  rw [inner_fst_diffQuot f₁ f₂ ω x (le_of_lt hh)]
  simp only [zero_add, mul_zero, Real.cos_zero, Real.sin_zero, sub_zero, smul_eq_mul]

theorem tendsto_inner_snd_diffQuot (x : WithLp 2 (E₁ × E₂)) (n : ι) :
    Tendsto (fun h => ⟪f₂ n, ((rotGroup f₁ f₂ ω).diffQuot x h).snd⟫_ℝ) (𝓝[>] 0)
      (𝓝 (-ω n * ⟪f₁ n, x.fst⟫_ℝ)) := by
  have h := (((hasDerivAt_sin_mul (ω n)).tendsto_slope_zero_right.neg).mul_const
    ⟪f₁ n, x.fst⟫_ℝ).add
    ((hasDerivAt_cos_mul (ω n)).tendsto_slope_zero_right.mul_const ⟪f₂ n, x.snd⟫_ℝ)
  rw [zero_mul, add_zero] at h
  refine h.congr' (eventually_nhdsWithin_of_forall fun h hh => ?_)
  dsimp only
  rw [inner_snd_diffQuot f₁ f₂ ω x (le_of_lt hh)]
  simp only [zero_add, mul_zero, Real.cos_zero, Real.sin_zero, sub_zero, smul_eq_mul]
  ring

/-- The generator in coordinates: `⟪f₁ n, (A x)₁⟫ = ωₙ bₙ`. -/
theorem inner_fst_generator (x : (rotGroup f₁ f₂ ω).generator.domain) (n : ι) :
    ⟪f₁ n, ((rotGroup f₁ f₂ ω).generator x).fst⟫_ℝ =
      ω n * ⟪f₂ n, (x : WithLp 2 (E₁ × E₂)).snd⟫_ℝ := by
  have h1 : Tendsto (fun h => ⟪f₁ n, ((rotGroup f₁ f₂ ω).diffQuot x h).fst⟫_ℝ) (𝓝[>] 0)
      (𝓝 ⟪f₁ n, ((rotGroup f₁ f₂ ω).generator x).fst⟫_ℝ) :=
    ((((innerSL ℝ (f₁ n)).comp (WithLp.fstL 2 ℝ E₁ E₂)).continuous.tendsto _).comp
      ((rotGroup f₁ f₂ ω).tendsto_generator x))
  exact tendsto_nhds_unique h1 (tendsto_inner_fst_diffQuot f₁ f₂ ω x n)

/-- The generator in coordinates: `⟪f₂ n, (A x)₂⟫ = -ωₙ aₙ`. -/
theorem inner_snd_generator (x : (rotGroup f₁ f₂ ω).generator.domain) (n : ι) :
    ⟪f₂ n, ((rotGroup f₁ f₂ ω).generator x).snd⟫_ℝ =
      -ω n * ⟪f₁ n, (x : WithLp 2 (E₁ × E₂)).fst⟫_ℝ := by
  have h1 : Tendsto (fun h => ⟪f₂ n, ((rotGroup f₁ f₂ ω).diffQuot x h).snd⟫_ℝ) (𝓝[>] 0)
      (𝓝 ⟪f₂ n, ((rotGroup f₁ f₂ ω).generator x).snd⟫_ℝ) :=
    ((((innerSL ℝ (f₂ n)).comp (WithLp.sndL 2 ℝ E₁ E₂)).continuous.tendsto _).comp
      ((rotGroup f₁ f₂ ω).tendsto_generator x))
  exact tendsto_nhds_unique h1 (tendsto_inner_snd_diffQuot f₁ f₂ ω x n)

/-- `‖A x‖² = ∑ₙ ωₙ² (aₙ² + bₙ²)` on `D(A)`; in particular these sums are finite on `D(A)`. -/
theorem hasSum_sq_generator (x : (rotGroup f₁ f₂ ω).generator.domain) :
    HasSum (fun n => ω n ^ 2 * (⟪f₁ n, (x : WithLp 2 (E₁ × E₂)).fst⟫_ℝ ^ 2 +
        ⟪f₂ n, (x : WithLp 2 (E₁ × E₂)).snd⟫_ℝ ^ 2))
      (‖(rotGroup f₁ f₂ ω).generator x‖ ^ 2) := by
  convert hasSum_coord_sq f₁ f₂ ((rotGroup f₁ f₂ ω).generator x) using 1
  funext n
  rw [inner_fst_generator, inner_snd_generator]
  ring

/-- **The rotation group is not analytic** if some `y ∈ E₁` has `∑ₙ (ωₙ ⟪f₁ n, y⟫)² = ∞`:
`S(1)` maps `R(-1) (y, 0)` to `(y, 0) ∉ D(A)`, while an analytic semigroup maps into `D(A)`
at every positive time. -/
theorem not_isAnalytic {y : E₁} (hy : ¬ Summable fun n => (ω n * ⟪f₁ n, y⟫_ℝ) ^ 2) :
    ¬ (rotGroup f₁ f₂ ω).IsAnalytic := by
  intro hA
  have h1 := hA.mem_generator_domain one_pos (rotOp f₁ f₂ ω (-1) (WithLp.toLp 2 (y, 0)))
  rw [rotGroup_real f₁ f₂ ω zero_le_one, rotOp_apply_neg] at h1
  refine hy ((hasSum_sq_generator f₁ f₂ ω ⟨_, h1⟩).summable.of_nonneg_of_le
    (fun n => sq_nonneg _) fun n => ?_)
  simp only [WithLp.toLp_fst, WithLp.toLp_snd, inner_zero_right]
  exact le_of_eq (by ring)

end Rot

/-! ### Block-diagonal maps between products -/

section Block

variable {F₁ F₂ : Type*} [NormedAddCommGroup F₁] [InnerProductSpace ℝ F₁]
  [NormedAddCommGroup F₂] [InnerProductSpace ℝ F₂]
  (f₁ : HilbertBasis ι ℝ E₁) (f₂ : HilbertBasis ι ℝ E₂)
  (g₁ : HilbertBasis ι ℝ F₁) (g₂ : HilbertBasis ι ℝ F₂)

/-- The **block-diagonal map** `(x₁, x₂) ↦ (D x₁, D x₂)` with the same bounded multiplier
`dₙ` on both components: `⟪g₁ n, (D x)₁⟫ = dₙ aₙ`, `⟪g₂ n, (D x)₂⟫ = dₙ bₙ`. -/
def blockDiag (d : ι → ℝ) (K : ℝ) (hd : ∀ n, |d n| ≤ K) :
    WithLp 2 (E₁ × E₂) →L[ℝ] WithLp 2 (F₁ × F₂) :=
  pairL (diagMap f₁ g₁ d K hd ∘L WithLp.fstL 2 ℝ E₁ E₂)
    (diagMap f₂ g₂ d K hd ∘L WithLp.sndL 2 ℝ E₁ E₂)

variable {d : ι → ℝ} {K : ℝ} (hd : ∀ n, |d n| ≤ K)

theorem inner_fst_blockDiag (x : WithLp 2 (E₁ × E₂)) (n : ι) :
    ⟪g₁ n, (blockDiag f₁ f₂ g₁ g₂ d K hd x).fst⟫_ℝ = d n * ⟪f₁ n, x.fst⟫_ℝ := by
  simp only [blockDiag, pairL_fst, ContinuousLinearMap.comp_apply, WithLp.fstL_apply,
    inner_diagMap]

theorem inner_snd_blockDiag (x : WithLp 2 (E₁ × E₂)) (n : ι) :
    ⟪g₂ n, (blockDiag f₁ f₂ g₁ g₂ d K hd x).snd⟫_ℝ = d n * ⟪f₂ n, x.snd⟫_ℝ := by
  simp only [blockDiag, pairL_snd, ContinuousLinearMap.comp_apply, WithLp.sndL_apply,
    inner_diagMap]

/-- A block-diagonal map with nonzero multipliers is injective. -/
theorem injective_blockDiag (h0 : ∀ n, d n ≠ 0) :
    Function.Injective (blockDiag f₁ f₂ g₁ g₂ d K hd) := by
  intro x y hxy
  refine ext_coord f₁ f₂ (fun n => ?_) fun n => ?_
  · have h := congrArg (fun z : WithLp 2 (F₁ × F₂) => ⟪g₁ n, z.fst⟫_ℝ) hxy
    simp only [inner_fst_blockDiag] at h
    exact mul_left_cancel₀ (h0 n) h
  · have h := congrArg (fun z : WithLp 2 (F₁ × F₂) => ⟪g₂ n, z.snd⟫_ℝ) hxy
    simp only [inner_snd_blockDiag] at h
    exact mul_left_cancel₀ (h0 n) h

/-- A block-diagonal map with nonzero multipliers has dense range. -/
theorem denseRange_blockDiag (h0 : ∀ n, d n ≠ 0) :
    DenseRange (blockDiag f₁ f₂ g₁ g₂ d K hd) := by
  have e : ⇑(blockDiag f₁ f₂ g₁ g₂ d K hd) = (WithLp.toLp 2 : F₁ × F₂ → WithLp 2 (F₁ × F₂)) ∘
      (Prod.map (diagMap f₁ g₁ d K hd) (diagMap f₂ g₂ d K hd) ∘ WithLp.ofLp) := rfl
  rw [e]
  refine (Function.Surjective.denseRange fun y => ⟨WithLp.ofLp y, rfl⟩).comp
    ?_ (WithLp.prod_continuous_toLp 2 F₁ F₂)
  exact ((denseRange_diagMap f₁ g₁ hd h0).prodMap (denseRange_diagMap f₂ g₂ hd h0)).comp
    (Function.Surjective.denseRange fun p => ⟨WithLp.toLp 2 p, rfl⟩)
    ((diagMap f₁ g₁ d K hd).continuous.prodMap (diagMap f₂ g₂ d K hd).continuous)

/-- Block-diagonal maps intertwine the rotation groups with the same frequencies. -/
theorem consistent_blockDiag [CompleteSpace E₁] [CompleteSpace E₂] [CompleteSpace F₁]
    [CompleteSpace F₂] (ω : ι → ℝ) :
    C0Semigroup.Consistent (blockDiag f₁ f₂ g₁ g₂ d K hd) (rotGroup f₁ f₂ ω)
      (rotGroup g₁ g₂ ω) := by
  intro t x
  refine ext_coord g₁ g₂ (fun n => ?_) fun n => ?_
  · simp only [rotGroup_apply, inner_fst_rotOp, inner_fst_blockDiag, inner_snd_blockDiag]
    ring
  · simp only [rotGroup_apply, inner_snd_rotOp, inner_fst_blockDiag, inner_snd_blockDiag]
    ring

end Block

end Rotation

end DataDrivenControl
