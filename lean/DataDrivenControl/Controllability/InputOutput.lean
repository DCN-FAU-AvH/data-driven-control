module

public import DataDrivenControl.Controllability.InputState
public import DataDrivenControl.FundamentalLemma.InputOutput

/-!
# Input–output controllability tests

Paper: `thm:io-window-controllability`, `eq:io-window-fh`, `eq:io-window-pullback`,
`eq:io-window-projection`, `eq:io-window-behavior`, `eq:io-window-shift-eigenrelation`
(`app:io-window-controllability`).

## Conventions

The window functional of `eq:io-window-fh` is `ioWindowPairing T v g ū ȳ s`,
`∫₀ᵀ (⟨v(t), ū(s + t)⟩_U + ⟨g(t), ȳ(s + t)⟩_Y) dt` with `v ∈ L²(0, T; U_ℂ)`,
`g ∈ L²(0, T; Y_ℂ)` and the complex-bilinear pairings on the complexified spaces
(`Analysis/Complexification`).  The record on `[0, ρ + T']` generated by `(x₀, ū)` has state
`sys.mild x₀ ū` and output `sys.output (ρ + T') x₀ ū`.  `prop:fattorini-hautus` enters as the
hypothesis `sys.FattoriniHautusProperty T`.

## Main declarations

* `ioWindowPairing`: the left-hand side of `eq:io-window-fh`.
* `System.approxControllable_of_forall_not_io_exp`: `thm:io-window-controllability` (i).
* `System.approxControllable_iff_forall_not_io_exp`: `thm:io-window-controllability` (ii),
  the equivalence.
* `System.ne_zero_of_io_exp`: `thm:io-window-controllability` (ii), last sentence (`g ≠ 0`);
  strengthening: neither the Fattorini–Hautus property nor exact observability is assumed.

## Proof route

*Complex windows as pairs of real ones.*  No complexified `L²` space is needed: `v` and `g`
enter only through their real and imaginary parts `Re v = reL2 T v`, `Im v = imL2 T v`
(`Complexification.integral_pairing`), so `ℓ_{v,g}(p) = ⟪P, p⟫ + i ⟪Q, p⟫` with
`P = (Re v, Re g)`, `Q = (Im v, Im g)` in the real Hilbert space `L²(0, T; U) × L²(0, T; Y)`
(`ioWindowPairing_eq_cpairL`, `cpairL`), and conversely every pair `(P, Q)` comes from
`v = mkL2 T P.1 Q.1`, `g = mkL2 T P.2 Q.2`.  The pullback `eq:io-window-pullback` is then
`⟪P, 𝓜_T (u, x)⟫ = ⟪𝓜_T† P, (u, x)⟫`: `α` and `η` are the components of `𝓜_T† P`, `𝓜_T† Q`.

*Steps 1–2* (`System.exists_io_exp_of_isHautusEigenvector`): `𝓜_T` is bounded below under exact
observability, so `𝓜_T†` is onto and `P, Q` with `𝓜_T† P = (0, Re η)`, `𝓜_T† Q = (0, Im η)`
exist (this is `𝓞_T^⋆ g = η`, `v = -𝓕_T^⋆ g`).  The shift identity on windows
(`System.window_output_eq`) and `eq:data-fh-exponential` give `eq:io-window-projection`;
`κ = ⟨η, x₀⟩ ≠ 0` is `System.exp_coeff_eq_and_ne_zero`.

*Step 3* (`System.exists_isHautusEigenvector_of_io_exp`).  For `r ∈ [0, 2T]` the functional
`D_r = ℓ ∘ W_r - e^{λ r} ℓ ∘ W_0` (`ioWin`: both windows) vanishes on almost every measured
window, hence on `closure (im 𝒴_{3T,T'}) = closure 𝓑_{3T}` (`clm_eq_zero_of_mem_closure`,
`System.closure_range_ioWindowSynth`), which gives `eq:io-window-shift-eigenrelation`
(`System.io_eigenrelation`, with the `L²` shift identity `System.ioWin_ioParam`).  Inputs
supported in `(T, 2T)` give `α = 0`; zero input gives `⟨η, S(τ) x⟩ = e^{λ τ} ⟨η, x⟩` for
`τ ∈ [0, T]` directly; zero initial state gives `⟨η, L_T u⟩ = 0`.  Then
`System.isHautusEigenvector_of_shift` differentiates `⟨η, S(h) x⟩` at `h = 0⁺` for `x ∈ D(A)`,
so `Re η, Im η ∈ D(A†)` and `A^⋆ η = λ η`, and gets `B^⋆ η = 0` from the weak derivative
(`System.hasWeakDeriv_pairing_mild`) of `t ↦ ⟨η, x(t; 0, b)⟩ = 0` for constant inputs `b`.
Finally `η ≠ 0`, as in the paper, and `g = 0` forces `η = 𝓞_T^⋆ g = 0`.
-/

@[expose] public section

open MeasureTheory Set Filter Topology
open scoped InnerProductSpace

noncomputable section

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace DataDrivenControl

/-! ### Real and imaginary parts of complex `L²` signals -/

namespace Complexification

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] {T : ℝ}

/-- The real part `t ↦ (v t).re` of `v ∈ L²(0, T; E_ℂ)`. -/
def reL2 (T : ℝ) : L2 (Complexification E) T →L[ℝ] L2 E T :=
  reCLM.compLpL 2 (μI T)

/-- The imaginary part `t ↦ (v t).im` of `v ∈ L²(0, T; E_ℂ)`. -/
def imL2 (T : ℝ) : L2 (Complexification E) T →L[ℝ] L2 E T :=
  imCLM.compLpL 2 (μI T)

/-- A representative of `Re v`. -/
theorem coeFn_reL2 (v : L2 (Complexification E) T) :
    ⇑(reL2 T v) =ᵐ[μI T] fun t => (v t).re :=
  reCLM.coeFn_compLpL v

/-- A representative of `Im v`. -/
theorem coeFn_imL2 (v : L2 (Complexification E) T) :
    ⇑(imL2 T v) =ᵐ[μI T] fun t => (v t).im :=
  imCLM.coeFn_compLpL v

/-- The element of `L²(0, T; E_ℂ)` with real part `a` and imaginary part `b`. -/
def mkL2 (T : ℝ) (a b : L2 E T) : L2 (Complexification E) T :=
  ofRealCLM.compLpL 2 (μI T) a + Complex.I • ofRealCLM.compLpL 2 (μI T) b

/-- A representative of `a + i b`. -/
theorem coeFn_mkL2 (a b : L2 E T) :
    ⇑(mkL2 T a b) =ᵐ[μI T] fun t => (⟨a t, b t⟩ : Complexification E) := by
  filter_upwards [Lp.coeFn_add (ofRealCLM.compLpL 2 (μI T) a)
      (Complex.I • ofRealCLM.compLpL 2 (μI T) b),
    Lp.coeFn_smul Complex.I (ofRealCLM.compLpL 2 (μI T) b),
    ofRealCLM.coeFn_compLpL (p := 2) (μ := μI T) a,
    ofRealCLM.coeFn_compLpL (p := 2) (μ := μI T) b] with t h1 h2 h3 h4
  rw [mkL2, h1, Pi.add_apply, h2, Pi.smul_apply, h3, h4, mk_eq_add_I_smul]
  rfl

/-- `Re (a + i b) = a`. -/
@[simp] theorem reL2_mkL2 (a b : L2 E T) : reL2 T (mkL2 T a b) = a := by
  refine Lp.ext ?_
  filter_upwards [coeFn_reL2 (mkL2 T a b), coeFn_mkL2 a b] with t h1 h2
  rw [h1, h2]

/-- `Im (a + i b) = b`. -/
@[simp] theorem imL2_mkL2 (a b : L2 E T) : imL2 T (mkL2 T a b) = b := by
  refine Lp.ext ?_
  filter_upwards [coeFn_imL2 (mkL2 T a b), coeFn_mkL2 a b] with t h1 h2
  rw [h1, h2]

/-- The bilinear pairing of `v ∈ L²(0, T; E_ℂ)` with a real signal, pointwise, in terms of
the real and imaginary parts of `v`. -/
theorem pairing_ae_eq (v : L2 (Complexification E) T) {f : ℝ → E} {a : L2 E T}
    (hf : f =ᵐ[μI T] ⇑a) :
    (fun t => ⟪v t, (f t : Complexification E)⟫_bil) =ᵐ[μI T]
      fun t => ((⟪reL2 T v t, a t⟫_ℝ : ℝ) : ℂ) + ((⟪imL2 T v t, a t⟫_ℝ : ℝ) : ℂ) * Complex.I := by
  filter_upwards [hf, coeFn_reL2 v, coeFn_imL2 v] with t h1 h2 h3
  rw [h1, h2, h3]
  apply Complex.ext <;> simp

/-- **The bilinear `L²` pairing** of `v ∈ L²(0, T; E_ℂ)` with a real signal `f = a` a.e.:
`∫₀ᵀ ⟨v(t), f(t)⟩ dt = ⟨Re v, a⟩ + i ⟨Im v, a⟩`. -/
theorem integral_pairing (v : L2 (Complexification E) T) {f : ℝ → E} {a : L2 E T}
    (hf : f =ᵐ[μI T] ⇑a) :
    ∫ t in Ioc 0 T, ⟪v t, (f t : Complexification E)⟫_bil =
      ⟨⟪reL2 T v, a⟫_ℝ, ⟪imL2 T v, a⟫_ℝ⟩ := by
  rw [integral_congr_ae (pairing_ae_eq v hf),
    integral_add ((L2.integrable_inner (reL2 T v) a).ofReal)
      (((L2.integrable_inner (imL2 T v) a).ofReal).mul_const _),
    integral_mul_const, integral_complex_ofReal, integral_complex_ofReal, ← L2.inner_def,
    ← L2.inner_def]
  apply Complex.ext <;> simp

/-- The bilinear pairing of `v ∈ L²(0, T; E_ℂ)` with a real `L²` signal is integrable. -/
theorem integrable_pairing (v : L2 (Complexification E) T) {f : ℝ → E} {a : L2 E T}
    (hf : f =ᵐ[μI T] ⇑a) :
    Integrable (fun t => ⟪v t, (f t : Complexification E)⟫_bil) (μI T) :=
  (((L2.integrable_inner (reL2 T v) a).ofReal).add
    (((L2.integrable_inner (imL2 T v) a).ofReal).mul_const _)).congr (pairing_ae_eq v hf).symm

end Complexification

/-- The complex-valued functional `p ↦ ⟪P, p⟫ + i ⟪Q, p⟫` on a real inner product space. -/
def cpairL {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] (P Q : F) : F →L[ℝ] ℂ :=
  Complex.equivRealProdCLM.symm.toContinuousLinearMap ∘L (innerSL ℝ P).prod (innerSL ℝ Q)

/-- `cpairL P Q p = ⟪P, p⟫ + i ⟪Q, p⟫`. -/
@[simp] theorem cpairL_apply {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    (P Q p : F) : cpairL P Q p = ⟨⟪P, p⟫_ℝ, ⟪Q, p⟫_ℝ⟩ := by
  apply Complex.ext <;> simp [cpairL]

open Complexification

variable {U W X V Y : Type*}
  [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]

/-- The window functional of `eq:io-window-fh` at shift `s`:
`∫₀ᵀ (⟨v(t), ū(s + t)⟩_U + ⟨g(t), ȳ(s + t)⟩_Y) dt` for `v ∈ L²(0, T; U_ℂ)` and
`g ∈ L²(0, T; Y_ℂ)`, with the complex-bilinear pairings. -/
def ioWindowPairing (T : ℝ) (v : L2 (Complexification U) T) (g : L2 (Complexification Y) T)
    (u : ℝ → U) (y : ℝ → Y) (s : ℝ) : ℂ :=
  ∫ t in Ioc 0 T, (⟪v t, (u (s + t) : Complexification U)⟫_bil +
    ⟪g t, (y (s + t) : Complexification Y)⟫_bil)

/-! ### The window functional through real inner products -/

/-- The real part `(Re v, Re g)` of the representer of the window functional `ℓ_{v,g}`. -/
def ioRe {T : ℝ} (v : L2 (Complexification U) T) (g : L2 (Complexification Y) T) :
    WithLp 2 (L2 U T × L2 Y T) :=
  WithLp.toLp 2 (reL2 T v, reL2 T g)

/-- The imaginary part `(Im v, Im g)` of the representer of the window functional `ℓ_{v,g}`. -/
def ioIm {T : ℝ} (v : L2 (Complexification U) T) (g : L2 (Complexification Y) T) :
    WithLp 2 (L2 U T × L2 Y T) :=
  WithLp.toLp 2 (imL2 T v, imL2 T g)

/-- The window functional in terms of real inner products: if `(u(s + ·), y(s + ·)) = p` a.e.
on `(0, T)`, then `ℓ_{v,g}(u(s + ·), y(s + ·)) = ⟪Re (v, g), p⟫ + i ⟪Im (v, g), p⟫`. -/
theorem ioWindowPairing_eq_cpairL {T s : ℝ} (v : L2 (Complexification U) T)
    (g : L2 (Complexification Y) T) {u : ℝ → U} {y : ℝ → Y} {p : WithLp 2 (L2 U T × L2 Y T)}
    (hu : (fun t => u (s + t)) =ᵐ[μI T] ⇑p.fst) (hy : (fun t => y (s + t)) =ᵐ[μI T] ⇑p.snd) :
    ioWindowPairing T v g u y s = cpairL (ioRe v g) (ioIm v g) p := by
  rw [ioWindowPairing, integral_add (integrable_pairing v hu) (integrable_pairing g hy),
    integral_pairing v hu, integral_pairing g hy, cpairL_apply]
  apply Complex.ext <;> simp [ioRe, ioIm, WithLp.prod_inner_apply]

/-- The window functional evaluated on the windows of square-integrable signals. -/
theorem ioWindowPairing_eq_window {T τ s : ℝ} (v : L2 (Complexification U) T)
    (g : L2 (Complexification Y) T) {u : ℝ → U} {y : ℝ → Y} (hu : MemLp u 2 (μI τ))
    (hy : MemLp y 2 (μI τ)) (hs : 0 ≤ s) (hsT : s + T ≤ τ) :
    ioWindowPairing T v g u y s =
      cpairL (ioRe v g) (ioIm v g) (WithLp.toLp 2 (window T u s, window T y s)) :=
  ioWindowPairing_eq_cpairL v g (coeFn_window_of_memLp hu hs hsT).symm
    (coeFn_window_of_memLp hy hs hsT).symm

section IoWin

/-- Windowing both components, `(u, y) ↦ (u(r + ·), y(r + ·))`, from `(0, T₁)` to `(0, T)`. -/
def ioWin (T₁ T r : ℝ) : WithLp 2 (L2 U T₁ × L2 Y T₁) →L[ℝ] WithLp 2 (L2 U T × L2 Y T) :=
  ((WithLp.prodContinuousLinearEquiv 2 ℝ (L2 U T) (L2 Y T)).symm :
      (L2 U T × L2 Y T) →L[ℝ] WithLp 2 (L2 U T × L2 Y T)) ∘L
    (windowL T₁ T r ∘L WithLp.fstL 2 ℝ (L2 U T₁) (L2 Y T₁)).prod
      (windowL T₁ T r ∘L WithLp.sndL 2 ℝ (L2 U T₁) (L2 Y T₁))

variable {T₁ T r : ℝ}

/-- The input component of `ioWin`. -/
@[simp] theorem fst_ioWin (p : WithLp 2 (L2 U T₁ × L2 Y T₁)) :
    (ioWin T₁ T r p).fst = windowL T₁ T r p.fst :=
  rfl

/-- The output component of `ioWin`. -/
@[simp] theorem snd_ioWin (p : WithLp 2 (L2 U T₁ × L2 Y T₁)) :
    (ioWin T₁ T r p).snd = windowL T₁ T r p.snd :=
  rfl

/-- A window of a pair of windows is a pair of windows. -/
theorem ioWin_window {τ s : ℝ} {u : ℝ → U} {y : ℝ → Y} (hu : MemLp u 2 (μI τ))
    (hy : MemLp y 2 (μI τ)) (hs : 0 ≤ s) (hsT : s + T₁ ≤ τ) (hr : 0 ≤ r) (hrT : r + T ≤ T₁) :
    ioWin T₁ T r (WithLp.toLp 2 (window T₁ u s, window T₁ y s)) =
      WithLp.toLp 2 (window T u (s + r), window T y (s + r)) := by
  refine WithLp.ofLp_injective 2 (Prod.ext ?_ ?_)
  · change windowL T₁ T r (window T₁ u s) = window T u (s + r)
    rw [windowL_apply hr hrT, window_window hu hs hsT hr hrT]
  · change windowL T₁ T r (window T₁ y s) = window T y (s + r)
    rw [windowL_apply hr hrT, window_window hy hs hsT hr hrT]

/-- A bounded real-linear functional that vanishes on almost every window
`(u(s + ·), y(s + ·))`, `s ∈ (0, T')`, vanishes on the closure of `im 𝒴_{T,T'}^{u,y}`. -/
theorem clm_eq_zero_of_mem_closure {T' : ℝ} {u : ℝ → U} {y : ℝ → Y}
    (hu : MemLp u 2 (μI (T + T'))) (hy : MemLp y 2 (μI (T + T')))
    (Λ : WithLp 2 (L2 U T × L2 Y T) →L[ℝ] ℂ)
    (hΛ : ∀ᵐ s ∂(μI T'), Λ (WithLp.toLp 2 (window T u s, window T y s)) = 0)
    {q : WithLp 2 (L2 U T × L2 Y T)} (hq : q ∈ closure (range (ioWindowSynth T T' u y))) :
    Λ q = 0 := by
  have hg : MemLp (fun s => WithLp.toLp 2 (window T u s, window T y s)) 2 (μI T') :=
    MemLp.of_fst_of_snd_prodLp ⟨memLp_window hu, memLp_window hy⟩
  have h0 : ∀ φ, Λ (ioWindowSynth T T' u y φ) = 0 := by
    intro φ
    rw [← ContinuousLinearMap.comp_apply, ioWindowSynth_eq_pointSynth hu hy, comp_pointSynth hg Λ,
      pointSynth_congr_ae (g' := fun _ => (0 : ℂ)) hΛ, pointSynth_apply (memLp_const 0)]
    simp
  exact closure_minimal (range_subset_iff.2 h0) (isClosed_eq Λ.continuous continuous_const) hq

end IoWin

namespace System

variable {sys : System U W X V Y}

/-! ### The shift identity and Steps 1–2 (obstructions produce exponential identities) -/

/-- The shift identity on windows (`lem:finite-horizon-output`): for the record on `[0, τ]`,
`(ū(s + ·), ȳ(s + ·)) = 𝓜_T (ū(s + ·), x̄(s))` for `0 ≤ s`, `s + T ≤ τ`. -/
theorem window_output_eq {T τ s : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T) (hT : 0 < T) {x₀ : X}
    {u : ℝ → U} (hu : MemLp u 2 (μI τ)) (hs : 0 ≤ s) (hsT : s + T ≤ τ) :
    WithLp.toLp 2 (window T u s, window T (sys.output τ x₀ u) s) =
      sys.ioParam T (WithLp.toLp 2 (window T u s, sys.mild x₀ u s)) := by
  have hus : MemLp (fun r => u (s + r)) 2 (μI T) := memLp_comp_add hu hs hsT
  refine WithLp.ofLp_injective 2 (Prod.ext rfl ?_)
  change window T (sys.output τ x₀ u) s =
    sys.𝓕 T (window T u s) + sys.𝓞 T (sys.mild x₀ u s)
  rw [window_eq_toLp hus, add_comm (sys.𝓕 T _)]
  refine Lp.ext ?_
  filter_upwards [coeFn_window_of_memLp (memLp_output hH1 hT hu x₀) hs hsT,
    output_shift hH1 hH2 hT hs hsT hu x₀, output_ae_eq hH1 hT hus (sys.mild x₀ u s)]
    with t h1 h2 h3
  rw [h1, h2, h3]

/-- `app:io-window-controllability`, Steps 1–2: under exact observability, a Hautus eigenvector
`η ≠ 0` produces a solution `(κ, v, g)` of `eq:io-window-fh` with `κ ≠ 0` and `g ≠ 0`, for
every window `s + (0, T] ⊆ (0, τ]` of an informative record on `[0, τ]`. -/
theorem exists_io_exp_of_isHautusEigenvector {T τ : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T)
    (hT : 0 < T) (hTτ : T ≤ τ) (hobs : sys.ExactlyObservable T) {x₀ : X} {u : ℝ → U}
    (hu : MemLp u 2 (μI τ)) (hinf : Informative τ u (sys.mild x₀ u)) {μ : ℂ}
    {η : Complexification X} (hη : sys.IsHautusEigenvector μ η) (hne : η ≠ 0) :
    ∃ (κ : ℂ) (v : L2 (Complexification U) T) (g : L2 (Complexification Y) T), κ ≠ 0 ∧ g ≠ 0 ∧
      ∀ s, 0 ≤ s → s + T ≤ τ →
        ioWindowPairing T v g u (sys.output τ x₀ u) s = κ * Complex.exp (μ * s) := by
  obtain ⟨P, hP⟩ := (isBoundedBelow_ioParam hobs).adjoint_surjective (WithLp.toLp 2 (0, η.re))
  obtain ⟨Q, hQ⟩ := (isBoundedBelow_ioParam hobs).adjoint_surjective (WithLp.toLp 2 (0, η.im))
  -- `eq:io-window-pullback` with `α = 0`: `ℓ_{v,g} ∘ 𝓜_T = ⟨η, ·⟩`
  have key : ∀ (b : L2 U T) (z : X),
      cpairL P Q (sys.ioParam T (WithLp.toLp 2 (b, z))) = ⟪η, (z : Complexification X)⟫_bil := by
    intro b z
    rw [cpairL_apply, ← ContinuousLinearMap.adjoint_inner_left,
      ← ContinuousLinearMap.adjoint_inner_left, hP, hQ, pairing_ofReal_right]
    simp [WithLp.prod_inner_apply]
  set v := mkL2 T P.fst Q.fst
  set g := mkL2 T P.snd Q.snd
  have hre : ioRe v g = P := WithLp.ofLp_injective 2 (Prod.ext (by simp [ioRe, v])
    (by simp [ioRe, g]))
  have him : ioIm v g = Q := WithLp.ofLp_injective 2 (Prod.ext (by simp [ioIm, v])
    (by simp [ioIm, g]))
  have hexp := fun t ht => exp_of_isHautusEigenvector (x₀ := x₀) hH1 hT hη hu t ht
  obtain ⟨-, hκ⟩ := exp_coeff_eq_and_ne_zero (hT.trans_le hTτ) hinf hne hexp
  refine ⟨_, v, g, hκ, fun hg => hne ?_, fun s hs hsT => ?_⟩
  · have h1 : P.snd = 0 := by rw [← reL2_mkL2 P.snd Q.snd]; change reL2 T g = 0; simp [hg]
    have h2 : Q.snd = 0 := by rw [← imL2_mkL2 P.snd Q.snd]; change imL2 T g = 0; simp [hg]
    refine pairing_ofReal_eq_zero_forall_iff.1 fun z => ?_
    rw [← key 0 z, cpairL_apply]
    simp [WithLp.prod_inner_apply, h1, h2]; rfl
  · rw [ioWindowPairing_eq_window v g hu (memLp_output hH1 hT hu x₀) hs hsT,
      window_output_eq hH1 hH2 hT hu hs hsT, hre, him, key, hexp s ⟨hs, by linarith⟩]
/-- Real scalars commute with the real embedding. -/
private theorem ofReal_real_smul (c : ℝ) (x : X) :
    ((c • x : X) : Complexification X) = (c : ℂ) • (x : Complexification X) := by
  ext <;> simp

/-- The control convolution of the zero input vanishes. -/
theorem L_zero_right (t : ℝ) : sys.L t (0 : ℝ → U) = 0 :=
  L_eq_of_ιWV (by simp [convV])

/-- `app:io-window-controllability`, Step 3 (end): if `⟨η, S(τ) x⟩ = e^{λ τ} ⟨η, x⟩` for
`τ ∈ [0, T]` and `⟨η, L_T u⟩ = 0` for every input, then `A^⋆ η = λ η` and `B^⋆ η = 0`. -/
theorem isHautusEigenvector_of_shift {T : ℝ} (hH1 : sys.H1 T) (hT : 0 < T) {μ : ℂ}
    {η : Complexification X}
    (hS : ∀ τ ∈ Icc 0 T, ∀ x : X, ⟪η, (sys.SX.real τ x : Complexification X)⟫_bil =
      Complex.exp (μ * τ) * ⟪η, (x : Complexification X)⟫_bil)
    (hL : ∀ b : L2 U T, ⟪η, (sys.ιW (sys.L T b) : Complexification X)⟫_bil = 0) :
    sys.IsHautusEigenvector μ η := by
  -- the generator: `⟨η, A x⟩ = λ ⟨η, x⟩` on `D(A)`
  have hA : ∀ x : sys.A.domain, ⟪η, (sys.A x : Complexification X)⟫_bil =
      μ * ⟪η, ((x : X) : Complexification X)⟫_bil := by
    intro x
    have hc : Continuous fun z : X => ⟪η, (z : Complexification X)⟫_bil :=
      (pairingCLM η).continuous.comp continuous_ofReal
    have h1 := (hc.tendsto _).comp (sys.SX.tendsto_generator x)
    have hd : HasDerivAt (fun t : ℝ => Complex.exp (μ * t)) (Complex.exp (μ * (0 : ℝ)) * (μ * 1))
        0 := ((hasDerivAt_id (0 : ℝ)).ofReal_comp.const_mul μ).cexp
    simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero, mul_one, one_mul] at hd
    have h2 := (hd.tendsto_slope_zero_right).mul_const (⟪η, ((x : X) : Complexification X)⟫_bil)
    refine tendsto_nhds_unique h1 (h2.congr' ?_)
    filter_upwards [Ioo_mem_nhdsGT hT] with h hh
    simp only [Function.comp_apply, C0Semigroup.diffQuot, zero_add, Complex.ofReal_zero,
      mul_zero, Complex.exp_zero]
    rw [ofReal_real_smul, pairing_smul_right, ofReal_sub, pairing_sub_right,
      hS h ⟨hh.1.le, hh.2.le⟩]
    simp only [Complex.real_smul, Complex.ofReal_inv]
    ring
  -- `η.re, η.im ∈ D(A†)`, `A^⋆ η = λ η`
  have hdense := sys.SX.dense_generator_domain
  have hre : ∀ x : sys.A.domain,
      ⟪μ.re • η.re - μ.im • η.im, (x : X)⟫_ℝ = ⟪η.re, sys.A x⟫_ℝ := by
    intro x
    have := congrArg Complex.re (hA x)
    simp only [pairing_ofReal_right, Complex.mul_re] at this
    rw [inner_sub_left, real_inner_smul_left, real_inner_smul_left, this]
  have him : ∀ x : sys.A.domain,
      ⟪μ.im • η.re + μ.re • η.im, (x : X)⟫_ℝ = ⟪η.im, sys.A x⟫_ℝ := by
    intro x
    have := congrArg Complex.im (hA x)
    simp only [pairing_ofReal_right, Complex.mul_im] at this
    rw [inner_add_left, real_inner_smul_left, real_inner_smul_left, this]
    ring
  have hD1 : η.re ∈ sys.A.adjoint.domain := LinearPMap.mem_adjoint_domain_of_exists _ ⟨_, hre⟩
  have hD2 : η.im ∈ sys.A.adjoint.domain := LinearPMap.mem_adjoint_domain_of_exists _ ⟨_, him⟩
  have hD : η ∈ sys.A.adjoint.complexify.domain := Submodule.mem_complexify.2 ⟨hD1, hD2⟩
  have hAη : sys.A.adjoint.complexify ⟨η, hD⟩ = μ • η := by
    ext
    · rw [LinearPMap.complexify_apply_re]
      rw [LinearPMap.adjoint_apply_eq hdense ⟨η.re, hD1⟩ hre]
      simp
    · rw [LinearPMap.complexify_apply_im]
      rw [LinearPMap.adjoint_apply_eq hdense ⟨η.im, hD2⟩ him]
      simp only [smul_im]
      abel
  refine ⟨hD, hAη, ?_⟩
  -- `B^⋆ η = 0`: `t ↦ ⟨η, x(t; 0, b)⟩` vanishes, so its weak derivative `⟨B^⋆ η, b⟩` does
  refine pairing_ofReal_eq_zero_forall_iff.1 fun b => ?_
  have hb : MemLp (fun _ : ℝ => b) 2 (μI T) := memLp_const b
  have hw := hasWeakDeriv_pairing_mild hH1 hT hb 0 hD
  have hzero : ∀ t ∈ Icc 0 T,
      ⟪η, (sys.mild 0 (fun _ => b) t : Complexification X)⟫_bil = 0 := by
    intro t ht
    rw [mild_zero_left, L_congr_ae (ae_restrict_of_ae_restrict_of_subset
      (Ioc_subset_Ioc_right ht.2) hb.coeFn_toLp.symm), L_eq_Lop_windowL hH1 hT ht.2,
      Lop_apply hH1 hT]
    exact hL _
  have hw0 : HasWeakDeriv T (fun t => ⟪η, (sys.mild 0 (fun _ => b) t : Complexification X)⟫_bil)
      0 :=
    (HasWeakDeriv.const (0 : ℂ)).congr (fun t ht => (hzero t ht).symm) (ae_of_all _ fun _ => rfl)
  have hae := hw.ae_eq hw0
  have : (ae (μI T)).NeBot := ae_neBot.2 (by simp [μI, hT])
  obtain ⟨t, ht, htI⟩ := (hae.and (ae_restrict_mem measurableSet_Ioc)).exists
  simp only [Pi.zero_apply] at ht
  rw [hAη, pairing_smul_left, hzero t (Ioc_subset_Icc_self htI), mul_zero, zero_add] at ht
  exact ht

/-! ### Step 3: exponential identities produce obstructions -/

/-- The shift identity in `L²` (`lem:finite-horizon-output`):
`(u(r + ·), y(r + ·)) = 𝓜_T (u(r + ·), x(r; x, u))` for `(u, y) = 𝓜_{T₁} (u, x)`. -/
theorem ioWin_ioParam {T₁ T r : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T) (hT : 0 < T) (hr : 0 ≤ r)
    (hrT : r + T ≤ T₁) (a : L2 U T₁) (x : X) :
    ioWin T₁ T r (sys.ioParam T₁ (WithLp.toLp 2 (a, x))) =
      sys.ioParam T (WithLp.toLp 2 (windowL T₁ T r a, sys.mild x ⇑a r)) := by
  have ha := Lp.memLp a
  have hy : ⇑(sys.𝓕 T₁ a + sys.𝓞 T₁ x) =ᵐ[μI T₁] sys.output T₁ x ⇑a := by
    filter_upwards [output_ae_eq hH1 hT ha x] with t ht
    rw [ht, Lp.toLp_coeFn a ha, add_comm (sys.𝓞 T₁ x)]
  rw [windowL_apply hr hrT a, ← window_output_eq hH1 hH2 hT ha hr hrT]
  refine WithLp.ofLp_injective 2 (Prod.ext ?_ ?_)
  · exact windowL_apply hr hrT a
  · change windowL T₁ T r (sys.𝓕 T₁ a + sys.𝓞 T₁ x) = window T (sys.output T₁ x ⇑a) r
    rw [windowL_apply hr hrT, window_congr_ae hy hr hrT]

/-- **The shift eigenrelation** `eq:io-window-shift-eigenrelation`
(`app:io-window-controllability`, Step 3): if `eq:io-window-fh` holds for every
`s ∈ (0, 2T + T')` on a record that is window informative at horizon `3T`, then every
`(a, x) ∈ L²(0, 3T; U) × X` satisfies
`ℓ_{v,g}(𝓜_T (a(r + ·), x(r; x, a))) = e^{λ r} ℓ_{v,g}(𝓜_T (a|_{(0,T)}, x))`, `r ∈ [0, 2T]`. -/
theorem io_eigenrelation {T T' : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T) (hT : 0 < T) {x₀ : X}
    {u : ℝ → U} (hu : MemLp u 2 (μI (3 * T + T')))
    (hw : WindowInformative (3 * T) T' u (sys.mild x₀ u)) {μ κ : ℂ}
    {v : L2 (Complexification U) T} {g : L2 (Complexification Y) T}
    (h : ∀ s ∈ Ioo 0 (2 * T + T'),
      ioWindowPairing T v g u (sys.output (3 * T + T') x₀ u) s = κ * Complex.exp (μ * s))
    {r : ℝ} (hr : r ∈ Icc 0 (2 * T)) (a : L2 U (3 * T)) (x : X) :
    cpairL (ioRe v g) (ioIm v g)
        (sys.ioParam T (WithLp.toLp 2 (windowL (3 * T) T r a, sys.mild x ⇑a r))) =
      Complex.exp (μ * r) * cpairL (ioRe v g) (ioIm v g)
        (sys.ioParam T (WithLp.toLp 2 (windowL (3 * T) T 0 a, x))) := by
  have h3 : (0 : ℝ) < 3 * T := by linarith
  have hH1' := hH1.of_pos sys hT (3 * T)
  have hH2' := hH2.of_pos sys hT (3 * T)
  set y := sys.output (3 * T + T') x₀ u with hy_def
  have hy : MemLp y 2 (μI (3 * T + T')) := memLp_output hH1 hT hu x₀
  set ℓ := cpairL (ioRe v g) (ioIm v g) with hℓ
  set Λ : WithLp 2 (L2 U (3 * T) × L2 Y (3 * T)) →L[ℝ] ℂ :=
    ℓ ∘L ioWin (3 * T) T r - Complex.exp (μ * r) • (ℓ ∘L ioWin (3 * T) T 0) with hΛ_def
  have hq : sys.ioParam (3 * T) (WithLp.toLp 2 (a, x)) ∈
      closure (range (ioWindowSynth (3 * T) T' u y)) := by
    rw [closure_range_ioWindowSynth hH1' hH2' h3 hu hw, ← range_ioParam]
    exact subset_closure (mem_range_self _)
  have hΛ : ∀ᵐ s ∂(μI T'), Λ (WithLp.toLp 2 (window (3 * T) u s, window (3 * T) y s)) = 0 := by
    have hIoo : ∀ᵐ s ∂(μI T'), s ∈ Ioo 0 T' := by
      rw [μI, ← Measure.restrict_congr_set Ioo_ae_eq_Ioc]
      exact ae_restrict_mem measurableSet_Ioo
    filter_upwards [hIoo] with s hs
    simp only [hΛ_def, sub_apply, smul_apply,
      ContinuousLinearMap.comp_apply, smul_eq_mul]
    rw [ioWin_window hu hy hs.1.le (by linarith [hs.2]) hr.1 (by linarith [hr.2]),
      ioWin_window hu hy hs.1.le (by linarith [hs.2]) le_rfl (by linarith), add_zero,
      hℓ, ← ioWindowPairing_eq_window (s := s + r) v g hu hy (by linarith [hs.1, hr.1])
        (by linarith [hs.2, hr.2]),
      ← ioWindowPairing_eq_window (s := s) v g hu hy hs.1.le (by linarith [hs.2]),
      h _ ⟨by linarith [hs.1, hr.1], by linarith [hs.2, hr.2]⟩,
      h _ ⟨hs.1, by linarith [hs.2]⟩]
    push_cast
    rw [mul_add, Complex.exp_add]
    ring
  have := clm_eq_zero_of_mem_closure hu hy Λ hΛ hq
  simp only [hΛ_def, sub_apply, smul_apply,
    ContinuousLinearMap.comp_apply, smul_eq_mul] at this
  rw [ioWin_ioParam hH1 hH2 hT hr.1 (by linarith [hr.2]),
    ioWin_ioParam hH1 hH2 hT le_rfl (by linarith), mild_zero_time] at this
  exact sub_eq_zero.1 this
/-- `app:io-window-controllability`, Step 3: if `eq:io-window-fh` holds with `κ ≠ 0` for every
`s ∈ (0, 2T + T')` on a record that is window informative at horizon `3T`, then
`η = 𝓞_T^⋆ g` is a nonzero eigenvector of `A^⋆` in `ker B^⋆`, and `η = 0` when `g = 0`. -/
theorem exists_isHautusEigenvector_of_io_exp {T T' : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T)
    (hT : 0 < T) (hT' : 0 < T') {x₀ : X} {u : ℝ → U} (hu : MemLp u 2 (μI (3 * T + T')))
    (hw : WindowInformative (3 * T) T' u (sys.mild x₀ u)) {μ κ : ℂ}
    {v : L2 (Complexification U) T} {g : L2 (Complexification Y) T} (hκ : κ ≠ 0)
    (h : ∀ s ∈ Ioo 0 (2 * T + T'),
      ioWindowPairing T v g u (sys.output (3 * T + T') x₀ u) s = κ * Complex.exp (μ * s)) :
    ∃ η : Complexification X, (g = 0 → η = 0) ∧ η ≠ 0 ∧ sys.IsHautusEigenvector μ η := by
  set P := ioRe v g with hP
  set Q := ioIm v g with hQ
  set M := ContinuousLinearMap.adjoint (sys.ioParam T) with hM
  set η : Complexification X := ⟨(M P).snd, (M Q).snd⟩ with hη
  -- `eq:io-window-pullback`: `ℓ_{v,g}(𝓜_T (b, z)) = ⟨α, b⟩ + ⟨η, z⟩`
  have hpull : ∀ (b : L2 U T) (z : X), cpairL P Q (sys.ioParam T (WithLp.toLp 2 (b, z))) =
      ⟨⟪(M P).fst, b⟫_ℝ, ⟪(M Q).fst, b⟫_ℝ⟩ + ⟪η, (z : Complexification X)⟫_bil := by
    intro b z
    rw [cpairL_apply, ← ContinuousLinearMap.adjoint_inner_left,
      ← ContinuousLinearMap.adjoint_inner_left, pairing_ofReal_right]
    apply Complex.ext <;> simp [WithLp.prod_inner_apply, η, M]
  have ER := fun (r : ℝ) (hr : r ∈ Icc 0 (2 * T)) (a : L2 U (3 * T)) (x : X) =>
    io_eigenrelation hH1 hH2 hT hu hw h hr a x
  -- inputs supported in `(T, 2T)`: `α = 0`
  have hα : ∀ b : L2 U T, ⟪(M P).fst, b⟫_ℝ = 0 ∧ ⟪(M Q).fst, b⟫_ℝ = 0 := by
    intro b
    set a := extendL (3 * T) T T b with ha_def
    have h1 : windowL (3 * T) T T a = b := windowL_extendL hT.le (by linarith) b
    have h2 : windowL (3 * T) T 0 a = 0 := by
      change windowL (3 * T) T 0 (windowL T (3 * T) (-T) b) = 0
      rw [windowL_windowL le_rfl (by linarith)]
      exact windowL_eq_zero (fun t ht h' => by linarith [h'.1, ht.2]) b
    have ha0 : ⇑a =ᵐ[μI T] (0 : ℝ → U) := by
      filter_upwards [ae_restrict_of_ae_restrict_of_subset
          (Ioc_subset_Ioc_right (by linarith : T ≤ 3 * T))
          (coeFn_extendL (T₁ := 3 * T) (T := T) (r := T) b),
        ae_restrict_mem measurableSet_Ioc] with t h1 h2
      rw [h1, indicator_of_notMem (fun h' => by linarith [h'.1, h2.2])]
      rfl
    have h3 : sys.mild 0 ⇑a T = 0 := by
      rw [mild_zero_left, L_congr_ae ha0, L_zero_right, map_zero]
    have := ER T ⟨hT.le, by linarith⟩ a 0
    rw [h1, h2, h3, hpull, hpull] at this
    simp only [inner_zero_right, ofReal_zero, pairing_zero_right, add_zero] at this
    rw [show (⟨0, 0⟩ : ℂ) = 0 from rfl, mul_zero, Complex.ext_iff] at this
    exact this
  have hαP : (M P).fst = 0 := inner_self_eq_zero.1 (hα _).1
  have hαQ : (M Q).fst = 0 := inner_self_eq_zero.1 (hα _).2
  have hpull' : ∀ (b : L2 U T) (z : X),
      cpairL P Q (sys.ioParam T (WithLp.toLp 2 (b, z))) = ⟪η, (z : Complexification X)⟫_bil := by
    intro b z
    rw [hpull, hαP, hαQ]
    simp only [inner_zero_left]
    rw [show (⟨0, 0⟩ : ℂ) = 0 from rfl, zero_add]
  -- zero input: `S(τ)^⋆ η = e^{λ τ} η`
  have hS : ∀ τ ∈ Icc 0 T, ∀ x : X, ⟪η, (sys.SX.real τ x : Complexification X)⟫_bil =
      Complex.exp (μ * τ) * ⟪η, (x : Complexification X)⟫_bil := by
    intro τ hτ x
    have := ER τ ⟨hτ.1, by linarith [hτ.2]⟩ 0 x
    rw [hpull', hpull'] at this
    rw [← this, mild, L_congr_ae (ae_restrict_of_ae_restrict_of_subset
      (Ioc_subset_Ioc_right (by linarith [hτ.2] : τ ≤ 3 * T)) (Lp.coeFn_zero U 2 (μI (3 * T)))),
      L_zero_right, map_zero, add_zero]
  -- zero initial state: `L_T^⋆ η = 0`
  have hL : ∀ b : L2 U T, ⟪η, (sys.ιW (sys.L T b) : Complexification X)⟫_bil = 0 := by
    intro b
    set a := extendL (3 * T) T 0 b
    have hab : ⇑a =ᵐ[μI T] ⇑b := by
      filter_upwards [ae_restrict_of_ae_restrict_of_subset
          (Ioc_subset_Ioc_right (by linarith : T ≤ 3 * T))
          (coeFn_extendL (T₁ := 3 * T) (T := T) (r := 0) b),
        ae_restrict_mem measurableSet_Ioc] with t h1 h2
      rw [h1, sub_zero, indicator_of_mem h2]
    have := ER T ⟨hT.le, by linarith⟩ a 0
    rw [hpull', hpull', mild_zero_left, L_congr_ae hab] at this
    rw [this, ofReal_zero, pairing_zero_right, mul_zero]
  refine ⟨η, fun hg => ?_, fun hne => ?_, isHautusEigenvector_of_shift hH1 hT hS hL⟩
  · -- `g = 0` forces `η = 𝓞_T^⋆ g = 0`
    have hg1 : P.snd = 0 := by simp [hP, ioRe, hg]
    have hg2 : Q.snd = 0 := by simp [hQ, ioIm, hg]
    have key : ∀ (R : WithLp 2 (L2 U T × L2 Y T)), R.snd = 0 → (M R).snd = 0 := by
      intro R hR
      refine (inner_self_eq_zero (𝕜 := ℝ)).1 ?_
      have : ⟪(M R).snd, (M R).snd⟫_ℝ = ⟪M R, WithLp.toLp 2 (0, (M R).snd)⟫_ℝ := by
        simp [WithLp.prod_inner_apply]
      rw [this, hM, ContinuousLinearMap.adjoint_inner_left]
      simp [WithLp.prod_inner_apply, hR]
    ext
    · exact key P hg1
    · exact key Q hg2
  · -- `η ≠ 0`, otherwise `ℓ_{v,g}` vanishes on every window of the record
    have hT3 : T + T ≤ 3 * T + T' := by linarith
    have := h T ⟨hT, by linarith⟩
    rw [ioWindowPairing_eq_window v g hu (memLp_output hH1 hT hu x₀) hT.le hT3,
      window_output_eq hH1 hH2 hT hu hT.le hT3, hpull', hne, pairing_zero_left] at this
    exact mul_ne_zero hκ (Complex.exp_ne_zero _) this.symm

/-! ### `thm:io-window-controllability` -/

/-- **Input–output certificate** (`thm:io-window-controllability` (i)).  Under the
Fattorini–Hautus property, `hyp:H1`, `hyp:H2` and exact observability of `(A, C)` in time `T`,
let `T' > 0` and let `(ū, x̄, ȳ)` be the record on `[0, T + T']` generated by
`(x₀, ū) ∈ X × L²(0, T + T'; U)`, with `(ū, x̄)` informative on `(0, T + T')`.  If no
`λ ∈ ℂ`, `κ ∈ ℂ \ {0}`, `v ∈ L²(0, T; U_ℂ)` and `g ∈ L²(0, T; Y_ℂ) \ {0}` satisfy
`eq:io-window-fh` for every `s ∈ (0, T')`, then `(A, B)` is approximately controllable. -/
theorem approxControllable_of_forall_not_io_exp {T T' : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T)
    (hT : 0 < T) (hFH : sys.FattoriniHautusProperty T) (hobs : sys.ExactlyObservable T)
    (hT' : 0 < T') {x₀ : X} {u : ℝ → U} (hu : MemLp u 2 (μI (T + T')))
    (hinf : Informative (T + T') u (sys.mild x₀ u))
    (h : ∀ (μ κ : ℂ) (v : L2 (Complexification U) T) (g : L2 (Complexification Y) T),
      κ ≠ 0 → g ≠ 0 →
        ¬ ∀ s ∈ Ioo 0 T', ioWindowPairing T v g u (sys.output (T + T') x₀ u) s =
          κ * Complex.exp (μ * s)) :
    sys.ApproxControllable T := by
  -- Steps 1–2 and the Fattorini–Hautus property
  refine hFH.2 fun μ η hη => ?_
  by_contra hne
  obtain ⟨κ, v, g, hκ, hg, hid⟩ := exists_io_exp_of_isHautusEigenvector hH1 hH2 hT
    (by linarith : T ≤ T + T') hobs hu hinf hη hne
  exact h μ κ v g hκ hg fun s hs => hid s hs.1.le (by linarith [hs.2])

/-- **Input–output characterisation** (`thm:io-window-controllability` (ii)).  Under the
Fattorini–Hautus property, `hyp:H1`, `hyp:H2` and exact observability of `(A, C)` in time `T`,
let `T' > 0` and let `(ū, x̄, ȳ)` be the record on `[0, 3T + T']` generated by `(x₀, ū)`, with
`(ū, x̄)` window informative at horizon `3T`.  Then `(A, B)` is approximately controllable iff
no `λ ∈ ℂ`, `κ ∈ ℂ \ {0}`, `v ∈ L²(0, T; U_ℂ)` and `g ∈ L²(0, T; Y_ℂ)` satisfy
`eq:io-window-fh` for every `s ∈ (0, 2T + T')`. -/
theorem approxControllable_iff_forall_not_io_exp {T T' : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T)
    (hT : 0 < T) (hFH : sys.FattoriniHautusProperty T) (hobs : sys.ExactlyObservable T)
    (hT' : 0 < T') {x₀ : X} {u : ℝ → U} (hu : MemLp u 2 (μI (3 * T + T')))
    (hw : WindowInformative (3 * T) T' u (sys.mild x₀ u)) :
    sys.ApproxControllable T ↔
      ∀ (μ κ : ℂ) (v : L2 (Complexification U) T) (g : L2 (Complexification Y) T), κ ≠ 0 →
        ¬ ∀ s ∈ Ioo 0 (2 * T + T'),
          ioWindowPairing T v g u (sys.output (3 * T + T') x₀ u) s = κ * Complex.exp (μ * s) := by
  constructor
  · -- "only if": Step 3 and the easy direction of `prop:fattorini-hautus`
    intro hc μ κ v g hκ hid
    obtain ⟨η, -, hne, hη⟩ := exists_isHautusEigenvector_of_io_exp hH1 hH2 hT hT' hu hw hκ hid
    exact hne (hautusCondition_of_approxControllable hH1 hT hc μ η hη)
  · -- "if": Steps 1–2 (informativity on `(0, 3T + T')` from `lem:window-implies-informative`)
    intro h
    have hinf : Informative (3 * T + T') u (sys.mild x₀ u) :=
      informative_of_windowInformative (hH1.of_pos sys hT (3 * T)) (by linarith) hu hw
    refine hFH.2 fun μ η hη => ?_
    by_contra hne
    obtain ⟨κ, v, g, hκ, -, hid⟩ := exists_io_exp_of_isHautusEigenvector hH1 hH2 hT
      (by linarith : T ≤ 3 * T + T') hobs hu hinf hη hne
    exact h μ κ v g hκ fun s hs => hid s hs.1.le (by linarith [hs.2])

/-- `thm:io-window-controllability` (ii), last sentence (`app:io-window-controllability`,
Step 3): under `hyp:H1` and `hyp:H2`, for the record on `[0, 3T + T']` generated by `(x₀, ū)`
with `(ū, x̄)` window informative at horizon `3T`, every quadruple `(λ, κ, v, g)` with `κ ≠ 0`
satisfying `eq:io-window-fh` for every `s ∈ (0, 2T + T')` has `g ≠ 0`.  Strengthening: the
Fattorini–Hautus property and exact observability are not assumed. -/
theorem ne_zero_of_io_exp {T T' : ℝ} (hH1 : sys.H1 T) (hH2 : sys.H2 T) (hT : 0 < T)
    (hT' : 0 < T') {x₀ : X} {u : ℝ → U} (hu : MemLp u 2 (μI (3 * T + T')))
    (hw : WindowInformative (3 * T) T' u (sys.mild x₀ u)) {μ κ : ℂ}
    {v : L2 (Complexification U) T} {g : L2 (Complexification Y) T} (hκ : κ ≠ 0)
    (h : ∀ s ∈ Ioo 0 (2 * T + T'),
      ioWindowPairing T v g u (sys.output (3 * T + T') x₀ u) s = κ * Complex.exp (μ * s)) :
    g ≠ 0 := by
  intro hg
  obtain ⟨η, h0, hne, -⟩ := exists_isHautusEigenvector_of_io_exp hH1 hH2 hT hT' hu hw hκ h
  exact hne (h0 hg)

end System

end DataDrivenControl
